/></mxCell><mxCell id="pain_x1" value="&lt;b style=&quot;font-size:34px&quot;&gt;Skipped checks&lt;/b&gt;&lt;br&gt;Call-backs slip under deadline." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontColor=#232F3E;spacing=0;" vertex="1" parent="pain"><mxGeometry x="128" y="224" width="512" height="112" as="geometry" /></mxCell><mxCell id="pain_c2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13212;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" vertex="1" parent="pain"><mxGeometry x="32" y="344" width="80" height="80" as="geometry" /></mxCell><mxCell id="pain_x2" value="&lt;b style=&quot;font-size:34px&quot;&gt;Re-keying&lt;/b&gt;&lt;br&gt;Errors and no single audit trail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontColor=#232F3E;spacing=0;" vertex="1" parent="pain"><mxGeometry x="128" y="352" width="512" height="112" as="geometry" /></mxCell><mxCell id="pain_c3" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13212;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" vertex="1" parent="pain"><mxGeometry x="32" y="472" width="80" height="80" as="geometry" /></mxCell><mxCell id="pain_x3" value="&lt;b style=&quot;font-size:34px&quot;&gt;Blind approval&lt;/b&gt;&lt;br&gt;Checker sees the amount, not the payee source." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=32;fontColor=#232F3E;spacing=0;" vertex="1" parent="pain"><mxGeometry x="128" y="480" width="512" height="112" as="geometry" /></mxCell><mxCell id="pain_c4" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D13212;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" vertex="1" parent="pain"><mxGeometry x="32" y="600" width="80" height="80" as="geometry" /></mxCell><mxCell id="pain_x4" value="&lt;b style=&quot;font-size:34px&quot;&gt;Batch rails&lt;/b&gt;&lt;br&gt;Cut-offs. No after-hours payouts." style="text;html=1;w