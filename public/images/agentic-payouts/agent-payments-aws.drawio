;" parent="1" vertex="1"><mxGeometry x="3515" y="2403" width="150" height="34" as="geometry" /></mxCell><mxCell id="leg-c" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3683" y="2400" width="40" height="40" as="geometry" /></mxCell><mxCell id="leg-tc" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="3731" y="2400" width="60" height="40" as="geometry" /></mxCell><mxCell id="narr" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="4880" y="200" width="520" height="2130" as="geometry" /></mxCell><mxCell id="narr-t" value="&lt;b&gt;Payment flow, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4900" y="214" width="480" height="36" as="geometry" /></mxCell><mxCell id="narr-i" value="Four accounts: agent runtime, payment core, checker, log archive." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4900" y="256" width="480" height="50" as="geometry" /></mxCell><mxCell id="narr-c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="316" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Key registration&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;HSM key&lt;/span&gt;&lt;br&gt;The platform signs with an HSM key held in the card network directories. A signing proxy adds RFC 9421 signatures to calls out to portals and card networks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="316" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="470" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Agent and gateway&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Agent gateway&lt;/span&gt;&lt;br&gt;Invoices, email and portals are untrusted input. No release tools. The gateway calls the core with its own role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="470" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="624" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Signed request&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Payment API&lt;/span&gt;&lt;br&gt;The API admits the gateway role only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="624" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="778" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Mandate check&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Rule service&lt;/span&gt;&lt;br&gt;Checks the platform signature (Ed25519, RFC 9421) and the passkey mandate against the WebAuthn key stored at enrolment. Nonce by one-time write." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="778" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="933" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Payee guard&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Rule service&lt;/span&gt;&lt;br&gt;A rule, not a model. Payee registry, US account check, sanctions screen on the SDN list feed with hits to a person, and invoice match against duplicates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="933" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1087" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Rail and policy&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Policy engine&lt;/span&gt;&lt;br&gt;The rail picker writes the rail into the release record. Cedar applies the matrix: payee status by amount by rail. A risk model can only add a hold." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1087" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1241" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Release&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Workflow engine&lt;/span&gt;&lt;br&gt;Checks the revocation list. The payment ID is the run name, with a one-time write. Status is checked before any retry. Writes a signed release." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1241" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1395" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x8" value="&lt;b style=&quot;font-size:16px&quot;&gt;Person releases&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Identity service&lt;/span&gt;&lt;br&gt;The checker app sits in its own account with passkey step-up and takes a release role in the payment core. An org policy stops the agent and the workflow approving themselves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1395" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1549" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x9" value="&lt;b style=&quot;font-size:16px&quot;&gt;Bank rail&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;OpenAPI service&lt;/span&gt;&lt;br&gt;The adapter checks the signed release before it sends. An explicit deny on the adapter and the bank secret blocks all but the release role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1549" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c9b" value="9b" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="1703" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x9b" value="&lt;b style=&quot;font-size:16px&quot;&gt;Stablecoin lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Cedar rules&lt;/span&gt;&lt;br&gt;A gate with four checks. The sanctions screen also checks wallets. Off until 18 Jan 2027." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1703" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="1858" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x10" value="&lt;b style=&quot;font-size:16px&quot;&gt;Card lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Card data zone&lt;/span&gt;&lt;br&gt;Secondary. Network tokens only. Card keys stay outside the agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1858" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="2012" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x11" value="&lt;b style=&quot;font-size:16px&quot;&gt;Returns and evidence&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Event bus, ledger&lt;/span&gt;&lt;br&gt;Webhooks and statements go to the adapter, the event bus, the ledger and the ERP. R-code returns open an exception for a person. Evidence is write-once." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="2012" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="2166" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x12" value="&lt;b style=&quot;font-size:16px&quot;&gt;Kill switch&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Feature flags&lt;/span&gt;&lt;br&gt;One agent off, all agent payments off, or the key revoked. Takes effect within a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="2166" width="424" height="146" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>