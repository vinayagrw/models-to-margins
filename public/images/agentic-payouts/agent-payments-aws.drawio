e="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="1800" y="3200" width="140.8" height="64" as="geometry" /></mxCell><mxCell id="leg-l4" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=22.4;fontSize=34;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#B0084D;strokeWidth=4.8;dashed=1;dashPattern=4.8 6.4;fontColor=#8A063C;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1979.2" y="3232" as="sourcePoint" /><mxPoint x="2155.2" y="3232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t4" value="&lt;b&gt;Untrusted input&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2171.2" y="3200" width="238.4" height="64" as="geometry" /></mxCell><mxCell id="leg-l5" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=22.4;fontSize=34;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#5A6C86;strokeWidth=3.2;fontColor=#3B4859;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2448" y="3232" as="sourcePoint" /><mxPoint x="2624" y="3232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t5" value="&lt;b&gt;Data and events&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2640" y="3200" width="238.4" height="64" as="geometry" /></mxCell><mxCell id="leg-l6" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=22.4;fontSize=34;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#3B4859;strokeWidth=4.8;dashed=1;dashPattern=19.2 9.6;fontColor=#3B4859;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2916.8" y="3232" as="sourcePoint" /><mxPoint x="3092.8" y="3232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t6" value="&lt;b&gt;Returns and status&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="3108.8" y="3200" width="278.4" height="64" as="geometry" /></mxCell><mxCell id="leg-l7" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=22.4;fontSize=34;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#147EBA;strokeWidth=3.2;dashed=1;dashPattern=3.2 6.4;fontColor=#0B4F7A;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3425.6" y="3232" as="sourcePoint" /><mxPoint x="3601.6" y="3232" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t7" value="&lt;b&gt;Control&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="3617.6" y="3200" width="128" height="64" as="geometry" /></mxCell><mxCell id="leg-p0" value="SOX control" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=32;fontStyle=1;strokeWidth=1.6;fillColor=#FFF2CC;strokeColor=#B7950B;fontColor=#5C4300;" parent="1" vertex="1"><mxGeometry x="3784" y="3209.6" width="255.2" height="48" as="geometry" /></mxCell><mxCell id="leg-p1" value="Release role only" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=32;fontStyle=1;strokeWidth=1.6;fillColor=#FDEDEC;strokeColor=#D13212;fontColor=#7B1A0B;strokeWidth=3.2;" parent="1" vertex="1"><mxGeometry x="4063.2" y="3209.6" width="370.4" height="48" as="geometry" /></mxCell><mxCell id="leg-token" value="Signed release" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#FF9900;strokeColor=#232F3E;strokeWidth=3.2;fontColor=#232F3E;fontStyle=1;fontSize=32;" parent="1" vertex="1"><mxGeometry x="4457.6" y="3204.8" width="312.8" height="54.4" as="geometry" /></mxCell><mxCell id="leg-c" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="4794.4" y="3192" width="80" height="80" as="geometry" /></mxCell><mxCell id="leg-tc" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4890.4" y="3200" width="96" height="64" as="geometry" /></mxCell><mxCell id="narr" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=3.2;" parent="1" vertex="1"><mxGeometry x="5440" y="320" width="800" height="2512" as="geometry" /></mxCell><mxCell id="narr-t" value="&lt;b&gt;Year 1, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=48;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="5472" y="342.4" width="736" height="57.6" as="geometry" /></mxCell><mxCell id="narr-c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="401.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x1" value="&lt;b style=&quot;font-size:40px&quot;&gt;Agent proposes&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Agent host&lt;/span&gt;&lt;br&gt;Drafts from an approved invoice in the ERP and AP feed. It holds no release tool." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="409.6" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="668.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x2" value="&lt;b style=&quot;font-size:40px&quot;&gt;Mandate check&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda&lt;/span&gt;&lt;br&gt;Checks the agent signature (Web Bot Auth, RFC 9421) and the passkey mandate. The adapter never checks itself." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="676.8" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="936" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x3" value="&lt;b style=&quot;font-size:40px&quot;&gt;Payee guard&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, DynamoDB&lt;/span&gt;&lt;br&gt;Every new or changed payee. US account check, sanctions screen with hits to a person, invoice match against duplicates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="944" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="1203.2" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x4" value="&lt;b style=&quot;font-size:40px&quot;&gt;Rail picker&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda&lt;/span&gt;&lt;br&gt;Picks ACH, RTP or wire and writes the rail into the release record." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="1211.2" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="1470.4" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x5" value="&lt;b style=&quot;font-size:40px&quot;&gt;Release matrix&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Verified Permissions&lt;/span&gt;&lt;br&gt;Payee status by amount by rail. Rule releases, or a person releases in the checker app with passkey step-up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="1478.4" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="1739.2" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x6" value="&lt;b style=&quot;font-size:40px&quot;&gt;Checker app&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Cognito, IAM&lt;/span&gt;&lt;br&gt;A person releases what the matrix holds, with passkey step-up. The app assumes a release role in the adapter account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="1747.2" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="2006.4" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x7" value="&lt;b style=&quot;font-size:40px&quot;&gt;Bank connector&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, KMS, Step Functions&lt;/span&gt;&lt;br&gt;Release writes a signed assertion with a one-time payment ID. The connector checks it before it sends. Only the release role can use the bank secret." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="2014.4" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="2273.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x8" value="&lt;b style=&quot;font-size:40px&quot;&gt;Evidence ledger&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;EventBridge, S3&lt;/span&gt;&lt;br&gt;The bank API returns status and R-codes to the connector, then the event bus, the evidence ledger and the ERP. Returns open an exception for a person." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="2281.6" width="646.4" height="254.4" as="geometry" /></mxCell><mxCell id="narr-c9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="5472" y="2540.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x9" value="&lt;b style=&quot;font-size:40px&quot;&gt;Kill switch&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;AppConfig&lt;/span&gt;&lt;br&gt;One agent off, or all agent payments off. Takes effect within a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="5561.6" y="2548.8" width="646.4" height="254.4" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="target" name="Target AWS"><mxGraphModel dx="2560" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="8736" pageHeight="4064" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" value="Diagram" parent="0" /><mxCell id="banner" value="&lt;b style=&quot;font-size:72px&quot;&gt;AI payment agent: target state on AWS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:44px;color:#D5DBDB&quot;&gt;The agent proposes. A signed request passes the mandate check, the payee guard and the rail picker. A release matrix decides: rule releases or person releases. Only a signed release can send.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#232F3E;gradientColor=#37475A;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=44.8;fontSize=72;" parent="1" vertex="1"><mxGeometry x="64" y="48" width="8576" height="176" as="geometry" /></mxCell><mxCell id="outside" value="Outside AWS" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=44;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=#FAFAFA;verticalAlign=top;align=left;spacingLeft=36;fontColor=#5A6C86;dashed=0;strokeWidth=3.2;" parent="1" vertex="1"><mxGeometry x="64" y="320" width="416" height="3088" as="geometry" /></mxCell><mxCell id="org" value="AWS Organizations" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=44;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=36;fo