 behaviour&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#01A88D;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;" parent="1" vertex="1"><mxGeometry x="3290" y="2235" width="1470" height="80" as="geometry" /></mxCell><mxCell id="leg" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FAFAFA;strokeColor=#D5DBDB;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="40" y="2370" width="4760" height="100" as="geometry" /></mxCell><mxCell id="leg-title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="64" y="2400" width="90" height="40" as="geometry" /></mxCell><mxCell id="leg-l0" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#E8732A;strokeWidth=5;fontColor=#A14A0E;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="2420" as="sourcePoint" /><mxPoint x="280" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t0" value="&lt;b&gt;Payment path&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="290" y="2400" width="123" height="40" as="geometry" /></mxCell><mxCell id="leg-l1" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#B07000;strokeWidth=4;dashed=1;dashPattern=10 6;fontColor=#7A4E00;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="437" y="2420" as="sourcePoint" /><mxPoint x="547" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t1" value="&lt;b&gt;Person releases&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="557" y="2400" width="149" height="40" as="geometry" /></mxCell><mxCell id="leg-l2" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;dashPattern=8 5;fontColor=#A3172C;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="2420" as="sourcePoint" /><mxPoint x="840" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t2" value="&lt;b&gt;Identity&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="850" y="2400" width="88" height="40" as="geometry" /></mxCell><mxCell id="leg-l3" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#B0084D;strokeWidth=3;dashed=1;dashPattern=3 4;fontColor=#8A063C;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="962" y="2420" as="sourcePoint" /><mxPoint x="1072" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t3" value="&lt;b&gt;Untrusted input&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="1082" y="2400" width="149" height="40" as="geometry" /></mxCell><mxCell id="leg-l4" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#00897B;strokeWidth=3;fontColor=#00695C;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1255" y="2420" as="sourcePoint" /><mxPoint x="1365" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t4" value="&lt;b&gt;Card lane&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="1375" y="2400" width="97" height="40" as="geometry" /></mxCell><mxCell id="leg-l5" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#8C4FFF;strokeWidth=3;dashed=1;dashPattern=10 6;fontColor=#5A2DB3;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1496" y="2420" as="sourcePoint" /><mxPoint x="1606" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t5" value="&lt;b&gt;Stablecoin, gated&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="1616" y="2400" width="166" height="40" as="geometry" /></mxCell><mxCell id="leg-l6" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#5A6C86;strokeWidth=2;fontColor=#3B4859;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1806" y="2420" as="sourcePoint" /><mxPoint x="1916" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t6" value="&lt;b&gt;Data and events&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="1926" y="2400" width="149" height="40" as="geometry" /></mxCell><mxCell id="leg-l7" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#3B4859;strokeWidth=3;dashed=1;dashPattern=12 6;fontColor=#3B4859;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2099" y="2420" as="sourcePoint" /><mxPoint x="2209" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t7" value="&lt;b&gt;Returns and status&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2219" y="2400" width="174" height="40" as="geometry" /></mxCell><mxCell id="leg-l8" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#147EBA;strokeWidth=2;dashed=1;dashPattern=2 4;fontColor=#0B4F7A;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2417" y="2420" as="sourcePoint" /><mxPoint x="2527" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t8" value="&lt;b&gt;Control plane&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2537" y="2400" width="131" height="40" as="geometry" /></mxCell><mxCell id="leg-l9" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;dashed=1;dashPattern=12 6;strokeColor=#D13212;strokeWidth=4;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2692" y="2420" as="sourcePoint" /><mxPoint x="2802" y="2420" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t9" value="&lt;b&gt;Hard-rule fence&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2812" y="2400" width="149" height="40" as="geometry" /></mxCell><mxCell id="leg-p0" value="SOX control" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#FFF2CC;strokeColor=#B7950B;fontColor=#5C4300;" parent="1" vertex="1"><mxGeometry x="2985" y="2406" width="124" height="28" as="geometry" /></mxCell><mxCell id="leg-p1" value="Portable" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#D1F2EB;strokeColor=#148F77;fontColor=#0B5345;" parent="1" vertex="1"><mxGeometry x="3127" y="2406" width="98" height="28" as="geometry" /></mxCell><mxCell id="leg-p2" value="AWS-bound" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#EAEDED;strokeColor=#7B8794;fontColor=#2E3A45;" parent="1" vertex="1"><mxGeometry x="3243" y="2406" width="107" height="28" as="geometry" /></mxCell><mxCell id="leg-p3" value="SCP" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="3368" y="2406" width="60" height="28" as="geometry" /></mxCell><mxCell id="leg-p4" value="Release role only" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#FDEDEC;strokeColor=#D13212;fontColor=#7B1A0B;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="3446" y="2406" width="176" height="28" as="geometry" /></mxCell><mxCell id="leg-token" value="Signed release" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#FF9900;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="3640" y="2403" width="150" height="34" as="geometry" /></mxCell><mxCell id="leg-c" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3808" y="2400" width="40" height="40" as="geometry" /></mxCell><mxCell id="leg-tc" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="3856" y="2400" width="60" height="40" as="geometry" /></mxCell><mxCell id="narr" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="4880" y="200" width="520" height="2130" as="geometry" /></mxCell><mxCell id="narr-t" value="&lt;b&gt;Payment flow, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4900" y="214" width="480" height="36" as="geometry" /></mxCell><mxCell id="narr-i" value="Four accounts: agent runtime, payment core, checker, log archive." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4900" y="256" width="480" height="50" as="geometry" /></mxCell><mxCell id="narr-c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="316" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Key registration&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;KMS, Lambda&lt;/span&gt;&lt;br&gt;The platform signs with a KMS key in the card network directories. A signing proxy adds RFC 9421 signatures to calls out to portals and card networks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="316" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="470" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Agent and gateway&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;AgentCore Gateway&lt;/span&gt;&lt;br&gt;Invoices, email and portals are untrusted input. No release tools. The gateway calls the core through an OpenAPI target with its own IAM role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="470" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="624" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Signed request&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;API Gateway&lt;/span&gt;&lt;br&gt;Regional API with IAM auth. A resource policy admits the gateway role only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="624" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="778" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Mandate check&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, DynamoDB&lt;/span&gt;&lt;br&gt;Checks the platform signature (KMS public key, Ed25519, RFC 9421) and the passkey mandate against the WebAuthn key stored at enrolment. Nonce by conditional write." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="778" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="933" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Payee guard&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, DynamoDB&lt;/span&gt;&lt;br&gt;A rule, not a model. Payee registry, US account check, sanctions screen on the SDN list feed with hits to a person, and invoice match against duplicates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="933" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1087" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Rail and policy&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, Verified Permissions&lt;/span&gt;&lt;br&gt;The rail picker writes the rail into the release record. Cedar applies the matrix: payee status by amount by rail. ML can only add a hold." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1087" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1241" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Release&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Step Functions, DynamoDB&lt;/span&gt;&lt;br&gt;Checks the revocation list. The payment ID is the execution name, with a one-time write. Status is checked before any retry. Writes a signed release." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1241" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1395" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x8" value="&lt;b style=&quot;font-size:16px&quot;&gt;Person releases&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Cognito, IAM&lt;/span&gt;&lt;br&gt;The checker app sits in its own account with passkey step-up and assumes a release role in the payment core account. An SCP denies SendTaskSuccess to the agent and orchestrator roles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1395" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="4900" y="1549" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x9" value="&lt;b style=&quot;font-size:16px&quot;&gt;Bank rail&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, Network Firewall&lt;/span&gt;&lt;br&gt;The adapter checks the signed release with KMS Verify before it sends. An explicit deny on the adapter and the bank secret blocks all but the release role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1549" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c9b" value="9b" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="1703" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x9b" value="&lt;b style=&quot;font-size:16px&quot;&gt;Stablecoin lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Verified Permissions&lt;/span&gt;&lt;br&gt;A Cedar gate with four checks. The sanctions screen also checks wallets. Off until 18 Jan 2027." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1703" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="1858" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x10" value="&lt;b style=&quot;font-size:16px&quot;&gt;Card lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, Payment Cryptography&lt;/span&gt;&lt;br&gt;Secondary. Network tokens only. Card keys stay outside the agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="1858" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="2012" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x11" value="&lt;b style=&quot;font-size:16px&quot;&gt;Returns and evidence&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;EventBridge, DynamoDB, S3&lt;/span&gt;&lt;br&gt;Webhooks and statements go to the adapter, EventBridge, the ledger and the ERP. R-code returns open an exception for a person. Evidence in S3 Object Lock." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="2012" width="424" height="146" as="geometry" /></mxCell><mxCell id="narr-c12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" parent="1" vertex="1"><mxGeometry x="4900" y="2166" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x12" value="&lt;b style=&quot;font-size:16px&quot;&gt;Kill switch&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;AppConfig&lt;/span&gt;&lt;br&gt;One agent off, all agent payments off, or the key revoked. Takes effect within a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="4956" y="2166" width="424" height="146" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="target-generic" name="Target generic"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5460" pageHeight="2540" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" value="Diagram" parent="0" /><mxCell id="banner" value="&lt;b style=&quot;font-size:32px&quot;&gt;AI payment agent: target state, vendor neutral&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#D5DBDB&quot;&gt;Same steps as the AWS view. The agent proposes. A signed request passes the mandate check, the payee guard and the rail picker. Only a signed release can send.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#232F3E;gradientColor=#37475A;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=28;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="5360" height="110" as="geometry" /></mxCell><mxCell id="outside" value="Outside" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;strokeColor=#7D8998;strokeWidth=2;dashed=0;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=17;fontStyle=1;fontColor=#5A6C86;" parent="1" vertex="1"><mxGeometry x="40" y="200" width="260" height="1930" as="geometry" /></mxCell><mxCell id="org" value="Cloud organization" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;strokeColor=#232F3E;strokeWidth=2;dashed=0;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=17;fontStyle=1;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="340" y="200" width="4000" height="1930" as="geometry" /></mxCell><mxCell id="region" value="One region" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;strokeColor=#00A4A6;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=17;fontStyle=1;fontColor=#007A7C;" parent="org" vertex="1"><mxGeometry x="20" y="50" width="3960" height="1860" as="geometry" /></mxCell><mxCell id="acct-agent" value="Agent runtime account" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FDF8FB;strokeColor=#E7157B;strokeWidth=2;dashed=0;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=17;fontStyle=1;fontColor=#B0105F;" parent="region" vertex="1"><mxGeometry x="20" y="50" width="620" height="1790" as="geometry" /></mxCell><mxCell id="boundary" value="Untrusted input" style="rounded=1;arcSize=3;html=1;w