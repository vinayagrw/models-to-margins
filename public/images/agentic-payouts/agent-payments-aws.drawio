relative="1" as="geometry"><mxPoint x="3867.2" y="3872" as="sourcePoint" /><mxPoint x="4043.2" y="3872" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t8" value="&lt;b&gt;Control plane&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4059.2" y="3840" width="209.6" height="64" as="geometry" /></mxCell><mxCell id="leg-l9" value="" style="endArrow=none;html=1;rounded=0;edgeStyle=none;dashed=1;dashPattern=19.2 9.6;strokeColor=#D13212;strokeWidth=6.4;" parent="1" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4307.2" y="3872" as="sourcePoint" /><mxPoint x="4483.2" y="3872" as="targetPoint" /></mxGeometry></mxCell><mxCell id="leg-t9" value="&lt;b&gt;Hard-rule fence&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="4499.2" y="3840" width="238.4" height="64" as="geometry" /></mxCell><mxCell id="leg-p0" value="SOX control" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=32;fontStyle=1;strokeWidth=1.6;fillColor=#FFF2CC;strokeColor=#B7950B;fontColor=#5C4300;" parent="1" vertex="1"><mxGeometry x="4776" y="3849.6" width="255.2" height="48" as="geometry" /></mxCell><mxCell id="leg-p1" value="Portable" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=32;fontStyle=1;strokeWidth=1.6;fillColor=#D1F2EB;strokeColor=#148F77;fontColor=#0B5345;" parent="1" vertex="1"><mxGeometry x="5055.2" y="3849.6" width="197.6" height="48" as="geometry" /></mxCell><mxCell id="leg-p2" value="SCP" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=32;fontStyle=1;strokeWidth=1.6;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;" parent="1" vertex="1"><mxGeometry x="5276.8" y="3849.6" width="101.6" height="48" as="geometry" /></mxCell><mxCell id="leg-p3" value="Release role only" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=32;fontStyle=1;strokeWidth=1.6;fillColor=#FDEDEC;strokeColor=#D13212;fontColor=#7B1A0B;strokeWidth=3.2;" parent="1" vertex="1"><mxGeometry x="5402.4" y="3849.6" width="370.4" height="48" as="geometry" /></mxCell><mxCell id="leg-token" value="Signed release" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#FF9900;strokeColor=#232F3E;strokeWidth=3.2;fontColor=#232F3E;fontStyle=1;fontSize=32;" parent="1" vertex="1"><mxGeometry x="5796.8" y="3844.8" width="312.8" height="54.4" as="geometry" /></mxCell><mxCell id="leg-c" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="6133.6" y="3832" width="80" height="80" as="geometry" /></mxCell><mxCell id="leg-tc" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="6229.6" y="3840" width="96" height="64" as="geometry" /></mxCell><mxCell id="narr" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=3.2;" parent="1" vertex="1"><mxGeometry x="7808" y="320" width="832" height="3408" as="geometry" /></mxCell><mxCell id="narr-t" value="&lt;b&gt;Payment flow, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=48;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="7840" y="342.4" width="768" height="57.6" as="geometry" /></mxCell><mxCell id="narr-i" value="Four accounts: agent runtime, payment core, checker, log archive." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="7840" y="409.6" width="768" height="80" as="geometry" /></mxCell><mxCell id="narr-c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="497.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x1" value="&lt;b style=&quot;font-size:40px&quot;&gt;Key registration&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;HSM key&lt;/span&gt;&lt;br&gt;The platform signs with an HSM key held in the card network directories. A signing proxy adds RFC 9421 signatures to calls out to portals and card networks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="505.6" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="744" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x2" value="&lt;b style=&quot;font-size:40px&quot;&gt;Agent and gateway&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Agent gateway&lt;/span&gt;&lt;br&gt;Invoices, email and portals are untrusted input. No release tools. The gateway calls the core with its own role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="752" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="990.4" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x3" value="&lt;b style=&quot;font-size:40px&quot;&gt;Signed request&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Payment API&lt;/span&gt;&lt;br&gt;The API admits the gateway role only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="998.4" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1236.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x4" value="&lt;b style=&quot;font-size:40px&quot;&gt;Mandate check&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Rule service&lt;/span&gt;&lt;br&gt;Checks the platform signature (Ed25519, RFC 9421) and the passkey mandate against the WebAuthn key stored at enrolment. Nonce by one-time write." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1244.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1484.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x5" value="&lt;b style=&quot;font-size:40px&quot;&gt;Payee guard&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Rule service&lt;/span&gt;&lt;br&gt;A rule, not a model. Payee registry, US account check, sanctions screen on the SDN list feed with hits to a person, and invoice match against duplicates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1492.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1731.2" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x6" value="&lt;b style=&quot;font-size:40px&quot;&gt;Rail and policy&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Policy engine&lt;/span&gt;&lt;br&gt;The rail picker writes the rail into the release record. Cedar applies the matrix: payee status by amount by rail. A risk model can only add a hold." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1739.2" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1977.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x7" value="&lt;b style=&quot;font-size:40px&quot;&gt;Release&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Workflow engine&lt;/span&gt;&lt;br&gt;Checks the revocation list. The payment ID is the run name, with a one-time write. Status is checked before any retry. Writes a signed release." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1985.6" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="2224" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x8" value="&lt;b style=&quot;font-size:40px&quot;&gt;Person releases&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Identity service&lt;/span&gt;&lt;br&gt;The checker app sits in its own account with passkey step-up and takes a release role in the payment core. An org policy stops the agent and the workflow approving themselves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2232" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="2470.4" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x9" value="&lt;b style=&quot;font-size:40px&quot;&gt;Bank rail&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;OpenAPI service&lt;/span&gt;&lt;br&gt;The adapter checks the signed release before it sends. An explicit deny on the adapter and the bank secret blocks all but the release role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2478.4" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c9b" value="9b" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="2716.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x9b" value="&lt;b style=&quot;font-size:40px&quot;&gt;Stablecoin lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Cedar rules&lt;/span&gt;&lt;br&gt;A gate with four checks. The sanctions screen also checks wallets. Off until 18 Jan 2027." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2724.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="2964.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x10" value="&lt;b style=&quot;font-size:40px&quot;&gt;Card lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Card data zone&lt;/span&gt;&lt;br&gt;Secondary. Network tokens only. Card keys stay outside the agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2972.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="3211.2" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x11" value="&lt;b style=&quot;font-size:40px&quot;&gt;Returns and evidence&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Event bus, ledger&lt;/span&gt;&lt;br&gt;Webhooks and statements go to the adapter, the event bus, the ledger and the ERP. R-code returns open an exception for a person. Evidence is write-once." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="3219.2" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="3457.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x12" value="&lt;b style=&quot;font-size:40px&quot;&gt;Kill switch&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Feature flags&lt;/span&gt;&lt;br&gt;One agent off, all agent payments off, or the key revoked. Takes effect within a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="3465.6" width="678.4" height="233.6" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>