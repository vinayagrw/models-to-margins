 x="6374.4" y="3832" width="80" height="80" as="geometry" /></mxCell><mxCell id="leg-tc" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="6470.4" y="3840" width="96" height="64" as="geometry" /></mxCell><mxCell id="narr" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=3.2;" parent="1" vertex="1"><mxGeometry x="7808" y="320" width="832" height="3408" as="geometry" /></mxCell><mxCell id="narr-t" value="&lt;b&gt;Payment flow, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=48;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="7840" y="342.4" width="768" height="57.6" as="geometry" /></mxCell><mxCell id="narr-i" value="Four accounts: agent runtime, payment core, checker, log archive." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=34;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="7840" y="409.6" width="768" height="80" as="geometry" /></mxCell><mxCell id="narr-c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="497.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x1" value="&lt;b style=&quot;font-size:40px&quot;&gt;Key registration&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;KMS, Lambda&lt;/span&gt;&lt;br&gt;The platform signs with a KMS key in the card network directories. A signing proxy adds RFC 9421 signatures to calls out to portals and card networks." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="505.6" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="744" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x2" value="&lt;b style=&quot;font-size:40px&quot;&gt;Agent and gateway&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;AgentCore Gateway&lt;/span&gt;&lt;br&gt;Invoices, email and portals are untrusted input. No release tools. The gateway calls the core through an OpenAPI target with its own IAM role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="752" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="990.4" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x3" value="&lt;b style=&quot;font-size:40px&quot;&gt;Signed request&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;API Gateway&lt;/span&gt;&lt;br&gt;Regional API with IAM auth. A resource policy admits the gateway role only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="998.4" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1236.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x4" value="&lt;b style=&quot;font-size:40px&quot;&gt;Mandate check&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, DynamoDB&lt;/span&gt;&lt;br&gt;Checks the platform signature (KMS public key, Ed25519, RFC 9421) and the passkey mandate against the WebAuthn key stored at enrolment. Nonce by conditional write." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1244.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1484.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x5" value="&lt;b style=&quot;font-size:40px&quot;&gt;Payee guard&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, DynamoDB&lt;/span&gt;&lt;br&gt;A rule, not a model. Payee registry, US account check, sanctions screen on the SDN list feed with hits to a person, and invoice match against duplicates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1492.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1731.2" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x6" value="&lt;b style=&quot;font-size:40px&quot;&gt;Rail and policy&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, Verified Permissions&lt;/span&gt;&lt;br&gt;The rail picker writes the rail into the release record. Cedar applies the matrix: payee status by amount by rail. ML can only add a hold." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1739.2" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="1977.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x7" value="&lt;b style=&quot;font-size:40px&quot;&gt;Release&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Step Functions, DynamoDB&lt;/span&gt;&lt;br&gt;Checks the revocation list. The payment ID is the execution name, with a one-time write. Status is checked before any retry. Writes a signed release." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="1985.6" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="2224" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x8" value="&lt;b style=&quot;font-size:40px&quot;&gt;Person releases&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Cognito, IAM&lt;/span&gt;&lt;br&gt;The checker app sits in its own account with passkey step-up and assumes a release role in the payment core account. An SCP denies SendTaskSuccess to the agent and orchestrator roles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2232" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=44;" parent="1" vertex="1"><mxGeometry x="7840" y="2470.4" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x9" value="&lt;b style=&quot;font-size:40px&quot;&gt;Bank rail&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, Network Firewall&lt;/span&gt;&lt;br&gt;The adapter checks the signed release with KMS Verify before it sends. An explicit deny on the adapter and the bank secret blocks all but the release role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2478.4" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c9b" value="9b" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="2716.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x9b" value="&lt;b style=&quot;font-size:40px&quot;&gt;Stablecoin lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Verified Permissions&lt;/span&gt;&lt;br&gt;A Cedar gate with four checks. The sanctions screen also checks wallets. Off until 18 Jan 2027." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2724.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c10" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="2964.8" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x10" value="&lt;b style=&quot;font-size:40px&quot;&gt;Card lane&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;Lambda, Payment Cryptography&lt;/span&gt;&lt;br&gt;Secondary. Network tokens only. Card keys stay outside the agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="2972.8" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="3211.2" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x11" value="&lt;b style=&quot;font-size:40px&quot;&gt;Returns and evidence&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;EventBridge, DynamoDB, S3&lt;/span&gt;&lt;br&gt;Webhooks and statements go to the adapter, EventBridge, the ledger and the ERP. R-code returns open an exception for a person. Evidence in S3 Object Lock." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="3219.2" width="678.4" height="233.6" as="geometry" /></mxCell><mxCell id="narr-c12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=3.2;fontColor=#FFFFFF;fontStyle=1;fontSize=40;" parent="1" vertex="1"><mxGeometry x="7840" y="3457.6" width="80" height="80" as="geometry" /></mxCell><mxCell id="narr-x12" value="&lt;b style=&quot;font-size:40px&quot;&gt;Kill switch&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:32px&quot;&gt;AppConfig&lt;/span&gt;&lt;br&gt;One agent off, all agent payments off, or the key revoked. Takes effect within a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=34;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="7929.6" y="3465.6" width="678.4" height="233.6" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="target-generic" name="Target generic"><mxGraphModel dx="2560" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="8736" pageHeight="4064" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" value="Diagram" parent="0" /><mxCell id="banner" value="&lt;b style=&quot;font-size:72px&quot;&gt;AI payment agent: target state, vendor neutral&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:44px;color:#D5DBDB&quot;&gt;Same steps as the AWS view. The agent proposes. A signed request passes the mandate check, the payee guard and the rail picker. Only a signed release can send.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#232F3E;gradientColor=#37475A;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=44.8;fontSize=72;" parent="1" vertex="1"><mxGeometry x="64" y="48" width="8576" height="176" as="geometry" /></mxCell><mxCell id="outside" value="Outside" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;strokeColor=#7D8998;strokeWidth=3.2;dashed=0;dashPattern=12.8 8;verticalAlign=top;align=left;spacingLeft=22.4;spacingTop=6.4;fontSize=44;fontStyle=1;fontColor=#5A6C86;" parent="1" vertex="1"><mxGeometry x="64" y="320" width="416" height="3088" as="geometry" /></mxCell><mxCell id="org" value="Cloud organization" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;strokeColor=#232F3E;strokeWidth=3.2;dashed=0;dashPattern=12.8 8;verticalAlign=top;align=left;spacingLeft=22.4;spacingTop=6.4;fontSize=44;fontStyle=1;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="544" y="320" width="6464" height="3088" as="geometry" /></mxCell><mxCell id="region" value="One region" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=none;strokeColor=#00A4A6;strokeWidth=3.2;dashed=1;dashPattern=12.8 8;verticalAlign=top;align=left;spacingLeft=22.4;spacingTop=6.4;fontSize=44;fontStyle=1;fontColor=#007A7C;" parent="org" vertex="1"><mxGeometry x="32" y="80" width="6400" height="2976" as="geometry" /></mxCell><mxCell id="acct-agent" value="Agent runtime account" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FDF8FB;strokeColor=#E7157B;strokeWidth=3.2;dashed=0;dashPattern=12.8 8;verticalAlign=top;align=left;spacingLeft=22.4;spacingTop=6.4;fontSize=44;fontStyle=1;fontColor=#B0105F;" parent="region" vertex="1"><mxGeometry x="32" y="80" width="992" height="2864" as="geometry" /></mxCell><mxCell id="boundary" value="Untrusted input" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FDEDEC;strokeColor=#D13212;strokeWidth=4.8;dashed=1;dashPattern=16 9.6;verticalAlign=top;align=left;spacingLeft=19.2;spacingRight=19.2;spacingTop=6.4;spacingBottom=6.4;fontSize=44;fontStyle=1;fontColor=#9B2B12;" parent="acct-agent" vertex="1"><mxGeometry x="32" y="736" width="928" height="528" as="geometry" /></mxCell><mxCell id="acct-core" value="Payment core account" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FBFDFD;strokeColor=#E7157B;strokeWidth=3.2;dashed=0;dashPattern=12.8 8;verticalAlign=top;align=left;spacingLeft=22.4;spacingTop=6.4;fontSize=44;fontStyle=1;fontColor=#B0105F;" parent="region" vertex="1"><mxGeometry x="1088" y="80" width="5280" height="2336" as="geometry" /></mxCell><mxCell id="gzone" value="Payee checks" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFF8F0;strokeColor=#ED7100;strokeWidth=4.8;dashed=1;dashPattern=12.8 8;verticalAlign=top;align=left;spacingLeft=19.2;spacingRight=19.2;spacingTop=6.4;spacingBottom=6.4;fontSize=44;fontStyle=1;fontColor=#9A4A00;" parent="acct-core" vertex="1"><mxGeometry x="832" y="96" width="928" height="1728" as="geometry" /></mxCell><mxCell id="czone" value="Control plane" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#EAF3FB;strokeColor=#147EBA;strokeWidth=