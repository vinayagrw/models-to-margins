id="leg-t7" value="&lt;b&gt;Control&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2261" y="2000" width="80" height="40" as="geometry" /></mxCell><mxCell id="leg-p0" value="SOX control" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#FFF2CC;strokeColor=#B7950B;fontColor=#5C4300;" parent="1" vertex="1"><mxGeometry x="2365" y="2006" width="124" height="28" as="geometry" /></mxCell><mxCell id="leg-p1" value="Release role only" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;strokeWidth=1;fillColor=#FDEDEC;strokeColor=#D13212;fontColor=#7B1A0B;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="2507" y="2006" width="176" height="28" as="geometry" /></mxCell><mxCell id="leg-token" value="Signed release" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#FF9900;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontStyle=1;fontSize=15;" parent="1" vertex="1"><mxGeometry x="2701" y="2003" width="150" height="34" as="geometry" /></mxCell><mxCell id="leg-c" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="2869" y="2000" width="40" height="40" as="geometry" /></mxCell><mxCell id="leg-tc" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="2917" y="2000" width="60" height="40" as="geometry" /></mxCell><mxCell id="narr" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="3400" y="200" width="500" height="1570" as="geometry" /></mxCell><mxCell id="narr-t" value="&lt;b&gt;Year 1, step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontColor=#232F3E;" parent="1" vertex="1"><mxGeometry x="3420" y="214" width="460" height="36" as="geometry" /></mxCell><mxCell id="narr-c1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="256" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Agent proposes&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Agent host&lt;/span&gt;&lt;br&gt;Drafts from an approved invoice in the ERP and AP feed. It holds no release tool." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="256" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="423" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Mandate check&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda&lt;/span&gt;&lt;br&gt;Checks the agent signature (Web Bot Auth, RFC 9421) and the passkey mandate. The adapter never checks itself." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="423" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="590" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Payee guard&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, DynamoDB&lt;/span&gt;&lt;br&gt;Every new or changed payee. US account check, sanctions screen with hits to a person, invoice match against duplicates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="590" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="757" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Rail picker&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda&lt;/span&gt;&lt;br&gt;Picks ACH, RTP or wire and writes the rail into the release record." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="757" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="924" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Release matrix&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Verified Permissions&lt;/span&gt;&lt;br&gt;Payee status by amount by rail. Rule releases, or a person releases in the checker app with passkey step-up." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="924" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="1092" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Checker app&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Cognito, IAM&lt;/span&gt;&lt;br&gt;A person releases what the matrix holds, with passkey step-up. The app assumes a release role in the adapter account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="1092" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="1259" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Bank connector&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;Lambda, KMS, Step Functions&lt;/span&gt;&lt;br&gt;Release writes a signed assertion with a one-time payment ID. The connector checks it before it sends. Only the release role can use the bank secret." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="1259" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="1426" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x8" value="&lt;b style=&quot;font-size:16px&quot;&gt;Evidence ledger&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;EventBridge, S3&lt;/span&gt;&lt;br&gt;The bank API returns status and R-codes to the connector, then the event bus, the evidence ledger and the ERP. Returns open an exception for a person." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="1426" width="404" height="159" as="geometry" /></mxCell><mxCell id="narr-c9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" parent="1" vertex="1"><mxGeometry x="3420" y="1593" width="40" height="40" as="geometry" /></mxCell><mxCell id="narr-x9" value="&lt;b style=&quot;font-size:16px&quot;&gt;Kill switch&lt;/b&gt; &lt;span style=&quot;color:#5A6C86;font-size:14px&quot;&gt;AppConfig&lt;/span&gt;&lt;br&gt;One agent off, or all agent payments off. Takes effect within a minute." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#232F3E;spacing=0;" parent="1" vertex="1"><mxGeometry x="3476" y="1593" width="404" height="159" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="target" name="Target AWS"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5460" pageHeight="2540" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" value="Diagram" parent="0" /><mxCell id="banner" value="&lt;b style=&quot;font-size:32px&quot;&gt;AI payment agent: target state on AWS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px;color:#D5DBDB&quot;&gt;The agent proposes. A signed request passes the mandate check, the payee guard and the rail picker. A release matrix decides: rule releases or person releases. Only a signed release can send.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#232F3E;gradientColor=#37475A;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=28;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="5360" height="110" as="geometry" /></mxCell><mxCell id="outside" value="Outside AWS" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=17;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=#FAFAFA;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="40" y="200" width="260" height="1930" as="geometry" /></mxCell><mxCell id="org" value="AWS Organizations" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=17;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;strokeWidth=2;" parent="1" vertex="1"><mxGeometry x="340" y="200" width="4000" height="1930" as="geometry" /></mxCell><mxCell id="region" value="us-east-1" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=17;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#007A7C;dashed=1;strokeWidth=2;" parent="org" vertex="1"><mxGeometry x="20" y="50" width="3960" height="1860" as="geometry" /></mxCell><mxCell id="acct-agent" value="Agent runtime account" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=17;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#E7157B;fillColor=#FDF8FB;verticalAlign=top;align=left;spacingLeft=30;fontColor=#B0105F;dashed=0;strokeWidth=2;" parent="region" vertex="1"><mxGeometry x="20" y="50" width="620" height="1790" as="geometry" /></mxCell><mxCell id="boundary" value="Untrusted input" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FDEDEC;strokeColor=#D13212;strokeWidth=3;dashed=1;dashPattern=10 6;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;spacingBottom=4;fontSize=17;fontStyle=1;fontColor=#9B2B12;" parent="acct-agent" vertex="1"><mxGeometry x="20" y="460" width="580" height="330" as="geometry" /></mxCell><mxCell id="acct-core" value="Payment core account" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=17;fontStyle=1;container=1;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;strokeColor=#E7157B;fillColor=#FBFDFD;verticalAlign=top;align=left;spacingLeft=30;fontColor=#B0105F;dashed=0;strokeWidth=2;" parent="region" vertex="1"><mxGeometry x="680" y="50" width="3260" height="1460" as="geometry" /></mxCell><mxCell id="gzone" value="Payee checks" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFF8F0;strokeColor=#ED7100;strokeWidth=3;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;spacingBottom=4;fontSize=17;fontStyle=1;fontColor=#9A4A00;" parent="acct-core" vertex="1"><mxGeometry x="520" y="60" width="580" height="1080" as="geometry" /></mxCell><mxCell id="czone" value="Control plane" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#EAF3FB;strokeColor=#147EBA;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=bottom;align=right;spacingLeft=12;spacingRight=12;spacingTop=4;spacingBottom=4;fontSize=17;fontStyle=1;fontColor=#0B4F7A;" parent="acct-core" vertex="1"><mxGeometry x="1860" y="40" width="820" height="260" as="geometry" /></mxCell><mxCell id="vpc" value="Rail VPC" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=17;fontStyle=1;container=1;collapsible=