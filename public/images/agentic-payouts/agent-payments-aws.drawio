h="1040" height="290" as="geometry" /></mxCell><mxCell id="acct-checker" value="Checker account" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FBFDFD;strokeColor=#E7157B;strokeWidth=2;dashed=0;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=17;fontStyle=1;fontColor=#B0105F;" parent="region" vertex="1"><mxGeometry x="1800" y="1550" width="840" height="290" as="geometry" /></mxCell><mxCell id="dirzone" value="Agent directories" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFF5F6;strokeColor=#DD344C;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;spacingBottom=4;fontSize=17;fontStyle=1;fontColor=#A3172C;" parent="1" vertex="1"><mxGeometry x="4400" y="330" width="400" height="300" as="geometry" /></mxCell><mxCell id="railzone" value="Three ways to move money" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFF8F1;strokeColor=#E8732A;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;spacingBottom=4;fontSize=17;fontStyle=1;fontColor=#A14A0E;" parent="1" vertex="1"><mxGeometry x="4400" y="680" width="400" height="840" as="geometry" /></mxCell><mxCell id="stablezone" value="Lane 9b" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F6F1FF;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=4;spacingBottom=4;fontSize=17;fontStyle=1;fontColor=#5A2DB3;" parent="1" vertex="1"><mxGeometry x="4400" y="1560" width="400" height="330" as="geometry" /></mxCell><mxCell id="e-portal-agent" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=14;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;flowAnimation=1;strokeColor=#B00