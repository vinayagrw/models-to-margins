  }
  @media (prefers-reduced-motion: reduce) { .wbl * { transition: none !important; } }
  @media print { .wbl-view[hidden] { display: grid !important; } .wbl-rail, .wbl-film, .wbl-sws { display: none !important; } .wbl-wires g { display: none; } }
</style>

<script>
  const root = document.getElementById('wbl') as HTMLElement | null;
  if (root) {
    const D = JSON.parse((document.getElementById('wbl-data') as HTMLElement).textContent || '{}');
    const $ = (s: string, p: ParentNode = root) => p.querySelector(s) as HTMLElement;
    const $$ = (s: string, p: ParentNode = root) => Array.from(p.querySelectorAll(s)) as HTMLElement[];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ev = (e?: string) => e ? `<i class="wb-ev ${e}">${e === 'verified' ? 'verified 2026' : e}</i>` : '';
    const hashGet = () => new URLSearchParams(location.hash.slice(1));
    const hashSet = (o: Record<string, string | null>) => { const h = hashGet(); for (const [k, v] of Object.entries(o)) { if (v === null) h.delete(k); else h.set(k, v); } try { history.replaceState(null, '', h.toString() ? '#' + h.toString() : location.pathname + location.search); } catch {} };
    const nodes = D.view?.nodes || []; const nodeById = (id: string) => nodes.find((n: any) => n.id === id);
    const probs: any[] = D.probs;

    // ---- the catch rule. A bad request is caught at the first station on its path whose block
    // is in the problem's block list and switched on. Blocks with no station never ride the belt.
    const PATH = ['ask', 'gate', 'budget', 'screen_in', 'read', 'route', 'model', 'check', 'screen_out', 'human', 'log'];
    const STATIONS = ['ask', 'gate', 'budget', 'read', 'toolgw', 'route', 'check', 'human', 'log'];
    const onPathBlocks = new Set(STATIONS.map((s) => nodeById(s)?.block).filter(Boolean));
    const off = new Set<string>();
    const catchOf = (p: any) => {
      const mine = (p.b || []).filter((b: string) => onPathBlocks.has(b));
      if (!mine.length) return { kind: 'terms' };
      for (const s of STATIONS) { const b = nodeById(s)?.block; if (b && mine.includes(b) && !off.has(b)) return { kind: 'caught', station: s }; }
      return { kind: 'leak' };
    };
    const riders = probs.filter((p) => catchOf(p).kind !== 'terms');
    $$('.wbl-chip').forEach((c) => { const p = probs.find((x) => x.id === c.dataset.prob); if (p && catchOf(p).kind === 'terms') c.classList.add('terms'); });

    // ---- map wires and the moving requests
    const map = $('#wbl-map'); const svg = $('.wbl-wires', map) as unknown as SVGSVGElement;
    const reqPath = $('#wbl-req', map) as unknown as SVGPathElement; const loopPath = $('#wbl-loop', map) as unknown as SVGPathElement; const dotsG = $('#wbl-dots', map);
    const center = (id: string) => { const b = $(`[data-node="${id}"]`, map); if (!b) return null; const m = map.getBoundingClientRect(), r = b.getBoundingClientRect(); return { x: r.left - m.left + r.width / 2, y: r.top - m.top + 7 }; };
    let stopAt: Record<string, number> = {};
    function layout() {
      const m = map.getBoundingClientRect(); svg.setAttribute('viewBox', `0 0 ${m.width} ${m.height}`);
      const pts = PATH.map(center).filter(Boolean) as { x: number; y: number }[];
      reqPath.setAttribute('d', pts.map((p, i) => (i ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1)).join(' '));
      const L = reqPath.getTotalLength(); let acc = 0; stopAt = {};
      pts.forEach((p, i) => { if (i) acc += Math.hypot(p.x - pts[i - 1].x, p.y - pts[i - 1].y); stopAt[PATH[i]] = acc; });
      stopAt.toolgw = stopAt.read; stopAt.__end = L;
      const lp = ['log', 'testset', 'testgate', 'settings', 'check'].map(center).filter(Boolean) as { x: number; y: number }[];
      loopPath.setAttribute('d', lp.map((p, i) => (i ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1)).join(' '));
    }

    const counts = { sent: 0, pass: 0, caught: 0, leak: 0 };
    const showCounts = () => { $('#wbl-sent').textContent = String(counts.sent); $('#wbl-pass').textContent = String(counts.pass); $('#wbl-caught').textContent = String(counts.caught); $('#wbl-leak').textContent = String(counts.leak); };
    type Dot = { el: SVGCircleElement; t0: number; dur: number; path: SVGPathElement; end: number; done: () => void };
    let dots: Dot[] = []; let k = 0; let lastSpawn = 0; let running = false;
    const mkDot = (cls: string) => { const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); c.setAttribute('r', '7'); c.setAttribute('class', cls); dotsG.appendChild(c); return c; };
    const flash = (sel: string, cls: string, ms = 900) => { const e = $(sel); if (!e) return; e.classList.add(cls); setTimeout(() => e.classList.remove(cls), ms); };
    function spawn(now: number) {
      const bad = k % 4 === 3; const p = bad ? riders[(k >> 2) % riders.length] : null; k++; counts.sent++;
      const c = p ? catchOf(p) : null; const L = stopAt.__end || reqPath.getTotalLength();
      const end = c?.kind === 'caught' ? stopAt[c.station!] : L;
      const el = mkDot(p ? (c!.kind === 'leak' ? 'leak' : p.pre) : 'ok');
      dots.push({ el, t0: now, dur: 5200 * end / L, path: reqPath, end, done: () => {
        if (!p) { counts.pass++; }
        else if (c!.kind === 'caught') { counts.caught++; flash(`[data-node="${c!.station}"]`, 'hit'); flash(`.wbl-chip[data-prob="${p.id}"]`, 'flash'); const back = mkDot('back'); const LL = loopPath.getTotalLength(); dots.push({ el: back, t0: performance.now(), dur: 4200, path: loopPath, end: LL, done: () => flash('[data-node="check"]', 'lit') }); }
        else { counts.leak++; flash(`.wbl-chip[data-prob="${p.id}"]`, 'leak', 1600); }
        showCounts();
      } });
    }
    function frame(now: number) {
      if (!running) return; requestAnimationFrame(frame);
      if (now - lastSpawn > 2500) { lastSpawn = now; spawn(now); }
      dots = dots.filter((d) => { const t = Math.min(1, (now - d.t0) / d.dur); const pt = d.path.getPointAtLength(t * d.end); d.el.setAttribute('cx', pt.x.toFixed(1)); d.el.setAttribute('cy', pt.y.toFixed(1)); if (t >= 1) { d.done(); d.el.remove(); return false; } return true; });
    }
    const vis = { inView: true, sys: true };
    const setRunning = () => { const on = !reduce && vis.inView && vis.sys; if (on && !running) { running = true; lastSpawn = performance.now() - 2400; requestAnimationFrame(frame); } else if (!on) running = false; };
    new IntersectionObserver((es) => { vis.inView = es.some((e) => e.isIntersecting); setRunning(); }).observe(map);
    // Reduced motion: no moving dots. The counters show one full cycle of the fixed schedule.
    const staticCycle = () => { counts.sent = riders.length * 4; counts.pass = riders.length * 3; counts.caught = riders.filter((p) => catchOf(p).kind === 'caught').length; counts.leak = riders.length - counts.caught; showCounts(); };
    if (reduce) staticCycle();
    const leakMarks = () => $$('.wbl-chip').forEach((c) => { const p = probs.find((x) => x.id === c.dataset.prob); c.classList.toggle('leak', !!p && catchOf(p).kind === 'leak'); });

    // ---- what if: switch blocks off
    $$('.wbl-sw').forEach((b) => b.addEventListener('click', () => {
      const id = b.dataset.sw!; if (off.has(id)) off.delete(id); else off.add(id);
      b.setAttribute('aria-pressed', String(!off.has(id)));
      $$('.wbl-node').forEach((n) => n.classList.toggle('off', !!n.dataset.block && off.has(n.dataset.block)));
      leakMarks(); if (reduce) staticCycle(); refreshCard();
    }));

    // ---- interim and target, a timed morph block by block in build order
    const buildIdx = (b: string) => { const li = D.layers.findIndex((l: any) => l.blocks.includes(b)); return li < 0 ? 9 : D.buildOrder.indexOf(D.layers[li].name); };
    let morphT: number[] = [];
    function setArch(v: string, animate = true) {
      const interim = v === 'interim'; root!.dataset.arch = interim ? 'interim' : 'target'; hashSet({ arch: interim ? 'interim' : null });
      $$('.wbl-switch button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.arch === (interim ? 'interim' : 'target'))));
      morphT.forEach(clearTimeout); morphT = [];
      const ns = $$('.wbl-node').sort((a, b) => buildIdx(a.dataset.block || '') - buildIdx(b.dataset.block || ''));
      ns.forEach((n, i) => { const go = () => n.classList.toggle('im', interim); if (!animate || reduce) go(); else morphT.push(window.setTimeout(go, 120 * i)); });
    }
    $('.wbl-switch').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button[data-arch]') as HTMLElement; if (b) setArch(b.dataset.arch!); });

    // ---- cards
    const card = $('#wbl-card'); let cardFor: { kind: string; id: string } | null = null; let lastFocus: HTMLElement | null = null;
    const stName = (s: string) => nodeById(s)?.name || s;
    function blockBody(id: string) {
      const b = D.blocks[id]; const cr = D.costRows.find((x: any) => x.id === id);
      const q = (b.quick || []).slice(0, 2).map((x: any) => `<li><b>${x.fix}</b> ${ev(x.ev)}</li>`).join('');
      const pct = (v: number) => (Math.sqrt(v / Math.max(...D.costRows.map((x: any) => x.r[1]))) * 100).toFixed(1);
      return `<p>${b.includes}</p><dl><div><dt>Owner</dt><dd>${b.owner}</dd></div><div><dt>Cost to run, a month</dt><dd>${cr ? `<div class="wbl-cbar"><i style="left:${pct(cr.r[0])}%;width:${Math.max(1.2, +pct(cr.r[1]) - +pct(cr.r[0]))}%"></i></div>${cr.cost.replace(' a month', '')} ` : 'Priced at the first funding gate '}${ev(b.costev)}</dd></div></dl>`
        + `<h4>Stops ${id === 'P10' ? 'all 24' : b.fixes.length + ' of 24'}</h4><div class="wbl-cchips">${(id === 'P10' ? [] : b.fixes).map((f: string) => `<button type="button" class="wbl-chip ${f[0]}" data-prob="${f}">${f}</button>`).join('')}</div>`
        + (q ? `<h4>Quick fix this week</h4><ul>${q}</ul>` : '') + (b.options?.length ? `<p class="wbl-k">${b.options.length} named options in the design document</p>` : '');
    }
    function probBody(id: string) {
      const p = probs.find((x) => x.id === id); const c = catchOf(p); const lab = D.labels[p.st];
      const where = c.kind === 'caught' ? `<p class="wbl-catch">Caught at <b>${stName(c.station!)}</b>, block ${nodeById(c.station!)?.block}</p>` : c.kind === 'leak' ? `<p class="wbl-catch leak">Nothing stops it. Its blocks are switched off.</p>` : `<p class="wbl-catch">Fixed by terms and budget, not on the request path</p>`;
      let ext = '';
      if (D.extra?.timeline) { const t = D.extra.timeline.filter((x: any) => x.ev === 'verified' && (x.ids || []).includes(id)).slice(0, 3); if (t.length) ext += `<h4>Last 30 days</h4><ul>${t.map((x: any) => `<li><b>${x.date}</b> ${x.text}</li>`).join('')}</ul>`; }
      return where + `<dl><div><dt>The number</dt><dd>${p.num} ${p.numl} ${ev(p.nev)}</dd></div><div><dt>${lab.name}</dt><dd>${lab.s}</dd></div><div><dt>Owner</dt><dd>${p.own}. Maturity ${p.mat}.</dd></div></dl>`
        + (p.quick ? `<h4>Quick fix this week</h4><ul><li><b>${p.quick.fix}</b> ${ev(p.quick.ev)}</li></ul>` : '') + `<h4>Fix properly</h4><p>${p.fix}</p><p><b>First step.</b> ${p.first}</p>` + ext;
    }
    function openCard(kind: 'block' | 'problem', id: string, focusEl?: HTMLElement) {
      cardFor = { kind, id }; lastFocus = focusEl || null; root!.dataset.card = 'on'; card.hidden = false;
      $$('.wbl-node').forEach((n) => { n.classList.remove('sel', 'dim'); });
      if (kind === 'block') {
        const b = D.blocks[id]; if (!b) return; $('#wbl-card-k').textContent = `${id} · ${D.layers[D.layers.findIndex((l: any) => l.blocks.includes(id))].name}`; $('#wbl-card-h').textContent = b.name; $('#wbl-card-b').innerHTML = blockBody(id);
        $$('.wbl-node').forEach((n) => n.classList.toggle(n.dataset.block === id ? 'sel' : 'dim', true));
      } else {
        const p = probs.find((x) => x.id === id); if (!p) return; $('#wbl-card-k').textContent = `${id} · ${p.pre === 'S' ? 'Web search' : 'Wider AI use'}`; $('#wbl-card-h').textContent = p.name; $('#wbl-card-b').innerHTML = probBody(id);
        const c = catchOf(p); $$('.wbl-node').forEach((n) => { const on = c.kind === 'caught' ? n.dataset.node === c.station : (p.b || []).includes(n.dataset.block); n.classList.toggle(on ? 'sel' : 'dim', true); });
      }
      $$('.wbl-chip').forEach((c) => c.classList.toggle('flash', kind === 'problem' && c.dataset.prob === id && !!c.closest('.wbl-chips')));
      requestAnimationFrame(layout);
    }
    const refreshCard = () => { if (cardFor) { $('#wbl-card-b').innerHTML = cardFor.kind === 'block' ? blockBody(cardFor.id) : probBody(cardFor.id); } };
    function closeCard() { cardFor = null; card.hidden = true; root!.dataset.card = 'off'; $$('.wbl-node').forEach((n) => n.classList.remove('sel', 'dim')); $$('.wbl-chips .wbl-chip').forEach((c) => c.classList.remove('flash')); requestAnimationFrame(layout); }

    // ---- run level: the playhead sweeps the five stages
    const laneBtns = $$('.wbl-lrow button'); const laneHeads = $$('.wbl-lhead b'); let sweep = 0; let sweepT = 0;
    laneBtns.forEach((b) => b.dataset.stage = D.lanes.cols[+b.dataset.col!] + '. ');
    const setStage = (ci: number) => { sweep = ci; laneBtns.forEach((b) => b.classList.toggle('on', reduce || +b.dataset.col! === ci)); laneHeads.forEach((h) => h.classList.toggle('on', reduce || +h.dataset.col! === ci)); };
    const runSweep = (on: boolean) => { clearInterval(sweepT); if (reduce) { setStage(0); return; } if (on) { setStage(sweep); sweepT = window.setInterval(() => setStage((sweep + 1) % 5), 1600); } };
    const cellCard = $('#wbl-cellcard');
    function openCell(id: string) {
      const [r, c] = id.split('-').map(Number); const cell = D.lanes.cells.find((x: any) => x.r === r && x.c === c); if (!cell) return;
      $('#wbl-cell-k').textContent = `${D.lanes.rows[r]} · ${D.lanes.cols[c]} · ${cell.cad}`; $('#wbl-cell-h').textContent = cell.task;
      $('#wbl-cell-b').innerHTML = `<p>${cell.detail}</p><dl><div><dt>Standard</dt><dd>${cell.std || 'None named'}</dd></div><div><dt>Evidence</dt><dd>${ev(cell.ev || 'design')}</dd></div></dl>`;
      cellCard.hidden = false; hashSet({ cell: id });
    }

    // ---- zoom levels
    let zoom = 'system'; let lastBlock = 'P4'; let lastProb = 'S1';
    function setZoom(z: string, id?: string, focusEl?: HTMLElement) {
      zoom = z; root!.dataset.zoom = z;
      const v = z === 'block' || z === 'problem' ? 'system' : z;
      $$('.wbl-view').forEach((s) => { s.hidden = s.dataset.v !== v; });
      $$('.wbl-rail button[data-zoomto]').forEach((b) => b.setAttribute('aria-current', String(b.dataset.zoomto === z)));
      vis.sys = v === 'system'; setRunning(); runSweep(v === 'run');
      if (z === 'block') { lastBlock = id || lastBlock; openCard('block', lastBlock, focusEl); }
      else if (z === 'problem') { lastProb = id || lastProb; openCard('problem', lastProb, focusEl); }
      else if (v === 'system') closeCard();
      if (v !== 'run') { cellCard.hidden = true; }
      hashSet({ zoom: z === 'system' ? null : z, id: z === 'block' ? lastBlock : z === 'problem' ? lastProb : null, cell: null });
      if (v === 'system') requestAnimationFrame(layout);
    }
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const zb = t.closest('[data-zoomto]') as HTMLElement | null; if (zb) { stopFilm(); setZoom(zb.dataset.zoomto!); return; }
      const pb = t.closest('[data-prob]') as HTMLElement | null; if (pb) { if (zoom !== 'system' && zoom !== 'block' && zoom !== 'problem') stopFilm(); setZoom('problem', pb.dataset.prob!, pb); return; }
      const nb = t.closest('.wbl-node') as HTMLElement | null; if (nb) { if (nb.dataset.block) setZoom('block', nb.dataset.block, nb); return; }
      const bb = t.closest('.wbl-bars [data-block]') as HTMLElement | null; if (bb) { setZoom('block', bb.dataset.block!, bb); return; }
      const cb = t.closest('[data-cell]') as HTMLElement | null; if (cb) { openCell(cb.dataset.cell!); return; }
      if (t.closest('[data-close]')) { if (t.closest('#wbl-cellcard')) { cellCard.hidden = true; hashSet({ cell: null }); } else setZoom('system'); lastFocus?.focus({ preventScroll: true }); }
    });
    // Ctrl plus wheel (and trackpad pinch) moves one level. A plain wheel always scrolls the page.
    const LADDER = ['board', 'system', 'block', 'problem'];
    root.addEventListener('wheel', (e) => { if (!e.ctrlKey) return; e.preventDefault(); const i = Math.max(0, LADDER.indexOf(zoom)); const j = Math.min(LADDER.length - 1, Math.max(0, i + (e.deltaY < 0 ? 1 : -1))); if (j !== i) setZoom(LADDER[j]); }, { passive: false });

    // ---- the film: eight beats over the live picture, one caption each
    const BEATS = [
      { z: 'board', cap: 'Three numbers frame the whole problem.' },
      { z: 'system', f: 'chips', cap: 'Twenty four failures. Each one has a station that stops it.' },
      { z: 'system', f: 'first4', cap: 'Four blocks do most of the work.' },
      { z: 'system', f: 'control', cap: 'Settings live above. Every request runs below.' },
      { z: 'problem', id: 'S1', cap: 'One bad answer, caught and turned into a test.' },
      { z: 'system', f: 'badges', cap: 'Built in four layers, contracts first.' },
      { z: 'run', cap: 'Six teams, five stages, one loop.' },
      { z: 'board', f: 'charts', cap: 'What it costs, and how much is proven.' }
    ];
    const BEAT_MS = 11000; let beat = 0; let filmT = 0; let filmStart = 0; let paused = false; let progT = 0;
    const film = $('#wbl-film');
    function showBeat(n: number) {
      beat = n; const b = BEATS[n - 1]; root!.dataset.focus = b.f === 'control' ? 'control' : ''; root!.dataset.badges = b.f === 'badges' ? 'on' : 'off';
      setZoom(b.z, b.id); hashSet({ beat: String(n) });
      if (b.f === 'first4') $$('.wbl-node').forEach((x) => x.classList.toggle('dim', !D.first4.includes(x.dataset.block)));
      if (b.f === 'chips') $$('.wbl-chips .wbl-chip').forEach((c, i) => { if (!reduce) setTimeout(() => { c.classList.add('flash'); setTimeout(() => c.classList.remove('flash'), 1400); }, i * 120); });
      if (b.f === 'badges') $$('.wbl-node').forEach((x) => { const bi = buildIdx(x.dataset.block || ''); const bd = x.querySelector('.wbl-badge'); if (bd) bd.textContent = bi < 9 ? String(bi + 1) : ''; });
      $('#wbl-cap').textContent = b.cap; film.hidden = false;
      $$('.wbl-marks button').forEach((m) => m.setAttribute('aria-current', String(+m.dataset.beat! === n)));
      filmStart = performance.now();
    }
    function tick() { if (paused || !beat) return; const t = (performance.now() - filmStart) / BEAT_MS; ($('#wbl-prog') as HTMLElement).style.width = (((beat - 1) + Math.min(1, t)) / 8 * 100).toFixed(1) + '%'; if (t >= 1) { if (beat < 8) showBeat(beat + 1); else { pause(true); return; } } progT = requestAnimationFrame(tick); }
    function play(from = 1) { paused = false; showBeat(from); ($('[data-film="toggle"]') as HTMLElement).textContent = 'Pause'; cancelAnimationFrame(progT); progT = requestAnimationFrame(tick); film.scrollIntoView({ block: 'nearest', behavior: 'instant' as ScrollBehavior }); }
    function pause(p: boolean) { paused = p; ($('[data-film="toggle"]') as HTMLElement).textContent = p ? 'Play' : 'Pause'; if (!p) { filmStart = performance.now(); progT = requestAnimationFrame(tick); } }
    function stopFilm() { if (!beat) return; beat = 0; paused = true; cancelAnimationFrame(progT); film.hidden = true; root!.dataset.focus = ''; root!.dataset.badges = 'off'; $$('.wbl-node').forEach((x) => x.classList.remove('dim')); hashSet({ beat: null }); }
    $$('[data-film="play"]').forEach((b) => b.addEventListener('click', () => play(1)));
    ($('[data-film="toggle"]') as HTMLElement).addEventListener('click', () => pause(!paused));
    ($('[data-film="stop"]') as HTMLElement).addEventListener('click', stopFilm);
    $$('.wbl-marks button').forEach((m) => m.addEventListener('click', () => { const n = +m.dataset.beat!; if (paused) { showBeat(n); } else play(n); }));
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName; if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (e.key === 'Escape') { if (beat) stopFilm(); else if (!card.hidden) setZoom('system'); else if (!cellCard.hidden) cellCard.hidden = true; }
      if (!beat) return;
      if (e.key === ' ' && tag !== 'BUTTON') { e.preventDefault(); pause(!paused); }
      if (e.key === 'ArrowRight' && beat < 8) { showBeat(beat + 1); } if (e.key === 'ArrowLeft' && beat > 1) { showBeat(beat - 1); }
    });

    // ---- start from the hash. A beat in the hash opens the film paused on that beat.
    layout(); addEventListener('resize', () => requestAnimationFrame(layout)); (document as any).fonts?.ready?.then(layout);
    const h = hashGet();
    if (h.get('arch') === 'interim') setArch('interim', false);
    if (h.get('beat')) { paused = true; showBeat(Math.min(8, Math.max(1, +h.get('beat')!))); ($('[data-film="toggle"]') as HTMLElement).textContent = 'Play'; }
    else setZoom(h.get('zoom') || 'system', h.get('id') || undefined);
    if (h.get('cell')) openCell(h.get('cell')!);
    leakMarks();
  }
