---
/* Sample C, the living system. One picture of the AI system that runs the whole time: requests
   move through the stations, bad ones are caught where a building block stops them, and caught
   ones ride the offline loop back into the tests. Five zoom levels (board, system, block, problem,
   run), a what-if switch per block, an Interim and Target switch, and a 90 second film that plays
   the story over the live picture. All text is DOM. Data is shaped once in what-breaks/model.ts. */
import { sprite, view, LAYERS, BLOCKS, LAYER_TONE, layerOf, icon, evTag, quickBy, PROB, LABELS, proofCount, LANES, cellOf, costRows, bar, INCIDENTS, BOARD, UNKNOWN, HERO, clientData } from './what-breaks/model';
import './what-breaks/iso-tones.css';

const N = Object.fromEntries((view?.nodes ?? []).map((n: any) => [n.id, n]));
const NODE_IC: Record<string, string> = { screen_in: 'i-scrub', model: 'i-model', screen_out: 'i-explain', settings: 'i-rule-brick', providers: 'i-model', idp: 'i-vault', web: 'i-network', traces: 'i-lake' };
const BANDS = [
  { id: 'control', name: 'Control plane', note: 'settings, tested before release', ids: ['change', 'testset', 'testgate', 'settings', 'canary'] },
  { id: 'data', name: 'Data plane', note: 'every request, in this order', ids: ['ask', 'gate', 'budget', 'screen_in', 'read', 'route', 'model', 'check', 'screen_out', 'human', 'log'] },
  { id: 'fence', name: 'Agent fence', note: 'when the answer needs an action', ids: ['agentid', 'reader', 'act', 'toolgw', 'approval', 'sandbox', 'offswitch'] },
  { id: 'out', name: 'Outside your boundary', note: '', ids: ['providers', 'idp', 'web', 'traces'] }
];
const toneOf = (n: any) => n?.block ? LAYER_TONE[layerOf(n.block)] : (n?.external ? 'iso-slate' : 'iso-violet');
const nodeBtn = (id: string) => { const n = N[id]; if (!n) return ''; const ic = n.block ? BLOCKS[n.block].ic : (NODE_IC[id] || 'i-cloud'); const qn = n.block ? (quickBy[n.block] ?? []).length : 0; const noq = !n.external && n.block && qn === 0; return `<button type="button" class="wbl-node${n.external ? ' ext' : ''}${noq ? ' noq' : ''}" data-node="${id}" data-block="${n.block ?? ''}">${icon(ic, toneOf(n), 44)}<b>${n.name}</b><span class="wbl-tagl">${n.block ?? (n.external ? 'outside' : 'part')}</span><span class="wbl-q">${n.external ? 'as today' : qn ? qn + ' fix' + (qn > 1 ? 'es' : '') + ' now' : (n.block ? 'none yet' : 'as today')}</span><i class="wbl-badge" aria-hidden="true"></i></button>`; };
const mapHtml = BANDS.map((b) => `<div class="wbl-band ${b.id}"><p class="wbl-bandl"><b>${b.name}</b>${b.note ? ' <span>' + b.note + '</span>' : ''}</p><div class="wbl-row">${b.ids.map(nodeBtn).join('')}</div></div>`).join('');
const chips = PROB.map((p) => `<button type="button" class="wbl-chip ${p.pre}" data-prob="${p.id}" title="${p.name}">${p.id}</button>`).join('');
const blockSw = Object.entries(BLOCKS).map(([id, b]: any) => `<button type="button" class="wbl-sw" data-sw="${id}" aria-pressed="true">${icon(b.ic, LAYER_TONE[layerOf(id)], 32)}<span>${id}</span></button>`).join('');

// Board level charts, the same data and scales as the stage's scene 8.
const waffle = PROB.map((p) => `<button type="button" class="${p.ev}" data-prob="${p.id}">${p.id}</button>`).join('');
const M = INCIDENTS.months; const W = 320, H = 110;
const base = (v: number[]) => (v[0] + v[1] + v[2]) / 3;
const idx = M.series.map((sr: any) => sr.v.map((x: number) => x / base(sr.v)));
const ymax = Math.max(...idx.flat()) * 1.1;
const px = (i: number) => (i + 0.5) * W / M.labels.length; const py = (y: number) => 8 + (H - 16) * (1 - y / ymax);
const linePaths = idx.map((ys: number[], k: number) => '<path class="s' + k + '" vector-effect="non-scaling-stroke" d="' + ys.map((y, i) => (i ? 'L' : 'M') + px(i).toFixed(1) + ' ' + py(y).toFixed(1)).join(' ') + '"/>').join('');
const lineDots = idx.map((ys: number[], k: number) => ys.map((y, i) => '<i class="wbl-pt s' + k + '" style="left:' + (px(i) / W * 100).toFixed(1) + '%;top:' + (py(y) / H * 100).toFixed(1) + '%"></i>').join('')).join('');
const costBars = costRows.map((x) => `<button type="button" data-block="${x.id}"><b>${BLOCKS[x.id].name}</b><i class="wbl-bar"><i style="left:${bar(x.r[0])}%;width:${Math.max(1.2, +bar(x.r[1]) - +bar(x.r[0]))}%"></i></i><span>${x.cost.replace(' a month', '')}</span></button>`).join('');
const lanesHtml = `<div class="wbl-lanes" role="table" aria-label="Who does what"><div class="wbl-lhead" role="row"><i></i>${LANES.cols.map((c: string, ci: number) => `<b data-col="${ci}">${c}</b>`).join('')}</div>${LANES.rows.map((r: string, ri: number) => `<div class="wbl-lrow" role="row"><b>${r}</b>${LANES.cols.map((_: string, ci: number) => { const c = cellOf(ri, ci); return c ? `<button type="button" data-cell="${ri}-${ci}" data-col="${ci}">${c.task}</button>` : '<i></i>'; }).join('')}</div>`).join('')}</div>`;
---

<div class="wbl" id="wbl" data-zoom="system" data-arch="target">
  <div class="wbl-sprite" aria-hidden="true" set:html={sprite} />
  <script type="application/json" id="wbl-data" set:html={clientData}></script>

  <div class="wbl-top">
    <div class="wbl-nums">
      {HERO.map((h) => <div class="wbl-num"><b>{h.n}</b><span>{h.l}</span><Fragment set:html={evTag(h.ev)} /></div>)}
    </div>
    <div class="wbl-rail" role="group" aria-label="Zoom level">
      <button type="button" data-zoomto="board">Board</button>
      <button type="button" data-zoomto="system">System</button>
      <button type="button" data-zoomto="block">Block</button>
      <button type="button" data-zoomto="problem">Problem</button>
      <button type="button" data-zoomto="run">Run it</button>
      <button type="button" class="wbl-playbtn" data-film="play">Play the film</button>
    </div>
  </div>

  <section class="wbl-view" data-v="system" id="wbl-system">
    <div class="wbl-sysbar">
      <div class="wbl-hud" aria-live="off">
        <span><b id="wbl-sent">0</b> requests</span><span class="ok"><b id="wbl-pass">0</b> through clean</span><span class="stop"><b id="wbl-caught">0</b> caught</span><span class="leak"><b id="wbl-leak">0</b> missed</span><i class="wb-ev design">design</i>
      </div>
      <div class="wbl-switch" role="group" aria-label="Architecture view">
        <button type="button" data-arch="target" aria-pressed="true">Target</button>
        <button type="button" data-arch="interim" aria-pressed="false">This week</button>
      </div>
    </div>
    <div class="wbl-stagegrid">
      <div class="wbl-map" id="wbl-map">
        <svg class="wbl-wires" aria-hidden="true"><path class="req" id="wbl-req"></path><path class="loop" id="wbl-loop"></path><g id="wbl-dots"></g></svg>
        <Fragment set:html={mapHtml} />
      </div>
      <aside class="wbl-card" id="wbl-card" hidden aria-labelledby="wbl-card-h">
        <button type="button" class="wbl-close" data-close>Close</button>
        <p class="wbl-k" id="wbl-card-k"></p>
        <h3 id="wbl-card-h" tabindex="-1"></h3>
        <div id="wbl-card-b"></div>
      </aside>
    </div>
    <div class="wbl-strip">
      <p class="wbl-stripl"><b>24 failures</b> <span>lit red when nothing stops them</span></p>
      <div class="wbl-chips"><Fragment set:html={chips} /></div>
    </div>
    <div class="wbl-strip">
      <p class="wbl-stripl"><b>What if</b> <span>switch a block off, watch what leaks</span></p>
      <div class="wbl-sws"><Fragment set:html={blockSw} /></div>
    </div>
  </section>

  <section class="wbl-view" data-v="board" id="wbl-board" hidden>
    <ol class="wbl-say">{BOARD.map((b) => <li><b>{b.n}</b><span>{b.s}</span><Fragment set:html={evTag(b.ev)} /></li>)}</ol>
    <div class="wbl-charts">
      <div class="wbl-chart"><h3>Proof the fixes work <i class="wb-ev design">design</i></h3><div class="wbl-waffle" set:html={waffle} /><ul class="wbl-key"><li><i class="k m"></i>measured {proofCount('m')}</li><li><i class="k v"></i>vendor-reported {proofCount('v')}</li><li><i class="k n"></i>not measured {proofCount('n')}</li></ul></div>
      <div class="wbl-chart"><h3>{INCIDENTS.label} <Fragment set:html={evTag(INCIDENTS.ev)} /></h3><div class="wbl-linewrap"><svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" set:html={`<line class="base" x1="0" x2="${W}" y1="${py(1).toFixed(1)}" y2="${py(1).toFixed(1)}"/>` + linePaths} /><Fragment set:html={lineDots} /></div><div class="wbl-months">{M.labels.map((l: string) => <span>{l}</span>)}</div><ul class="wbl-key">{INCIDENTS.rows.map((r: any, k: number) => <li><i class={`k s${k}`}></i>{r.name} {r.x}x</li>)}</ul></div>
      <div class="wbl-chart wide"><h3>Cost to run, a month <i class="wb-ev illustrative">illustrative</i></h3><div class="wbl-bars" set:html={costBars} /></div>
    </div>
    <details class="wbl-unknown"><summary>What we do not know yet</summary><ul>{UNKNOWN.map((u) => <li><b>{u.t}.</b> {u.s}</li>)}</ul></details>
  </section>

  <section class="wbl-view" data-v="run" id="wbl-run" hidden>
    <p class="wbl-runl"><b>Six teams, five stages.</b> <span>The playhead lights what comes due. Tap a task.</span></p>
    <Fragment set:html={lanesHtml} />
    <aside class="wbl-card run" id="wbl-cellcard" hidden aria-labelledby="wbl-cell-h">
      <button type="button" class="wbl-close" data-close>Close</button>
      <p class="wbl-k" id="wbl-cell-k"></p>
      <h3 id="wbl-cell-h" tabindex="-1"></h3>
      <div id="wbl-cell-b"></div>
    </aside>
  </section>

  <div class="wbl-film" id="wbl-film" hidden>
    <p class="wbl-cap" id="wbl-cap" aria-live="polite"></p>
    <div class="wbl-scrub"><i class="wbl-prog"><i id="wbl-prog"></i></i>
      <div class="wbl-marks" role="group" aria-label="Chapters">{[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <button type="button" data-beat={n}>{n}</button>)}</div>
      <button type="button" class="wbl-pp" data-film="toggle">Pause</button>
      <button type="button" class="wbl-pp" data-film="stop">Stop</button>
    </div>
  </div>
</div>

<style is:global>
  .wbl { --sbg: #0b0f17; --sink: #eef3ff; --smut: #a7b4c9; --srule: rgba(167, 180, 201, .22); --spanel: #111827;
    --good: #4edab5; --warn: #f4cb73; --stop: #ff776c; --flow: #86abdd; --ctl: #c79a45; --vio: #a5a2d4; --cor: #e8aa96;
    position: relative; margin: 20px 0 0; padding: 20px; border-radius: 20px; background: var(--sbg); color: var(--sink);
    font-family: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif; display: grid; gap: 16px; }
  .wbl-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .wbl button { font: inherit; color: inherit; cursor: pointer; }
  .wbl h3 { margin: 0; font-size: 18px; text-wrap: balance; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .wbl p { margin: 0; text-wrap: pretty; }
  .wbl .wb-ev { display: inline-flex; font: 600 14px/1.2 "IBM Plex Mono", ui-monospace, monospace; font-style: normal; padding: 3px 7px; border: 1.5px solid currentColor; border-radius: 6px; white-space: nowrap; }
  .wbl .wb-ev.verified { color: var(--good); } .wbl .wb-ev.vendor { color: var(--ctl); } .wbl .wb-ev.illustrative { color: var(--smut); border-style: dashed; } .wbl .wb-ev.design { color: var(--flow); border-style: dashed; } .wbl .wb-ev.unverified { color: var(--warn); border-style: dashed; }

  .wbl-top { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; justify-content: space-between; }
  .wbl-nums { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .wbl-num { display: grid; grid-template-columns: auto auto; gap: 2px 10px; align-items: center; }
  .wbl-num b { font: 600 34px/1 "IBM Plex Mono", ui-monospace, monospace; grid-row: span 2; }
  .wbl-num span { font-size: 15px; color: var(--smut); max-width: 18ch; }
  .wbl-rail { display: flex; flex-wrap: wrap; gap: 6px; }
  .wbl-rail button, .wbl-switch button, .wbl-pp, .wbl-close { min-height: 44px; padding: 0 14px; border-radius: 10px; border: 1.5px solid var(--srule); background: transparent; font-size: 15px; font-weight: 600; }
  .wbl-rail button[aria-current="true"], .wbl-switch button[aria-pressed="true"] { background: var(--sink); color: var(--sbg); border-color: var(--sink); }
  .wbl-rail .wbl-playbtn { border-color: var(--good); color: var(--good); }

  .wbl-view[hidden] { display: none; }
  .wbl-view { display: grid; gap: 14px; }
  .wbl-sysbar { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; }
  .wbl-hud { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; font-size: 15px; color: var(--smut); }
  .wbl-hud b { font: 600 20px/1 "IBM Plex Mono", ui-monospace, monospace; color: var(--sink); margin-right: 4px; font-variant-numeric: tabular-nums; }
  .wbl-hud .ok b { color: var(--good); } .wbl-hud .stop b { color: var(--warn); } .wbl-hud .leak b { color: var(--stop); }
  .wbl-switch { display: flex; gap: 6px; }

  .wbl-stagegrid { display: grid; gap: 14px; }
  .wbl[data-card="on"] .wbl-stagegrid { grid-template-columns: minmax(0, 1fr) 340px; }
  .wbl-map { position: relative; display: grid; gap: 10px; padding: 12px; border-radius: 16px; background: radial-gradient(120% 90% at 50% 10%, #16213a 0%, var(--sbg) 70%); border: 1px solid var(--srule); overflow: hidden; transition: transform .6s ease; }
  .wbl-wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
  .wbl-wires path { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .wbl-wires .req { stroke: var(--flow); opacity: .45; stroke-dasharray: 6 6; }
  .wbl-wires .loop { stroke: var(--good); opacity: .35; stroke-dasharray: 3 6; }
  .wbl-wires circle.ok { fill: var(--good); } .wbl-wires circle.S { fill: var(--vio); } .wbl-wires circle.F { fill: var(--cor); } .wbl-wires circle.leak { fill: var(--stop); } .wbl-wires circle.back { fill: var(--good); opacity: .8; }
  .wbl-band { display: grid; gap: 6px; padding: 8px; border-radius: 12px; border: 1px dashed var(--srule); }
  .wbl-band.control { border-color: rgba(199, 154, 69, .45); } .wbl-band.fence { border-color: rgba(255, 119, 108, .35); } .wbl-band.out { border-style: dotted; }
  .wbl-bandl { font-size: 14px; color: var(--smut); } .wbl-bandl b { color: var(--sink); font-weight: 600; }
  .wbl-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 8px; }
  @media (min-width: 1200px) { .wbl:not([data-card="on"]) .wbl-band.data .wbl-row { grid-template-columns: repeat(11, minmax(0, 1fr)); } }
  .wbl-node { position: relative; display: grid; justify-items: center; align-content: start; gap: 4px; min-height: 116px; padding: 16px 10px 8px; border-radius: 12px; border: 1.5px solid var(--srule); background: rgba(17, 24, 39, .85); text-align: center; transition: opacity .3s, border-color .3s, transform .3s, box-shadow .3s; }
  .wbl-node b { font-size: 14px; font-weight: 600; line-height: 1.2; text-wrap: balance; }
  .wbl-node .wbl-tagl, .wbl-node .wbl-q { font: 500 14px/1.2 "IBM Plex Mono", ui-monospace, monospace; color: var(--smut); }
  .wbl-node .wbl-q { display: none; color: var(--warn); }
  .wbl-node.ext { border-style: dotted; }
  .wbl-node.hit { border-color: var(--warn); box-shadow: 0 0 0 3px rgba(244, 203, 115, .25); }
  .wbl-node.sel { border-color: var(--sink); transform: scale(1.06); }
  .wbl-node.dim { opacity: .28; }
  .wbl-node.off { opacity: .3; border-style: dashed; }
  .wbl-node.lit { border-color: var(--good); box-shadow: 0 0 0 3px rgba(78, 218, 181, .2); }
  .wbl-badge { display: none; position: absolute; top: 6px; left: 6px; min-width: 26px; height: 26px; border-radius: 13px; background: var(--sink); color: var(--sbg); font: 600 14px/26px "IBM Plex Mono", monospace; font-style: normal; }
  .wbl[data-badges="on"] .wbl-node[data-block]:not([data-block=""]) .wbl-badge { display: block; }
  .wbl[data-arch="interim"] .wbl-node.im .wbl-tagl { display: none; } .wbl[data-arch="interim"] .wbl-node.im .wbl-q { display: block; }
  .wbl[data-arch="interim"] .wbl-node.im.noq { border-style: dashed; opacity: .55; }
  .wbl[data-focus="control"] .wbl-band:not(.control) .wbl-node, .wbl[data-focus="fence"] .wbl-band:not(.fence) .wbl-node { opacity: .3; }

  .wbl-strip { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 12px; align-items: center; }
  .wbl-stripl { font-size: 15px; color: var(--smut); } .wbl-stripl b { color: var(--sink); display: block; font-size: 16px; }
  .wbl-chips, .wbl-sws { display: flex; flex-wrap: wrap; gap: 6px; }
  .wbl-chip { min-width: 46px; min-height: 42px; border-radius: 8px; border: 1.5px solid var(--srule); background: transparent; font: 600 14px/1 "IBM Plex Mono", monospace !important; }
  .wbl-chip.S { color: var(--vio); } .wbl-chip.F { color: var(--cor); }
  .wbl-chip.flash { background: rgba(244, 203, 115, .22); border-color: var(--warn); }
  .wbl-chip.leak { background: rgba(255, 119, 108, .25); border-color: var(--stop); color: var(--sink); }
  .wbl-chip.terms { border-style: dashed; }
  .wbl-sw { display: inline-flex; gap: 6px; align-items: center; min-height: 44px; padding: 0 10px 0 6px; border-radius: 10px; border: 1.5px solid var(--srule); background: transparent; font: 600 14px/1 "IBM Plex Mono", monospace !important; }
  .wbl-sw[aria-pressed="false"] { opacity: .45; border-style: dashed; text-decoration: line-through; }

  .wbl-card { display: grid; gap: 10px; align-content: start; padding: 16px; border-radius: 16px; background: var(--spanel); border: 1px solid var(--srule); }
  .wbl-card[hidden] { display: none; }
  .wbl-card .wbl-close { justify-self: end; }
  .wbl-k { font: 500 14px/1.3 "IBM Plex Mono", monospace; color: var(--smut); }
  .wbl-card h3 { font-size: 20px; }
  .wbl-card dl { margin: 0; display: grid; gap: 8px; }
  .wbl-card dt { font-size: 14px; color: var(--smut); } .wbl-card dd { margin: 0; font-size: 15px; line-height: 1.45; }
  .wbl-card h4 { margin: 4px 0 0; font-size: 15px; color: var(--good); text-wrap: balance; }
  .wbl-card p, .wbl-card li, .wbl-card dd { text-wrap: balance; }
  .wbl-card ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; font-size: 15px; line-height: 1.4; }
  .wbl-card .wbl-catch { padding: 10px 12px; border-radius: 10px; border: 1.5px solid var(--warn); font-size: 15px; }
  .wbl-card .wbl-catch.leak { border-color: var(--stop); }
  .wbl-card .wbl-cchips { display: flex; flex-wrap: wrap; gap: 6px; }
  .wbl-card .wbl-cbar { height: 12px; border-radius: 6px; background: rgba(167, 180, 201, .15); position: relative; } .wbl-card .wbl-cbar i { position: absolute; top: 0; bottom: 0; border-radius: 6px; background: var(--flow); }

  .wbl-say { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
  .wbl-say li { display: grid; gap: 6px; align-content: start; padding: 14px; border-radius: 14px; background: var(--spanel); border: 1px solid var(--srule); font-size: 15px; line-height: 1.45; }
  .wbl-say b { font: 600 30px/1 "IBM Plex Mono", monospace; }
  .wbl-say .wb-ev { justify-self: start; }
  .wbl-charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .wbl-chart { display: grid; gap: 10px; align-content: start; padding: 14px; border-radius: 14px; background: var(--spanel); border: 1px solid var(--srule); }
  .wbl-chart.wide { grid-column: 1 / -1; }
  .wbl-waffle { display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 6px; }
  .wbl-waffle button { min-height: 42px; border-radius: 8px; border: 1.5px solid var(--srule); background: transparent; font: 600 14px/1 "IBM Plex Mono", monospace !important; }
  .wbl-waffle .m { background: rgba(78, 218, 181, .28); border-color: var(--good); } .wbl-waffle .v { background: rgba(199, 154, 69, .25); border-color: var(--ctl); }
  .wbl-key { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; color: var(--smut); }
  .wbl-key .k { display: inline-block; width: 14px; height: 14px; border-radius: 4px; margin-right: 6px; vertical-align: -2px; border: 1.5px solid var(--srule); }
  .wbl-key .k.m { background: rgba(78, 218, 181, .5); } .wbl-key .k.v { background: rgba(199, 154, 69, .5); } .wbl-key .k.s0 { background: var(--stop); } .wbl-key .k.s1 { background: var(--smut); }
  .wbl-linewrap { position: relative; height: 140px; }
  .wbl-linewrap svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wbl-linewrap path { fill: none; stroke-width: 2.5; } .wbl-linewrap path.s0 { stroke: var(--stop); } .wbl-linewrap path.s1 { stroke: var(--smut); }
