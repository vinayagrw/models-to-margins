  .wbl-lrow button { min-height: 52px; padding: 6px 8px; border-radius: 10px; border: 1.5px solid var(--srule); background: rgba(17, 24, 39, .85); font-size: 14px; line-height: 1.25; text-align: left; text-wrap: balance; transition: border-color .3s, opacity .3s; opacity: .55; }
  .wbl-lrow button.on { opacity: 1; border-color: var(--good); }
