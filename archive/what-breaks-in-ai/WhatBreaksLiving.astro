  .wbl-film { position: sticky; bottom: 0; z-index: 5; display: grid; gap: 8px; padding: 12px 14px; border-radius: 14px; background: rgba(11, 15, 23, .94); border: 1px solid var(--srule); backdrop-filter: blur(10px); }
  .wbl-film[hidden] { display: none; }
  .wbl-cap { font-size: 22px; font-weight: 600; text-wrap: balance; }
  .wbl-scrub { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .wbl-prog { flex: 1 1 100%; height: 4px; border-radius: 2px; background: var(--srule); position: relative; } .wbl-prog i { position: absolute; left: 0; top: 0; bottom: 0; background: var(--good); border-radius: 2px; width: 0; }
  .wbl-marks { display: flex; flex-wrap: wrap; gap: 6px; }
  .wbl-marks button { min-width: 44px; min-height: 44px; border-radius: 10px; border: 1.5px solid var(--srule); background: transparent; font: 600 14px/1 "IBM Plex Mono", monospace !important; }
  .wbl-marks button[aria-current="true"] { background: var(--good); color: var(--sbg); border-color: var(--good); }

  @media (max-width: 1199px) { .wbl[data-card="on"] .wbl-stagegrid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) {
    .wbl { padding: 12px; border-radius: 14px; }
    .wbl-row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; } .wbl-node b { font-size: 14px; letter-spacing: -.03em; } .wbl-band { padding: 6px; } .wbl-map { padding: 8px; }
    .wbl-node { min-height: 100px; }
    .wbl-strip { grid-template-columns: minmax(0, 1fr); }
    .wbl-lhead { display: none; }
    .wbl-lrow { grid-template-columns: minmax(0, 1fr); }
    .wbl-lrow button { opacity: 1; }
    .wbl-lrow button::before { content: attr(data-stage); }
    .wbl-bars button { grid-template-columns: minmax(0, 1fr) auto; } .wbl-bars button .wbl-bar { grid-column: 1 / -1; grid-row: 2; }
    .wbl-bars button { min-width: 0; } .wbl-bars button b { min-width: 0; }
    .wbl[data-card="on"] .wbl-band.out, .wbl[data-card="on"] .wbl-band.control, .wbl[data-card="on"] .wbl-strip:last-child { display: none; }
