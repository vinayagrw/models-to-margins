---
/* The cinematic stage for What Breaks in AI. One dark 3D stage (three.js, loaded only
   when near view) sits behind the scene text. Every scene also has a still frame built
   from DOM, which is what prints, what reduced-motion readers get, what phones get, and
   what shows when WebGL is off. All text is DOM so the layout gate and screen readers can
   see it. Data comes from src/data/what-breaks/*.json, copied by drafts/deep/gen_site.py, and is
   shaped once for every page by what-breaks/model.ts. */
import { sprite, view, LAYERS, BLOCKS, STEPS, ALWAYS, PLAYS, LAYER_TONE, layerOf, icon, evTag, quickBy, quickCount, PROB, LABELS, PROOF, proofCount, FF, qOf, BUILD, LANES, cellOf, costRows, bar, INCIDENTS, BOARD, UNKNOWN, HERO, clientData } from './what-breaks/model';
import './what-breaks/iso-tones.css';

/* Deck mode (the /present route): every scene is one slide, stills only, no 3D. */
const { mode = 'page' } = Astro.props as { mode?: 'page' | 'deck' };

// Still 1: the four layers as rows of block tiles, top layer first.
const stillSystem = LAYERS.slice().reverse().map((L) => { const i = LAYERS.indexOf(L); return `<div class="wb-layer"><h3>${L.name}</h3><div class="wb-tiles">${L.blocks.map((id) => `<button type="button" class="wb-tile" data-open="${id}">${icon(BLOCKS[id].ic, LAYER_TONE[i])}<b>${BLOCKS[id].name}</b><span>${id}</span></button>`).join('')}</div></div>`; }).join('');

// Still 5: the offline loop strip that sits under the seven-step list.
const stillLoop = `<div class="wb-loop" aria-label="The offline loop"><div class="wb-loopnode">${icon(BLOCKS.P3.ic, LAYER_TONE[0])}<b>Failure log</b><span>each failure logged</span></div><span class="wb-looparrow" aria-hidden="true">→</span><div class="wb-loopnode">${icon(ALWAYS[0].ic, LAYER_TONE[2])}<b>${ALWAYS[0].name}</b><span>becomes a test case</span></div><span class="wb-looparrow" aria-hidden="true">→</span><div class="wb-loopnode">${icon(BLOCKS.P6.ic, LAYER_TONE[2])}<b>Gateway</b><span>tests gate every change</span></div><span class="wb-looparrow back" aria-hidden="true">↺</span></div>`;

// Still 4: the architecture as a DOM grid. Control plane row, data plane in request order, outside systems.
// Connector lines are drawn by the client script once the buttons have positions.
const archGrid = (() => {
  if (!view) return '';
  const nodes: any[] = view.nodes, flows: any[] = view.flows;
  const order = new Map<string, number>();
  flows.filter((f) => f.kind === 'request' || f.kind === 'response').sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
    .forEach((f) => { for (const id of [f.from, f.to]) if (!order.has(id)) order.set(id, order.size); });
  const inOrg = (n: any) => n.zone === 'org';
  const ctrl = nodes.filter((n) => inOrg(n) && n.plane === 'control');
  const data = nodes.filter((n) => inOrg(n) && n.plane === 'data').sort((a, b) => (order.get(a.id) ?? 99) - (order.get(b.id) ?? 99));
  const fence = data.filter((n) => n.block === 'P4' && n.id !== 'act');
  const main = data.filter((n) => !fence.includes(n));
  const out = nodes.filter((n) => !inOrg(n));
  let idx = 0;
  const btn = (n: any, k = '') => { const o = order.get(n.id); const tone = n.block ? LAYER_TONE[layerOf(n.block)] : 'iso-violet'; const qn = n.block ? (quickBy[n.block] ?? []).length : 0; const noq = !n.external && qn === 0; return `<button type="button" class="wb-node ${k} ${n.external ? 'ghost' : ''} ${noq ? 'noq' : ''}" data-node="${n.id}" style="--i:${idx++}">${o !== undefined && main.includes(n) ? `<i class="wb-ord">${o + 1}</i>` : ''}${n.block ? icon(BLOCKS[n.block].ic, tone, 44) : ''}<b>${n.name}</b><span>${n.block ?? (n.ev === 'design' ? 'design' : (n.zone === 'vendor' ? 'provider' : n.zone === 'sandbox' ? 'isolated' : ''))}</span><span class="wb-q">${n.external ? 'as today' : qn ? `${qn} fix${qn > 1 ? 'es' : ''} now` : 'no fix yet'}</span></button>`; };
  return `<div class="wb-archgrid" id="wb-archgrid"><svg class="wb-wires" aria-hidden="true"></svg>
    <div class="wb-zone org"><p class="wb-zonel">Your organisation <i class="wb-ev design">trust boundary, design</i></p>
      <div class="wb-plane"><p class="wb-planel">Control plane. The settings, versioned.</p><div class="wb-row">${ctrl.map((n) => btn(n, 'ctl')).join('')}</div></div>
      <div class="wb-plane"><p class="wb-planel">Data plane. Enforced on every request, in this order.</p><div class="wb-row data">${main.map((n) => btn(n)).join('')}</div>
        <p class="wb-planel">The agent fence, around step ${(order.get('act') ?? 0) + 1}.</p><div class="wb-row fence">${fence.map((n) => btn(n, 'fence')).join('')}</div></div>
    </div>
    <div class="wb-zone out"><p class="wb-zonel">Outside your boundary</p><div class="wb-row">${out.map((n) => btn(n, 'out')).join('')}</div></div>
    <ul class="wb-key" aria-label="Line key"><li><i class="k flow"></i>request and answer</li><li><i class="k ctl"></i>settings</li><li><i class="k log"></i>logs</li><li><i class="k loop"></i>offline loop</li></ul>
  </div>`;
})();

const chip = (p: any) => `<button type="button" class="wb-spark ${p.st}" data-open="${p.id}">${icon(p.ic, p.pre === 'S' ? 'iso-violet' : 'iso-coral', 44)}<b>${p.name}</b><span>${LABELS[p.st].name}</span></button>`;
const stillSparks = `<div class="wb-lanes">${[['S', 'Web search'], ['F', 'Wider AI use']].map(([pre, t]) => `<div class="wb-lane"><h3>${t}, ${PROB.filter((p) => p.pre === pre).length}</h3><div class="wb-tiles">${PROB.filter((p) => p.pre === pre).map(chip).join('')}</div></div>`).join('')}</div>
  <details class="wb-matrix wb-fold"><summary>How bad it is, against how well the fix is proven <i class="wb-ev design">design</i></summary>
    <div class="wb-mgrid"><i></i>${['n', 'v', 'm'].map((k) => `<b>${PROOF[k]} <span>${proofCount(k)}</span></b>`).join('')}
    ${['high', 'medium', 'lower'].map((sv) => `<b class="sev">${sv}</b>${['n', 'v', 'm'].map((k) => `<div>${PROB.filter((p) => p.sev === sv && p.ev === k).map((p) => `<button type="button" class="wb-dot ${p.st}" data-open="${p.id}" title="${p.name}">${p.id}</button>`).join('')}</div>`).join('')}`).join('')}</div>
  </details>`;

// Scene 3: fix now, then fix properly. Four moves with the quick fix this week and the target block.
const stillMoves = `<div class="wb-moves">${FF.moves.map((m: any) => { const q = qOf(m.covers); const b = BLOCKS[m.block]; return `<article class="wb-move"><div class="wb-movetop"><span class="wb-n">${m.n}</span>${icon(m.ic, 'iso-teal', 64)}</div><h3>${m.title}</h3><p class="wb-who">${m.who}</p>${q ? `<p class="wb-week"><b>This week</b> ${q.fix} <i class="wb-ev ${q.ev}">${q.ev === 'verified' ? 'verified 2026' : q.ev}</i></p>` : ''}<button type="button" class="wb-then" data-open="${m.block}"><b>Then</b> ${m.block} ${b.name}</button></article>`; }).join('')}</div>
  <details class="wb-next wb-fold"><summary>Then, in this order</summary><div class="wb-nextrow">${FF.next.map((x: any, i: number) => `<button type="button" data-open="${x.block}"><span>Step ${i + 5}</span><b>${x.step}</b><span>${x.who} · ${x.covers}</span></button>`).join('')}</div></details>`;

// Scene 6: build it, contracts first. One row per layer in build order.
const stillBuild = `<ol class="wb-build">${BUILD.order.map((name: string, i: number) => { const li = LAYERS.findIndex((l) => l.name === name); const L = LAYERS[li]; return `<li class="wb-brow" style="--i:${i}"><span class="wb-n">${i + 1}</span><div><h3>${name}</h3><p>${BUILD.why[name]}</p></div><div class="wb-btiles">${L.blocks.map((id) => `<button type="button" data-open="${id}">${icon(BLOCKS[id].ic, LAYER_TONE[li], 44)}<b>${BLOCKS[id].name}</b></button>`).join('')}</div></li>`; }).join('')}</ol>`;

// Scene 7: run it. Six teams by five stages, a playhead sweeps the stages.
const stillLanes = `<div class="wb-lanesgrid" role="table" aria-label="Who does what"><div class="wb-lhead" role="row"><i></i>${LANES.cols.map((c: string, ci: number) => `<button type="button" data-colbtn="${ci}">${c}</button>`).join('')}</div>${LANES.rows.map((r: string, ri: number) => `<div class="wb-lrow" role="row"><b>${r}</b>${LANES.cols.map((_: string, ci: number) => { const c = cellOf(ri, ci); return c ? `<button type="button" data-cell="${ri}-${ci}" data-col="${ci}" data-stage="${LANES.cols[ci]}"><b>${c.task}</b></button>` : '<i></i>'; }).join('')}</div>`).join('')}</div>`;

// Scene 8: cost, proof and the board. Real charts from the data, every number tagged.
const stillCharts = `<div class="wb-charts">
  <details class="wb-chart wb-fold"><summary>Cost to run, a month <i class="wb-ev illustrative">illustrative</i></summary><div class="wb-bars">${costRows.map((x) => `<button type="button" data-open="${x.id}"><b>${x.name}</b><i class="wb-bar"><i style="left:${bar(x.r![0])}%;width:${Math.max(1.2, +bar(x.r![1]) - +bar(x.r![0]))}%"></i></i><span>${x.cost.replace(' a month', '')}</span></button>`).join('')}</div></details>
  <div class="wb-chart"><h3>Proof the fixes work <i class="wb-ev design">design</i></h3><div class="wb-waffle">${PROB.map((p) => `<button type="button" class="${p.ev}" data-open="${p.id}">${p.id}</button>`).join('')}</div><ul class="wb-key"><li><i class="k m"></i>measured ${proofCount('m')}</li><li><i class="k v"></i>vendor-reported ${proofCount('v')}</li><li><i class="k n"></i>not measured ${proofCount('n')}</li></ul></div>
  <div class="wb-chart"><h3>${INCIDENTS.label} <i class="wb-ev verified">verified 2026</i></h3>${(() => { const M = INCIDENTS.months; const n = M.labels.length; const W = 320, H = 110, T = 8, B = 8; const base = (v: number[]) => (v[0] + v[1] + v[2]) / 3; const idx = M.series.map((sr: any) => sr.v.map((x: number) => x / base(sr.v))); const max = Math.max(...idx.flat()) * 1.1; const px = (i: number) => (i + 0.5) * W / n; const py = (y: number) => T + (H - T - B) * (1 - y / max); const line = (ys: number[]) => ys.map((y, i) => `${i ? 'L' : 'M'}${px(i).toFixed(1)} ${py(y).toFixed(1)}`).join(' '); return `<div class="wb-linewrap"><svg class="wb-line" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="${py(1).toFixed(1)}" x2="${W}" y2="${py(1).toFixed(1)}" class="base"/>${idx.map((ys: number[], k: number) => `<path d="${line(ys)}" class="s${k}" vector-effect="non-scaling-stroke"/>`).join('')}</svg>${idx.map((ys: number[], k: number) => ys.map((y, i) => `<i class="wb-dot-pt s${k}" style="left:${(px(i) / W * 100).toFixed(1)}%;top:${(py(y) / H * 100).toFixed(1)}%" title="${M.labels[i]} ${y.toFixed(1)}x"></i>`).join('')).join('')}</div><div class="wb-months" aria-hidden="true">${M.labels.map((l: string) => `<span>${l}</span>`).join('')}</div><ul class="wb-key">${INCIDENTS.rows.map((r: any, k: number) => `<li><i class="k s${k}"></i>${r.name} ${r.x}x</li>`).join('')}</ul>`; })()}</div>
</div>`;
---

<div class={`wb-cine ${mode === 'deck' ? 'wb-deck' : ''}`} id="wb-cine" data-scene="1" data-mode={mode}>
  <div class="wb-sprite" aria-hidden="true" set:html={sprite} />
  <script type="application/json" id="wb-data" set:html={clientData} />

  <div class="wb-stage" aria-hidden="true">
    <canvas class="wb-canvas"></canvas>
    <div class="wb-overlay"></div>
    <div class="wb-vignette"></div>
  </div>

  <div class="wb-scenes">
    <article class="wb-scene" id="scene-1" data-scene="1">
      <div class="wb-panel">
        <p class="wb-eyebrow">Board briefing, October 2026</p>
        <h2>AI fails in 24 known ways. The fixes are one system, not 24 projects.</h2>
        <div class="wb-nums">
          {HERO.map((h) => <div class="wb-num"><b>{h.n}</b><span>{h.l}</span><Fragment set:html={evTag(h.ev)} /></div>)}
        </div>
      </div>
      <details class="wb-lfold wb-fold"><summary>The four layers</summary><div class="wb-still wb-layers" set:html={stillSystem} /></details>
    </article>

    <article class="wb-scene" id="scene-2" data-scene="2">
      <div class="wb-panel">
        <p class="wb-eyebrow">Where it breaks</p>
        <h2>Ten failures hide inside the answer. Fourteen hit the business directly.</h2>
        <p class="wb-hint">Tap a problem for its number, its quick fix and its proper fix.</p>
      </div>
      <Fragment set:html={stillSparks} />
    </article>

    <article class="wb-scene" id="scene-3" data-scene="3">
      <div class="wb-panel">
        <p class="wb-eyebrow">Fix now, then fix properly</p>
        <h2>Four moves do most of the work. Each starts this week and lands on one block.</h2>
        <p class="wb-hint">None needs a new vendor.</p>
      </div>
      <Fragment set:html={stillMoves} />
    </article>

    <article class="wb-scene" id="scene-4" data-scene="4">
      <div class="wb-panel">
        <p class="wb-eyebrow">The architecture</p>
        <h2>A control plane holds the settings. A data plane enforces them on every request.</h2>
        <div class="wb-switch" role="group" aria-label="Architecture view">
          <button type="button" data-arch="target" aria-pressed="true">Target</button>
          <button type="button" data-arch="interim" aria-pressed="false">Interim</button>
          <i class="wb-ev design">design</i>
        </div>
        {view ? <p class="wb-hint" data-hint="target">Tap any part for its options and standards.</p> : <p class="wb-hint">The checked architecture view is being prepared.</p>}
        <p class="wb-hint" data-hint="interim">{quickCount} quick fixes with the tools you have. Dashed parts have none. Tap a part for its fixes.</p>
      </div>
      <Fragment set:html={archGrid} />
    </article>

    <article class="wb-scene" id="scene-5" data-scene="5">
      <div class="wb-panel">
        <p class="wb-eyebrow">Follow one request, end to end</p>
        <h2>Seven controls on the way out. One loop that turns each failure into a test.</h2>
        <div class="wb-plays" role="group" aria-label="Play a request">
          {PLAYS.map((p) => <button type="button" data-play={p.id} aria-pressed={p.id === 'good' ? 'true' : 'false'}>{p.label}</button>)}
          <i class="wb-ev illustrative">illustrative</i>
        </div>
        <p class="wb-msg" aria-live="polite">{PLAYS[0].msg}</p>
      </div>
      <ol class="wb-steps">
        {STEPS.map((s) => <li><button type="button" data-step={s.id} data-state="on" data-open={s.block}><svg class={`ic ${LAYER_TONE[layerOf(s.block)]}`} width="64" height="64" aria-hidden="true"><use href={`#${s.ic}`} /></svg><b>{s.name}</b><span class="wb-state">Passed</span></button></li>)}
      </ol>
      <Fragment set:html={stillLoop} />
    </article>

    <article class="wb-scene" id="scene-6" data-scene="6">
      <div class="wb-panel">
        <p class="wb-eyebrow">Build it</p>
        <h2>Four layers, built contracts first.</h2>
        <p class="wb-hint">Each layer rests on the one before it. <i class="wb-ev design">design</i></p>
      </div>
      <Fragment set:html={stillBuild} />
    </article>

    <article class="wb-scene" id="scene-7" data-scene="7">
      <div class="wb-panel">
        <p class="wb-eyebrow">Run it</p>
        <h2>Six teams, five stages, one loop from buy to change.</h2>
        <p class="wb-hint">The sweep lights each stage's tasks. Tap one for its standard.</p>
      </div>
      <Fragment set:html={stillLanes} />
    </article>

    <article class="wb-scene" id="scene-8" data-scene="8">
      <div class="wb-panel">
        <p class="wb-eyebrow">Cost, proof and the board</p>
        <h2>What it costs, how much is proven, and five sentences to repeat.</h2>
      </div>
      <Fragment set:html={stillCharts} />
      <div class="wb-board">
        <h3>What to tell your board</h3>
        <ol>{BOARD.map((b) => <li><b>{b.n}</b><span>{b.s}</span><i class={`wb-ev ${b.ev}`}>{b.ev === 'verified' ? 'verified 2026' : b.ev}</i></li>)}</ol>
        <h3>What we do not know yet</h3>
        <ul>{UNKNOWN.map((u) => <li><b>{u.t}.</b> {u.s}</li>)}</ul>
      </div>
    </article>
  </div>

  <aside class="wb-drawer" id="wb-drawer" hidden aria-labelledby="wb-drawer-h">
    <button type="button" class="wb-close" data-close>Close</button>
    <p class="wb-eyebrow" id="wb-drawer-k"></p>
    <h3 id="wb-drawer-h" tabindex="-1"></h3>
    <p class="wb-lead" id="wb-drawer-p"></p>
    <dl class="wb-kv" id="wb-drawer-kv"></dl>
    <div class="wb-fixes" id="wb-drawer-fx"></div>
    <div class="wb-quick" id="wb-drawer-q"></div>
    <div class="wb-arch-layer" id="wb-drawer-a"></div>
  </aside>
</div>

<style is:global>
  /* The stage is always dark, by owner decision (2026-10-26). The page shell around it follows the theme. */
  .wb-cine { --sbg: #0b0f17; --sink: #eef3ff; --smut: #a7b4c9; --srule: rgba(167, 180, 201, .22); --spanel: rgba(11, 15, 23, .8);
    --good: #4edab5; --warn: #f4cb73; --stop: #ff776c; --flow: #86abdd; --ctl: #c79a45;
    position: relative; margin: 20px 0 0; color: var(--sink); font-family: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif; }
  .wb-cine .wb-sprite { position: absolute; width: 0; height: 0; overflow: hidden; } /* never display:none, the sprite's gradients and masks stop rendering */
  .wb-stage { position: sticky; top: var(--wb-top, 0px); height: calc(100vh - var(--wb-top, 0px)); height: calc(100dvh - var(--wb-top, 0px)); overflow: hidden; background: radial-gradient(120% 90% at 50% 10%, #16213a 0%, var(--sbg) 60%, #05070c 100%); border-radius: 20px; display: none; }
  .wb-cine.is-3d .wb-stage { display: block; }
  .wb-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .wb-overlay { position: absolute; inset: 0; pointer-events: none; }
  .wb-overlay .wb-tag { position: absolute; transform: translate(-50%, 0); display: grid; justify-items: center; gap: 4px; font-size: 14px; line-height: 1.2; color: var(--sink); text-shadow: 0 1px 2px #000; white-space: nowrap; transition: opacity .4s; }
  .wb-overlay .wb-tag svg { width: 64px; height: 64px; filter: drop-shadow(0 6px 10px rgba(0,0,0,.5)); }
  .wb-overlay .wb-tag.dim { opacity: .28; }
  .wb-overlay .wb-tag.layer { transform: translate(0, -50%); font-weight: 600; letter-spacing: .02em; color: var(--smut); }
  .wb-vignette { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(5,7,12,0) 55%, rgba(5,7,12,.75) 100%); }
  .wb-cine.is-3d .wb-scenes { margin-top: calc(-100vh + var(--wb-top, 0px)); margin-top: calc(-100dvh + var(--wb-top, 0px)); position: relative; z-index: 1; }
  .wb-scene { display: grid; gap: 18px; align-content: end; padding: 24px 16px 36px; scroll-margin-top: var(--wb-top, 0px); }
  .wb-cine.is-3d .wb-scene { min-height: calc(40vh - var(--wb-top, 0px)); padding: 12px 24px 18px; }
  .wb-cine:not(.is-3d) .wb-scene { background: var(--sbg); border-radius: 20px; margin-bottom: 14px; padding: 20px 16px; }
  .wb-panel { max-width: min(100%, 780px); display: grid; gap: 14px; padding: 20px 22px; background: var(--spanel); border: 1px solid var(--srule); border-radius: 16px; backdrop-filter: blur(10px); }
  .wb-cine:not(.is-3d) .wb-panel { background: transparent; border: 0; padding: 0; max-width: 820px; }
  .wb-eyebrow { margin: 0; font: 600 14px/1.3 "IBM Plex Mono", ui-monospace, Menlo, monospace; letter-spacing: .06em; text-transform: uppercase; color: var(--ctl); }
  .wb-scene h2 { margin: 0; font-size: clamp(24px, 3.2vw, 38px); line-height: 1.12; font-weight: 700; letter-spacing: -.01em; text-wrap: balance; color: var(--sink); }
  .wb-scene h3 { margin: 0; font-size: 16px; font-weight: 600; text-wrap: balance; color: var(--smut); }
  .wb-scene p { margin: 0; text-wrap: pretty; color: var(--smut); font-size: 16px; line-height: 1.5; }
  .wb-hint { font-size: 15px; }
  .wb-nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .wb-num { display: grid; gap: 4px; align-content: start; padding: 12px; border: 1px solid var(--srule); border-radius: 12px; background: rgba(255,255,255,.03); }
  .wb-num b { font-size: 30px; line-height: 1; font-weight: 700; color: var(--sink); }
  .wb-num span { font-size: 14px; line-height: 1.35; color: var(--smut); text-wrap: balance; }
  .wb-ev { display: inline-flex; justify-self: start; font: 600 14px/1.2 "IBM Plex Mono", ui-monospace, Menlo, monospace; padding: 5px 9px; border: 1.5px solid currentColor; border-radius: 6px; white-space: nowrap; font-style: normal; }
  .wb-ev.verified { color: var(--good); } .wb-ev.vendor { color: var(--ctl); } .wb-ev.illustrative { color: var(--smut); border-style: dashed; } .wb-ev.design { color: var(--flow); border-style: dotted; }
  .wb-switch, .wb-plays { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .wb-cine button { font-family: inherit; font-size: 15px; font-weight: 600; line-height: 1.2; color: var(--sink); min-height: 44px; padding: 10px 14px; border-radius: 10px; border: 1.5px solid var(--srule); background: rgba(255,255,255,.04); cursor: pointer; }
  .wb-cine button:hover:not(:disabled) { border-color: var(--flow); }
  .wb-cine button:disabled { opacity: .45; cursor: default; }
  .wb-cine button[aria-pressed="true"] { background: var(--flow); border-color: var(--flow); color: #0b0f17; }
  .wb-cine :focus-visible { outline: 3px solid var(--warn); outline-offset: 2px; }
  .wb-msg { min-height: 48px; text-wrap: balance !important; }
  /* still 1: layers */
  .wb-still { display: grid; gap: 12px; }
  .wb-cine.is-3d .wb-still { display: none; }
