    }
    // One problem (scene 2, 3 and 8). The three-label key sits under the status.
    function openProblem(id: string, focusEl?: HTMLElement) {
      const p = D.probs.find((x: any) => x.id === id); if (!p) return; lastFocus = focusEl || null;
      const lab = D.labels[p.st];
      $('#wb-drawer-k').textContent = `${id} · ${p.pre === 'S' ? 'Web search' : 'Wider AI use'} · ${lab.name}`;
      $('#wb-drawer-h').textContent = p.name; $('#wb-drawer-p').textContent = p.see;
      $('#wb-drawer-kv').innerHTML = `<div><dt>The number</dt><dd>${p.num} ${p.numl} ${ev(p.nev)}</dd></div><div><dt>Why it happens</dt><dd>${p.why}</dd></div><div><dt>${lab.name}</dt><dd>${lab.s}</dd></div>`;
      $('#wb-drawer-fx').innerHTML = `<span>Owner ${p.own}</span><span>Effort ${p.eff}</span><span>Maturity ${p.mat}</span>` + (p.b || []).map((b: string) => `<span>${b} ${D.blocks[b]?.name || ''}</span>`).join('');
      $('#wb-drawer-q').innerHTML = p.quick ? `<h4>Quick fix this week</h4><ul><li><b>${p.quick.fix}</b><span>${p.quick.who}. ${p.quick.effort}.</span><span>Does not cover: ${p.quick.limit}</span>${ev(p.quick.ev)}</li></ul>` : '';
      $('#wb-drawer-a').innerHTML = `<h4>Fix properly</h4><p>${p.fix}</p><p><b>First step.</b> ${p.first}</p><p><b>Proof.</b> ${p.evl} ${ev(p.ev === 'm' ? 'verified' : p.ev === 'v' ? 'vendor' : undefined)}</p>`;
      showDrawer('open', id);
    }
    // One swimlane cell (scene 7).
    function openCell(id: string, focusEl?: HTMLElement) {
      const [r, c] = id.split('-').map(Number); const cell = D.lanes.cells.find((x: any) => x.r === r && x.c === c); if (!cell) return; lastFocus = focusEl || null;
      $('#wb-drawer-k').textContent = `${D.lanes.rows[r]} · ${D.lanes.cols[c]} · ${cell.cad}`;
      $('#wb-drawer-h').textContent = cell.task; $('#wb-drawer-p').textContent = cell.detail;
      $('#wb-drawer-kv').innerHTML = `<div><dt>Standard</dt><dd>${cell.std || 'None named'}</dd></div><div><dt>Evidence</dt><dd>${ev(cell.ev || 'design')}</dd></div>`;
      $('#wb-drawer-fx').innerHTML = ''; $('#wb-drawer-q').innerHTML = ''; $('#wb-drawer-a').innerHTML = '';
      showDrawer('cell', id);
    }
    function showDrawer(k: string, v: string) {
      drawer.hidden = false; ['open', 'node', 'cell'].forEach((x) => { if (x !== k) hashSet(x, null); }); hashSet(k, v); $$('.wb-node').forEach((n) => n.classList.toggle('sel', n.dataset.node === v));
      $(`#scene-${current}`).after(drawer);
      drawer.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' }); ($('#wb-drawer-h') as HTMLElement).focus({ preventScroll: true });
    }
    function closeDrawer() { drawer.hidden = true; hashSet('open', null); hashSet('node', null); hashSet('cell', null); $$('.wb-node').forEach((n) => n.classList.remove('sel')); lastFocus?.focus({ preventScroll: true }); }
    $('[data-close]').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) closeDrawer(); });
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement; const nb = t.closest('button[data-node]') as HTMLElement | null; const ob = t.closest('button[data-open]') as HTMLElement | null;
      const cb = t.closest('button[data-cell]') as HTMLElement | null;
      if (nb) openNode(nb.dataset.node!, nb); else if (cb) openCell(cb.dataset.cell!, cb); else if (ob) openAny(ob.dataset.open!, ob);
    });
    const openAny = (id: string, el?: HTMLElement) => (/^[SF]\d/.test(id) ? openProblem(id, el) : openBlock(id, el));

    // ---- architecture wires: lines between node buttons, redrawn on resize
    const grid = $('#wb-archgrid');
    function wires() {
      if (!grid || !D.view) return; const svg = $('.wb-wires', grid) as unknown as SVGSVGElement; const g = grid.getBoundingClientRect();
      if (g.width < 720) { svg.innerHTML = ''; return; } // narrow: the order badges carry the sequence
      const pos = (id: string) => { const b = $(`[data-node="${id}"]`, grid); if (!b) return null; const r = b.getBoundingClientRect(); return { x: r.left - g.left + r.width / 2, y: r.top - g.top + r.height / 2, t: r.top - g.top, b: r.bottom - g.top, l: r.left - g.left, r: r.right - g.left }; };
      const K: Record<string, string> = { request: 'flow', response: 'flow', control: 'ctl', log: 'log', offline: 'loop' };
      svg.innerHTML = D.view.flows.map((f: any) => {
        const a = pos(f.from), b = pos(f.to); if (!a || !b) return '';
        const same = Math.abs(a.y - b.y) < 4; let d: string;
        if (same && Math.abs(a.x - b.x) < 260) d = a.x < b.x ? `M${a.r} ${a.y} L${b.l} ${b.y}` : `M${a.l} ${a.y} L${b.r} ${b.y}`;
        else if (same) { const y = a.t - 14; d = `M${a.x} ${a.t} C${a.x} ${y}, ${b.x} ${y}, ${b.x} ${b.t}`; }
        else { const down = b.y > a.y; const y1 = down ? a.b : a.t, y2 = down ? b.t : b.b, m = (y1 + y2) / 2; d = `M${a.x} ${y1} C${a.x} ${m}, ${b.x} ${m}, ${b.x} ${y2}`; }
        return `<path class="${K[f.kind] || 'flow'}" d="${d}"><title>${f.label || ''}</title></path>`;
      }).join('');
    }
    wires(); addEventListener('resize', wires); if ((document as any).fonts?.ready) (document as any).fonts.ready.then(wires);

    // ---- interim / target switch (hash `arch=interim`). The morph is CSS, staggered per part.
    function setArch(v: string) {
      const interim = v === 'interim'; root.dataset.arch = interim ? 'interim' : 'target'; hashSet('arch', interim ? 'interim' : null);
      $$('.wb-switch button[data-arch]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.arch === (interim ? 'interim' : 'target'))));
    }
    $('.wb-switch').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button[data-arch]') as HTMLElement; if (b) setArch(b.dataset.arch!); });
    if (hashGet().get('arch') === 'interim') setArch('interim');

    // ---- scene 5 plays (DOM list is the source of truth, the 3D stage mirrors it)
    const stepEls = $$('.wb-steps button'); const stepIds = D.steps.map((s: any) => s.id);
    const WORD: Record<string, string> = { on: 'Passed', warn: 'Partly caught', stop: 'Stopped', na: 'Not used', wait: 'Waiting', skip: 'Skipped' };
    let playTimers: number[] = []; let onPlay: ((id: string, states: Record<string, string>) => void) | null = null;
    function setStep(id: string, st: string) { const el = stepEls.find((e) => e.dataset.step === id); if (!el) return; el.dataset.state = st; el.querySelector('.wb-state')!.textContent = WORD[st] || st; }
    function play(id: string) {
      const p = D.plays.find((x: any) => x.id === id); if (!p) return;
      $$('.wb-plays button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.play === id)));
      hashSet('play', id === 'good' ? null : id); $('.wb-msg').textContent = p.msg;
      playTimers.forEach(clearTimeout); playTimers = [];
      const final: Record<string, string> = {}; let stopped = false;
      for (const s of stepIds) { let st = p.st[s] || 'on'; if (stopped && s !== 'log') st = 'skip'; final[s] = st; if (st === 'stop') stopped = true; }
      if (reduce) { stepIds.forEach((s: string) => setStep(s, final[s])); }
      else { stepIds.forEach((s: string) => setStep(s, 'wait')); stepIds.forEach((s: string, i: number) => playTimers.push(window.setTimeout(() => setStep(s, final[s]), 260 * (i + 1)))); playTimers.push(window.setTimeout(() => stepIds.forEach((s: string) => setStep(s, final[s])), 260 * stepIds.length + 400)); }
      onPlay?.(id, final);
    }
    $('.wb-plays').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button[data-play]') as HTMLElement; if (b) play(b.dataset.play!); });

    // ---- scenes and the hash
    let current = '1'; let onScene: ((n: string) => void) | null = null; let settleUntil = 0;
    // Scene 7 playhead: the active stage column sweeps Buy to Change and loops. Reduced motion shows every stage lit.
    const laneBtns = $$('.wb-lrow button'), laneHeads = $$('.wb-lhead button'); let sweep = 0; let sweepTimer = 0;
    const setStage = (ci: number) => { sweep = ci; laneBtns.forEach((b) => b.classList.toggle('on', reduce || +b.dataset.col! === ci)); laneHeads.forEach((h) => h.classList.toggle('on', reduce || +h.dataset.colbtn! === ci)); };
    laneHeads.forEach((h) => h.addEventListener('click', () => { setStage(+h.dataset.colbtn!); if (sweepTimer) runSweep(true); }));
    const runSweep = (on: boolean) => { clearInterval(sweepTimer); if (reduce || deck) { laneBtns.forEach((x) => x.classList.add('on')); laneHeads.forEach((x) => x.classList.add('on')); return; } if (on) { setStage(sweep); sweepTimer = window.setInterval(() => setStage((sweep + 1) % 5), 1600); } };
    if (laneBtns.length) { if (deck) runSweep(false); else setStage(0); }
    $$('details.wb-fold').forEach((d) => { if (!narrow) (d as HTMLDetailsElement).open = true; });
    function setScene(n: string, fromHash = false) {
      if (n === current && !fromHash) return; current = n; root.dataset.scene = n; if (!fromHash) hashSet('scene', n === '1' ? null : n); onScene?.(n);
      runSweep(n === '7'); if (n === '6') root.classList.add('is-built');
    }
    // A programmatic jump (hash on load) wins over the observer's first callbacks for a moment.
    const io = new IntersectionObserver((es) => { if (performance.now() < settleUntil) return; es.forEach((e) => { if (e.isIntersecting) setScene((e.target as HTMLElement).dataset.scene!); }); }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
    const h0 = hashGet();
    const jump = () => { const s = h0.get('scene') && $(`#scene-${h0.get('scene')}`); if (s) { settleUntil = performance.now() + 900; s.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior }); /* the site scrolls smoothly by default, and two smooth jumps cancel */ setScene(h0.get('scene')!, true); } };
    try { history.scrollRestoration = 'manual'; } catch {}
    jump(); $$('.wb-scene').forEach((s) => io.observe(s));
    addEventListener('load', () => requestAnimationFrame(() => { jump(); wires(); }), { once: true });
    if ((document as any).fonts?.ready) (document as any).fonts.ready.then(() => requestAnimationFrame(jump));
    if (h0.get('play')) play(h0.get('play')!);
    if (h0.get('open')) openAny(h0.get('open')!);
    if (h0.get('node')) openNode(h0.get('node')!);
    if (h0.get('cell')) openCell(h0.get('cell')!);

    // ---- the 3D stage
    if (use3d) {
      const stage = $('.wb-stage'); const canvas = $('.wb-canvas') as HTMLCanvasElement; const overlay = $('.wb-overlay');
      // Shared boot (what-breaks/scene3d.ts): lazy import near view, one retry, then the still frames take over.
      startNear(root, boot, () => { root.classList.remove('is-3d'); jump(); });

      function boot(THREE: typeof import('three')) {
        const world = makeWorld(THREE, canvas, stage); const { R, S, cam } = world;
        let W = world.W, H = world.H; addEventListener('resize', () => { W = world.W; H = world.H; });

        const TONE: Record<string, number> = { 'iso-teal': 0x0f8a6b, 'iso-violet': 0x4b44a8, 'iso-amber': 0xb8740f, 'iso-coral': 0xd2552d };
        const slabs: any[] = []; const blocks: Record<string, any> = {}; const home: Record<string, any> = {};
        D.layers.forEach((L: any, i: number) => {
          const col = TONE[LAYER_TONE[i]];
          const g = new THREE.Mesh(new THREE.BoxGeometry(10, 0.22, 5.4), new THREE.MeshStandardMaterial({ color: col, transparent: true, opacity: 0.22, roughness: 0.6, metalness: 0.1 }));
          g.position.y = i * 1.6; g.userData = { y: i * 1.6, o: 0.22 }; S.add(g); slabs.push(g);
          const edge = new THREE.LineSegments(new THREE.EdgesGeometry(g.geometry), new THREE.LineBasicMaterial({ color: col, transparent: true, opacity: 0.5 })); g.add(edge);
          L.blocks.forEach((id: string, j: number) => {
            const xs = L.blocks.length === 1 ? [0] : [-3, 0, 3];
            const m = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.7, 1.7), new THREE.MeshStandardMaterial({ color: col, emissive: col, emissiveIntensity: 0.18, roughness: 0.4 }));
            m.position.set(xs[j], i * 1.6 + 0.47, 0); S.add(m); blocks[id] = m; home[id] = m.position.clone();
          });
        });
        const up = (id: string) => blocks[id].position.clone().add(new THREE.Vector3(0, 0.75, 0));
        const curve = new THREE.CatmullRomCurve3(D.steps.map((s: any) => up(s.block)), false, 'catmullrom', 0.2);
        const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 120, 0.035, 8, false), new THREE.MeshBasicMaterial({ color: 0x86abdd, transparent: true, opacity: 0.55 })); S.add(tube);
        // offline loop: failure log -> test set -> gateway
        const loopCurve = new THREE.CatmullRomCurve3([up('P3'), up('P3').add(new THREE.Vector3(0, 0, 3.2)), up('P10').add(new THREE.Vector3(0, 0, 3.2)), up('P10'), up('P6')], false, 'catmullrom', 0.1);
        const loopTube = new THREE.Mesh(new THREE.TubeGeometry(loopCurve, 90, 0.03, 8, false), new THREE.MeshBasicMaterial({ color: 0x4edab5, transparent: true, opacity: 0 })); S.add(loopTube);

        const dotGeo = new THREE.SphereGeometry(0.16, 14, 10); const dots: any[] = []; const MAX_DOTS = 36;
        const mkDot = (col: number, onCurve = curve) => { const m = new THREE.Mesh(dotGeo, new THREE.MeshBasicMaterial({ color: col, transparent: true })); const halo = new THREE.Sprite(new THREE.SpriteMaterial({ color: col, transparent: true, opacity: 0.35, depthWrite: false })); halo.scale.setScalar(0.9); m.add(halo); m.userData = { t: 0, curve: onCurve, speed: 0.0045, dead: 0 }; S.add(m); dots.push(m); return m; };

        // DOM labels projected from 3D, kept inside the stage
        const tags: Record<string, HTMLElement> = {};
        const mkTag = (key: string, html: string, cls = '') => { const el = document.createElement('div'); el.className = 'wb-tag ' + cls; el.innerHTML = html; overlay.appendChild(el); tags[key] = el; return el; };
        D.layers.forEach((L: any, i: number) => mkTag('L' + i, L.name, 'layer'));
        Object.keys(blocks).forEach((id) => mkTag(id, `${icon(D.blocks[id].ic, LAYER_TONE[layerOf(id)], 64)}<span>${D.blocks[id].name}</span>`));
        const v = new THREE.Vector3(); const LIFT = new THREE.Vector3(0, 0.5, 0.95);
        const place = () => {
          D.layers.forEach((_: any, i: number) => { const p = project(v.set(-5.6, slabs[i].position.y, 2.7), cam, W, H, null, { x0: 12, x1: W - 120 - 12, dx: -120, y0: 12, y1: H - 20 }); const t = tags['L' + i]; t.style.left = p.cx + 'px'; t.style.top = p.cy + 'px'; t.style.opacity = slabs[i].material.opacity < 0.05 ? '0' : '1'; });
          Object.entries(blocks).forEach(([id, m]: any) => { const p = project(m.position, cam, W, H, LIFT, { x0: 12, x1: W - 120 - 12, dx: -60, y0: 12, y1: H - 96 }); const t = tags[id]; t.style.left = p.cx + 60 + 'px'; t.style.top = p.cy + 'px'; t.style.opacity = (p.behind || m.material.opacity === 0) ? '0' : '1'; });
        };

        // camera presets per scene, eased over 1.2 s. Not tied to scroll position.
        const PRESET: Record<string, { pos: number[]; look: number[] }> = {
          '1': { pos: [13, 10, 14], look: [0, 2.4, 0] },
          '2': { pos: [-9, 9, 13], look: [0, 2.8, 0] },
          '3': { pos: [8, 5.5, 11], look: [0, 2.2, 0] },
          '4': { pos: [0.5, 15, 13], look: [0, 2.6, 0.2] },
          '5': { pos: [11.5, 7, 12.5], look: [0, 2.2, 0.6] },
          '6': { pos: [-12, 6, 11], look: [0, 2.4, 0] },
          '7': { pos: [0, 17, 6], look: [0, 1.5, 0] },
          '8': { pos: [14, 9, 15], look: [0, 2.4, 0] }
        };
