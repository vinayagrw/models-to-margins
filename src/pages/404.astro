---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Models to Margins"
  description="The page you're looking for doesn't exist."
  currentPath="/404"
>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>
      The page you were looking for doesn't exist, or it moved. Check the link
      you followed, or head back to the homepage.
    </p>
    <a class="not-found-cta" href="/">Back to home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 6rem 0 8rem;
    max-width: 42rem;
  }

  .not-found h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0;
  }

  .not-found p {
    color: var(--text-muted, inherit);
    line-height: 1.6;
  }

  .not-found-cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.65rem 1.4rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
</style>
