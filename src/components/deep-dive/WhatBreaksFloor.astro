  .wbf-brief .wbf-why, .wbf-brief .wbf-total { margin: 0; font-size: 18px !important; line-height: 1.4; }
  .wbf-why b, .wbf-total b { margin-right: 8px; color: var(--warn); }
  .wbf-heatl { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: 15px; }
  .wbf-hk { display: inline-flex; align-items: center; gap: 6px; color: var(--smut); font-size: 14px; }
  .wbf-hk::before { content: ""; width: 14px; height: 14px; border-radius: 4px; background: var(--iso-mid); }
  .wbf-hgrps { display: grid; gap: 10px; }
  .wbf-ngrp { display: grid; gap: 6px; }
  .wbf-ngl { margin: 0; font-size: 14px; font-weight: 600; color: var(--smut); }
  .wbf-nrow { display: flex; flex-wrap: wrap; gap: 6px; }
