  .wbf-st { grid-column: var(--c); grid-row: var(--r); position: relative; z-index: 2; min-width: 0; display: grid; justify-items: center; align-content: start; gap: 3px; padding: 8px; border-radius: 10px; border: 1.5px solid var(--srule); background: var(--spanel); text-align: center; transition: border-color .4s, background .4s; }
