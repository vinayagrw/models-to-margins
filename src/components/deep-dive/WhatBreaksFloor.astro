      const gx = b.x + (a.x < b.x ? -(b.w + cg / 2) : b.w + cg / 2);
      return [s, { x: a.x, y: ya }, { x: gx, y: ya }, { x: gx, y: yb }, { x: b.x, y: yb }, e];
    }
    const dOf = (pts: { x: number; y: number }[]) => 'M' + pts.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' L');
    let walkPath: string[] = []; let walkNext = ''; let dotRun = false;
    function layout() {
      const f = floor.getBoundingClientRect(); svg.setAttribute('viewBox', `0 0 ${f.width} ${f.height}`);
      const snake = snakeMode(); const walking = walkPath.length > 0;
      const lit = new Set(walkPath.slice(1).map((s, i) => walkPath[i] + '>' + s));
      let html = F.draw.filter((l: any) => !lit.has(l.from + '>' + l.to) && (!snake || Math.abs(F.phone.indexOf(l.from) - F.phone.indexOf(l.to)) === 1)).map((l: any) => {
        const lp = l.kind === 'offline';
        return `<path class="${lp ? 'loop' : 'req'}${walking ? ' faint' : ''}" d="${dOf(routePts(l.from, l.to))}" marker-end="url(#${lp ? 'wbf-al' : 'wbf-ar'})"/>`;
      }).join('') + (snake ? '' : F.xlink.map((l: any) => `<path class="xl${walking ? ' faint' : ''}" d="${dOf(routePts(l.from, l.to))}" marker-end="url(#wbf-ar)"/>`).join(''));
      if (walking) {
        const all: { x: number; y: number }[] = [];
        walkPath.slice(1).forEach((s, i) => { const pts = routePts(walkPath[i], s); all.push(...pts); html += `<path class="lit" d="${dOf(pts)}" marker-end="url(#wbf-al)"/>`; });
        if (walkNext) html += `<path class="next" d="${dOf(routePts(walkPath[walkPath.length - 1], walkNext))}" marker-end="url(#wbf-al)"/>`;
        if (all.length) {
          const end = all[all.length - 1];
          html += dotRun && !reduce ? `<circle class="pdot" r="7"><animateMotion dur="${Math.min(2.4, 0.4 * (walkPath.length - 1)).toFixed(1)}s" repeatCount="1" fill="freeze" path="${dOf(all)}"/></circle>` : `<circle class="pdot" r="7" cx="${end.x.toFixed(1)}" cy="${end.y.toFixed(1)}"/>`;
        }
        dotRun = false;
      }
      linesG.innerHTML = html;
    }

    // ---- one slow dot per problem, only while stepping through, along drawn flows from Ask
    const adj: Record<string, string[]> = {}; F.draw.forEach((l: any) => (adj[l.from] ??= []).push(l.to));
    const route = (to: string) => { const prev: Record<string, string> = { ask: '' }; const q = ['ask']; while (q.length) { const s = q.shift()!; if (s === to) break; for (const n of adj[s] || []) if (!(n in prev)) { prev[n] = s; q.push(n); } } if (!(to in prev)) return []; const p: string[] = []; for (let s = to; s; s = prev[s]) p.unshift(s); return p; };
    const dotsEl = $('#wbf-dots');

    // ---- This week and Target: a timed flip, station by station in build order
    const buildIdx = (b: string) => { const li = D.layers.findIndex((l: any) => l.blocks.includes(b)); return li < 0 ? 9 : D.buildOrder.indexOf(D.layers[li].name); };
    let flipT: number[] = [];
    function setArch(v: string, animate = true) {
      const interim = v === 'interim'; root!.dataset.arch = interim ? 'interim' : 'target'; hashSet({ arch: interim ? 'interim' : null });
      $$('.wbf-switch button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.arch === (interim ? 'interim' : 'target'))));
      flipT.forEach(clearTimeout); flipT = [];
      $$('.wbf-st').sort((a, b) => buildIdx(a.dataset.block!) - buildIdx(b.dataset.block!)).forEach((s, i) => { const go = () => s.classList.toggle('im', interim); if (!animate || reduce) go(); else flipT.push(window.setTimeout(go, 140 * i)); });
    }
    $('.wbf-switch').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button[data-arch]') as HTMLElement; if (b) setArch(b.dataset.arch!); });

    // ---- one card for a station, a block or a problem
    const card = $('#wbf-card'); let lastFocus: HTMLElement | null = null;
    function blockBody(id: string, here: string[]) {
      const b = D.blocks[id]; const cr = D.costRows.find((x: any) => x.id === id); const q = (b.quick || []).slice(0, 2);
      const also = (b.fixes || []).filter((f: string) => !here.includes(f));
      return `<h4>Flagged here: ${here.length}</h4>${here.length ? chips(here) : ''}<h4>Also covers: ${also.length}</h4>${also.length ? chips(also) : ''}`
        + `<dl><div><dt>Owner</dt><dd>${b.owner}</dd></div><div><dt>Running cost, a month</dt><dd>${cr ? cr.cost.replace(' a month', '') + ' ' + ev(b.costev) : 'Priced at first funding gate ' + ev('design')}</dd></div></dl>`
        + `<h4>Quick fix this week</h4>` + (q.length ? `<ul>${q.map((x: any) => `<li><b>${x.fix}</b> ${ev(x.ev)}<br>Does not cover: ${x.limit}</li>`).join('')}</ul>` : `<p>None stands in. It arrives with the block.</p>`);
    }
    function show(k1: string, title: string, body: string, focusEl?: HTMLElement) {
      lastFocus = focusEl || null; $('#wbf-card-k').textContent = k1; $('#wbf-card-h').textContent = title; $('#wbf-card-b').innerHTML = body; card.hidden = false; requestAnimationFrame(layout);
      if (sheet()) ($('#wbf-card-h') as HTMLElement).focus({ preventScroll: true });
    }
    const sheet = () => matchMedia('(max-width: 767.98px)').matches;
    const near = () => { const r = card.getBoundingClientRect(); if (r.top > innerHeight || r.bottom < 0) card.scrollIntoView({ block: 'nearest', behavior: 'instant' as ScrollBehavior }); };
    const mark = (on: (s: HTMLElement) => boolean) => $$('.wbf-st').forEach((s) => { const k = on(s); s.classList.toggle('sel', k); s.classList.toggle('dim', !k); });
    function openStation(id: string, focusEl?: HTMLElement) {
      const blk = blockOf(id); const n = nodeById(id); const here = F.flagged[id] || [];
      mark((s) => s.dataset.st === id);
      let body = n?.role ? `<p>${n.role}</p>` : '';
      if (id === 'ask' && D.extra?.segments) body += `<h4>Who asks</h4>` + D.extra.segments.map((g: any) => `<div class="wbf-tags"><span>${g.name}</span>${g.top.map(chip).join('')}</div>`).join('');
      const xl = F.xlink.filter((l: any) => l.from === id || l.to === id);
      if (snakeMode() && xl.length) body += `<h4>Links not drawn</h4><ul>${xl.map((l: any) => `<li>${stName(l.from)} to ${stName(l.to)}. ${l.label}</li>`).join('')}</ul>`;
      if (blk && D.blocks[blk]) body += blockBody(blk, here);
      else body += `<h4>Flagged here: ${here.length}</h4><p>${n?.zone === 'vendor' ? 'Run by the vendor, outside your fence.' : 'Not a block of its own in the plan.'}</p>`;
      show(blk ? `${blk} · station` : 'station', stName(id), body, focusEl); hashSet({ open: id });
    }
    function openBlock(id: string, focusEl?: HTMLElement) {
      const b = D.blocks[id]; if (!b) return;
      const here = [...new Set([...$$('.wbf-st').filter((s) => s.dataset.block === id).flatMap((s) => F.flagged[s.dataset.st!] || []), ...(F.flagged[id] || [])])];
      mark((s) => s.dataset.block === id);
      show(`${id} · ${D.layers[D.layers.findIndex((l: any) => l.blocks.includes(id))].name}`, b.name, `<p>${b.includes}</p>` + blockBody(id, here), focusEl); hashSet({ open: id });
    }
    function openProblem(id: string, focusEl?: HTMLElement) {
      const p = probs.find((x) => x.id === id); if (!p) return; const at = F.catchAt[id]; const lab = D.labels[p.st];
      mark((s) => s.dataset.st === at);
      const offBelt = at && !F.order.includes(at);
      const where = !at ? '' : offBelt ? `<p class="wbf-where">Fixed by the ${stName(at).toLowerCase()}, off the belt</p>` : `<p class="wbf-where">Flagged at <b>${stName(at)}</b></p>`;
      let ext = '';
      const sc = D.extra?.scorecard;
      if (p.pre === 'S' && sc?.grades?.[id]) ext += `<h4>Seven assistants ${ev(sc.ev)}</h4><div class="wbf-grades">${sc.models.map((m: string, i: number) => `<span><b>${m}</b><i>${sc.key[sc.grades[id][i]]}</i>${sc.older?.[id]?.[i] ? '<i>older than 2026</i>' : ''}</span>`).join('')}</div>`;
      const jr = (D.extra?.journey || []).find((j: any) => (j.ids || []).includes(id));
      const tags = [jr ? `Stage: ${jr.name}` : '', ...(p.seg ? String(p.seg).split(', ').map((s: string) => s[0].toUpperCase() + s.slice(1)) : [])].filter(Boolean);
      const tl = (D.extra?.timeline || []).filter((x: any) => x.ev === 'verified' && (x.ids || []).includes(id)).slice(0, 3);
      if (tl.length) ext += `<h4>Recent events</h4><ul>${tl.map((x: any) => `<li><b>${x.date}</b> ${x.text}</li>`).join('')}</ul>`;
      const lens = Array.isArray(p.l) ? `<div class="wbf-lens">${p.tier ? `<span class="wbf-tier">Tier ${p.tier}</span>` : ''}${(p.pre === 'S' ? F.slenses : F.lenses).map((n: string, i: number) => `<span><i>${n}</i>${'<b class="on"></b>'.repeat(p.l[i])}${'<b></b>'.repeat(3 - p.l[i])}</span>`).join('')}${p.pre === 'S' ? `<span><i>Score</i>${p.score} of ${p.max}${p.pub != null && p.pub !== p.score ? `, published ${p.pub}` : ''}</span>` : ''}${ev('design')}</div>` : `<div class="wbf-lens"><span><i>Score</i>${p.score} of ${p.max}</span>${ev('design')}</div>`;
      show(`${p.pre === 'S' ? 'Web search' : 'Wider AI use'}`, p.name, where + lens + (tags.length ? `<div class="wbf-tags">${tags.map((t) => `<span>${t}</span>`).join('')}</div>` : '') + `<dl><div><dt>The number</dt><dd>${p.num} ${p.numl} ${ev(p.nev)}</dd></div><div><dt>${lab.name}</dt><dd>${lab.s}</dd></div><div><dt>Owner</dt><dd>${p.own}. Maturity ${p.mat}.</dd></div></dl>`
        + (p.quick ? `<h4>Quick fix this week</h4><ul><li><b>${p.quick.fix}</b> ${ev(p.quick.ev)}<br>Does not cover: ${p.quick.limit}</li></ul>` : '') + `<h4>Fix properly</h4><p>${p.fix}</p><p><b>First step.</b> ${p.first}</p>` + ext, focusEl);
      hashSet({ open: id });
    }
    const openAny = (id: string, el?: HTMLElement) => /^[SF]\d/.test(id) ? openProblem(id, el) : stEl(id) && !stEl(id).classList.contains('off') ? openStation(id, el) : openBlock(id, el);
    function closeCard() { card.hidden = true; $$('.wbf-st').forEach((s) => s.classList.remove('sel', 'dim')); hashSet({ open: null }); requestAnimationFrame(layout); lastFocus?.focus({ preventScroll: true }); }

    // ---- lanes: the playhead walks the five stages
    const laneBtns = $$('.wbf-lcells button'); const laneHeads = $$('.wbf-lhead b'); let sweep = 0;
    const setStage = (ci: number) => { sweep = ci; laneBtns.forEach((b) => b.classList.toggle('on', reduce || +b.dataset.col! === ci)); laneHeads.forEach((h) => h.classList.toggle('on', reduce || +h.dataset.col! === ci)); };
    setStage(0); if (!reduce) setInterval(() => setStage((sweep + 1) % 5), 2400);
    if (matchMedia('(max-width: 760px)').matches) $$('.wbf-cdet').forEach((d) => d.removeAttribute('open'));
    if (matchMedia('(max-width: 760px)').matches) $$('.wbf-fold').forEach((d) => d.removeAttribute('open'));
    if (matchMedia('(max-width: 760px)').matches) $$('.wbf-lrow').forEach((d) => d.removeAttribute('open'));
    const cellCard = $('#wbf-cellcard');
    function openCell(id: string) {
      const [r, c] = id.split('-').map(Number); const cell = D.lanes.cells.find((x: any) => x.r === r && x.c === c); if (!cell) return;
      $('#wbf-cell-k').textContent = `${D.lanes.rows[r]} · ${D.lanes.cols[c]} · ${cell.cad}`; $('#wbf-cell-h').textContent = cell.task;
      $('#wbf-cell-b').innerHTML = `<p>${cell.detail}</p><dl><div><dt>Standard</dt><dd>${cell.std || 'None named'}</dd></div><div><dt>Evidence</dt><dd>${ev(cell.ev || 'design')}</dd></div></dl>`;
      cellCard.hidden = false; cellCard.classList.add('cell'); hashSet({ cell: id }); if (sheet()) ($('#wbf-cell-h') as HTMLElement).focus({ preventScroll: true });
    }

    // ---- board wall: owners and dated events
    const ownP = $('#wbf-ownp');
    const openOwner = (id: string) => { const o = F.owners.find((x: any) => x.id === id); if (!o) return; $$('[data-own]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.own === id))); ownP.innerHTML = `<b>${o.name}. First step.</b> ${o.first} ${ev(o.ev)}`; ownP.hidden = false; };
    let tk = -1; const tlP = $('#wbf-tlp');
    const showTick = (k: number) => { tk = Math.max(0, Math.min(F.tl.length - 1, k)); const t = F.tl[tk]; $$('.wbf-tick').forEach((x) => x.classList.toggle('on', +x.dataset.k! === tk)); tlP.innerHTML = `<b>${t.date}</b> ${t.text} <span class="wbf-k">${tk + 1} of ${F.tl.length}</span> ${ev(t.ev)}`; tlP.hidden = false; };

    // ---- audience view: board (short) or architects (full)
    const archOnly = $$('[data-aud="arch"]');
    let aud = 'architects';
    function setAud(v: string, write = true) {
      aud = 'architects'; void v;
      archOnly.forEach((s) => { s.hidden = aud === 'board'; }); root!.dataset.aud = aud;
      $$('[data-aud-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.audSet === aud)));
      if (write && hashGet().has('view')) { try { hashSet({ view: null }); } catch {} }
      requestAnimationFrame(() => { try { layout(); } catch {} });
    }
    const inArch = (el: Element | null) => !!el && !!el.closest('[data-aud="arch"]');
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const av = t.closest('[data-aud-set]') as HTMLElement | null; if (av) { setAud(av.dataset.audSet!); return; }
      if (aud === 'board' && t.closest('[data-prob]') && inArch(card)) { setAud('architects'); try { layout(); } catch {} }
      if (t.closest('[data-close]')) { if (t.closest('#wbf-cellcard')) { cellCard.hidden = true; hashSet({ cell: null }); } else closeCard(); return; }
      const pb = t.closest('[data-prob]') as HTMLElement | null; if (pb) { openProblem(pb.dataset.prob!, pb); near(); return; }
      const sb = t.closest('[data-st]') as HTMLElement | null; if (sb) { openAny(sb.dataset.st!, sb); near(); return; }
      const ob = t.closest('[data-open]') as HTMLElement | null; if (ob) { openBlock(ob.dataset.open!, ob); near(); return; }
      const cb = t.closest('[data-cell]') as HTMLElement | null; if (cb) { openCell(cb.dataset.cell!); return; }
      const ow = t.closest('[data-own]') as HTMLElement | null; if (ow) { openOwner(ow.dataset.own!); return; }
      const zb = t.closest('[data-zn]') as HTMLElement | null; if (zb) { const n = nodeById(zb.dataset.zn!); if (n) { show(n.external ? 'outside your boundary' : 'part', n.name, `<p>${n.role || ''}</p>`, zb); hashSet({ open: n.id }); near(); } return; }
      const hb = t.closest('[data-hh]') as HTMLElement | null; if (hb) { const on = !root!.classList.contains('hh'); root!.classList.toggle('hh', on); hb.setAttribute('aria-pressed', String(on)); return; }
      const tb = t.closest('[data-tl]') as HTMLElement | null; if (tb) { showTick(tk + +tb.dataset.tl!); return; }
    });

    // ---- step through: one finding per stop, a drag scrubber, slow dots only here
    const STOPS = F.stops; const STEP_MS = 7000; let w = 0; let wPaused = true; let timer = 0;
    const walk = $('#wbf-walk'); const range = $('#wbf-range') as HTMLInputElement;
    function step(n: number, play = !wPaused) {
      w = n; const b = STOPS[n - 1]; $('#wbf-cap').textContent = b.cap; $('#wbf-capchips').innerHTML = b.ids.map(longChip).join(''); root!.classList.add('walking'); const cn = $('#wbf-capn'); cn.hidden = !b.num; cn.innerHTML = b.num ? `<b>${b.num}</b> ${b.numl} ${ev(b.ev)}<br>${b.fix}` : ''; $('#wbf-step').textContent = `${n} / ${STOPS.length}`; walk.hidden = false; range.value = String(n); range.setAttribute('aria-valuetext', `Stop ${n} of ${STOPS.length}, ${b.st ? stName(b.st) : 'summary'}`);
      walkPath = b.st ? (route(b.st).length ? route(b.st) : [b.st]) : []; walkNext = b.st && walkPath.length > 1 ? (adj[b.st] || [])[0] || '' : ''; dotRun = true;
      $$('.wbf-st').forEach((s) => { const id = s.dataset.st!; s.classList.toggle('sel', id === b.st); s.classList.toggle('onpath', id !== b.st && walkPath.includes(id)); s.classList.toggle('dim', !!b.st && !walkPath.includes(id) && id !== walkNext); });
      card.hidden = true; hashSet({ play: String(n), open: null }); requestAnimationFrame(layout);
      clearTimeout(timer); if (play) timer = window.setTimeout(() => { if (w < STOPS.length) step(w + 1, true); else setPaused(true); }, STEP_MS);
    }
    function setPaused(p: boolean) { wPaused = p; ($('[data-walk="toggle"]') as HTMLElement).textContent = p ? 'Play' : 'Pause'; clearTimeout(timer); if (!p && w) step(w, true); }
    function stopWalk() { if (!w) return; w = 0; wPaused = true; clearTimeout(timer); dotsEl.innerHTML = ''; walk.hidden = true; walkPath = []; walkNext = ''; root!.classList.remove('walking'); $$('.wbf-st').forEach((s) => s.classList.remove('sel', 'dim', 'onpath')); hashSet({ play: null }); requestAnimationFrame(layout); }
    ($('[data-walk="play"]') as HTMLElement).addEventListener('click', () => { closeCard(); wPaused = reduce; step(1, !reduce); ($('[data-walk="toggle"]') as HTMLElement).textContent = reduce ? 'Play' : 'Pause'; });
    ($('[data-walk="toggle"]') as HTMLElement).addEventListener('click', () => setPaused(!wPaused));
    ($('[data-walk="stop"]') as HTMLElement).addEventListener('click', stopWalk);
    ($('[data-walk="next"]') as HTMLElement).addEventListener('click', () => { if (w < STOPS.length) step(w + 1); });
    ($('[data-walk="prev"]') as HTMLElement).addEventListener('click', () => { if (w > 1) step(w - 1); });
    range.addEventListener('input', () => { setPaused(true); step(+range.value, false); });
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      if (e.key === 'Escape') { if (w) stopWalk(); else if (!card.hidden) closeCard(); else if (!cellCard.hidden) cellCard.hidden = true; return; }
      if (!w || tag === 'INPUT') return;
      if (e.key === ' ' && tag !== 'BUTTON') { e.preventDefault(); setPaused(!wPaused); }
      if (e.key === 'ArrowRight' && w < STOPS.length) step(w + 1); if (e.key === 'ArrowLeft' && w > 1) step(w - 1);
    });

    // ---- full map overlay, after the payouts desk Full map: switch, zoom, Escape, hash
    const mapEl = $('#wbf-map'); const mapImg = $('#wbf-mapimg') as HTMLImageElement; const fmBtn = $('.wbf-fmbtn'); let mz = 1; let mapLast: HTMLElement | null = null;
    const MAPS: Record<string, string> = { target: '/images/what-breaks-in-ai/arch-target.svg', week: '/images/what-breaks-in-ai/arch-week.svg' };
    const setMap = (k: string) => { mapImg.src = MAPS[k]; $$('[data-map]', mapEl).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.map === k))); hashSet({ map: k }); };
    const zoomMap = () => mapImg.style.setProperty('--z', String(mz));
    function openMap(k: string) { mapLast = document.activeElement as HTMLElement; mapEl.hidden = false; fmBtn.setAttribute('aria-expanded', 'true'); mz = 1; zoomMap(); setMap(k); ($('[data-mapclose]', mapEl) as HTMLElement).focus({ preventScroll: true }); }
    function closeMap() { if (mapEl.hidden) return; mapEl.hidden = true; fmBtn.setAttribute('aria-expanded', 'false'); hashSet({ map: null }); mapLast?.focus({ preventScroll: true }); }
    fmBtn.addEventListener('click', () => openMap(root!.dataset.arch === 'interim' ? 'week' : 'target'));
    mapEl.addEventListener('click', (e) => { const t = e.target as HTMLElement;
      const m = t.closest('[data-map]') as HTMLElement | null; if (m) { setMap(m.dataset.map!); return; }
      const z = t.closest('[data-mz]') as HTMLElement | null; if (z) { const k = z.dataset.mz; mz = k === 'in' ? Math.min(4, mz * 1.5) : k === 'out' ? Math.max(1, mz / 1.5) : 1; zoomMap(); return; }
      if (t.closest('[data-mapclose]')) closeMap(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mapEl.hidden) { e.stopImmediatePropagation(); closeMap(); } }, true);

    // ---- Hero 3D (round 10j, the owner's pick from the round 10i try-out): the stage's dimmed slabs and dots
    // behind the page header. Phones, reduced motion, print and no WebGL keep the plain header. No text in the canvas.
    const head = root.closest('.wbf-page')?.querySelector('.wb-head') as HTMLElement | null;
    if (head && can3d()) {
      const c = document.createElement('canvas'); c.className = 'wbf-fxc'; c.setAttribute('aria-hidden', 'true'); head.prepend(c);
      startNear(head, (THREE) => {
        head.classList.add('wbf-hero3d');
        // Keep the scene to the right of the summary at every width.
        const wide = matchMedia('(min-width: 1024px)');
        const clear = () => { const hb = head.getBoundingClientRect(); const sm = head.querySelector('.wb-head-summary') as HTMLElement | null; const np = head.querySelector('.wb-note-wrap') as HTMLElement | null;
          if (sm) c.style.setProperty('--clear', Math.round(sm.getBoundingClientRect().right - hb.left + 24) + 'px');
          if (np) c.style.setProperty('--textb', Math.round(np.getBoundingClientRect().bottom - hb.top + 16) + 'px'); };
        head.classList.add('is-3d');
        clear(); addEventListener('resize', clear);
        const wd = makeWorld(THREE, c, head);
        const tick = layerScene(THREE, wd.S, D, F.ltone, 0.75);
        // Round 10l: on wide screens, fit the camera to the slab stack. Project the 8 corners of its box, pull back until
        // it fits the band with a 16px margin, then shift the image down into the band with a view offset.
        const ce = camEase(THREE, wd.cam); const DIR = new THREE.Vector3(8, 3.4, 28).normalize(); const LOOK = [0, 2.7, 0];
        const corners = [-5.2, 5.2].flatMap((x) => [-0.2, 5.7].flatMap((y) => [-2.9, 2.9].map((z) => new THREE.Vector3(x, y, z))));
        let baseX = 12;
        const aim = () => {
          const cam = wd.cam; cam.clearViewOffset();
          if (!wide.matches) { wd.S.fog.density = 0.028; baseX = 12; ce.go([12, 8, 13], [-15, 3.2, 0], 0, true); return; }
          clear(); const top = parseFloat(c.style.getPropertyValue('--textb')) || wd.H * 0.7; const bandH = wd.H - top;
          let k = 12, box = { t: 0, b: 0, l: 0, r: 0 };
          for (let i = 0; i < 200; i++) {
            const pos = DIR.clone().multiplyScalar(k).add(new THREE.Vector3(...LOOK)); cam.position.copy(pos); cam.lookAt(...LOOK); cam.updateMatrixWorld();
            const ps = corners.map((v) => project(v, cam, wd.W, wd.H)); box = { t: Math.min(...ps.map((p) => p.y)), b: Math.max(...ps.map((p) => p.y)), l: Math.min(...ps.map((p) => p.x)), r: Math.max(...ps.map((p) => p.x)) };
            if (box.b - box.t <= bandH - 32 && box.r - box.l <= wd.W - 64) break; k += 0.5;
          }
          wd.S.fog.density = 0.028 * 22 / Math.max(22, k); // keep the stack as bright as at the old distance
          baseX = cam.position.x; ce.go(cam.position.toArray(), LOOK, 0, true);
          const dy = top + bandH / 2 - (box.t + box.b) / 2; cam.setViewOffset(wd.W, wd.H, 0, -dy, wd.W, wd.H);
        };
        aim(); wide.addEventListener('change', aim); addEventListener('resize', () => requestAnimationFrame(aim));
        runLoop(head, (now) => { wd.cam.position.x = baseX + Math.sin(now / 6000) * 0.8; ce.step(now); tick(now); wd.R.render(wd.S, wd.cam); });
        addEventListener('pagehide', () => wd.R.dispose());
      }, () => c.remove(), '200px 0px');
    }

    // ---- start from the hash. A stop in the hash opens the step-through paused there.
    layout(); addEventListener('resize', () => requestAnimationFrame(layout)); (document as any).fonts?.ready?.then(layout);
    const h = hashGet();
    let hv = 'board'; try { hv = h.get('view') || 'board'; } catch {}
    setAud(hv === 'architects' || hv === 'zones' || hv === 'floor' || h.get('play') || h.get('open') || h.get('cell') ? 'architects' : 'board', false);
    if (h.get('arch') === 'interim') setArch('interim', false);
    if (h.get('play')) step(Math.min(STOPS.length, Math.max(1, +h.get('play')!)), false);
    else if (h.get('open')) openAny(h.get('open')!);
    if (h.get('cell')) openCell(h.get('cell')!);
    if (h.get('map') === 'target' || h.get('map') === 'week') openMap(h.get('map')!);
    addEventListener('hashchange', () => { const v = hashGet().get('view'); if (v === 'architects' || v === 'board') { if (v !== aud) setAud(v, false); } });
    if (h.get('view') === 'zones') $('#wbf-zones').scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
    if (h.get('play')) $('.wbf-floorwrap').scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
    else if (h.get('view') === 'floor') $('#wbf-floorview').scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
  }
</script>
