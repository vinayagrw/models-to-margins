  .wbf-crow { display: grid; grid-template-rows: auto 1fr; gap: 10px; padding: 14px; border-radius: 14px; background: var(--spanel); border: 1px solid var(--srule); }
  .wbf-chead { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--srule); }
  .wbf-cname { min-height: 44px; min-width: 44px; padding: 0; border: 0; background: transparent; text-align: left; color: inherit; font-size: 17px !important; font-weight: 700 !important; cursor: pointer; }
