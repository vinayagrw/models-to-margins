  @media (max-width: 1023.98px) { .wbf-bcards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 559.98px) { .wbf-bcards { grid-template-columns: 1fr; } .wbf-bc { padding: 10px; } }
  .wbf { --sbg: #0d1118; --sink: #eef3ff; --smut: #a7b4c9; --srule: rgba(167, 180, 201, .28); --spanel: #121a26;
    --ctl: #4edab5; --fail: #ff8a7a; --flow: #86abdd; --warn: #f4cb73; --vio: #b9b6e6; --cor: #f0b4a2;
    position: relative; margin: 20px 0 0; padding: 20px; border-radius: 20px; background: var(--sbg); color: var(--sink);
    font-family: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif; display: grid; gap: 20px; }
  .wbf-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .wbf button { font: inherit; color: inherit; cursor: pointer; }
  .wbf h3 { margin: 0; font-size: 20px; text-wrap: balance; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; }
  .wbf h4 { margin: 0; font-size: 16px; text-wrap: balance; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
