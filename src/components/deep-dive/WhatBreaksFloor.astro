        const f = (t: number) => { const k = Math.min(1, (t - t0) / 1200); const e = 1 - Math.pow(1 - k, 3); el.textContent = (to * e).toFixed(dec); if (k < 1) requestAnimationFrame(f); else el.textContent = to.toFixed(dec); }; requestAnimationFrame(f); };
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; const el = e.target as HTMLElement; el.classList.add('in'); $$('.wbf-cu', el).forEach(count); io.unobserve(el); }), { threshold: 0.15 });
      scr.forEach((x) => { const r = x.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) x.classList.add('in'); else io.observe(x); });
      root.classList.add('anim');
      setTimeout(() => scr.forEach((x) => x.classList.add('in')), 6000);
    }
    const ev = (e?: string) => e ? `<i class="wb-ev ${e}">${e === 'verified' ? 'measured' : e}</i>` : '';
    const hashGet = () => new URLSearchParams(location.hash.slice(1));
    const hashSet = (o: Record<string, string | null>) => { const h = hashGet(); for (const [k, v] of Object.entries(o)) { if (v === null) h.delete(k); else h.set(k, v); } try { history.replaceState(null, '', h.toString() ? '#' + h.toString() : location.pathname + location.search); } catch {} };
    const nodes = D.view?.nodes || []; const nodeById = (id: string) => nodes.find((n: any) => n.id === id);
    const probs: any[] = D.probs;
    const stEl = (id: string) => $(`.wbf-st[data-st="${id}"]`);
    const stName = (id: string) => stEl(id)?.querySelector('b')?.textContent || id;
    const blockOf = (id: string) => stEl(id)?.dataset.block || '';
    const pName = (f: string) => probs.find((x) => x.id === f)?.name || f;
    const pSev = (f: string) => probs.find((x) => x.id === f)?.sev || '';
    const chip = (f: string) => `<button type="button" class="wbf-chip ${f[0]}" data-prob="${f}" aria-label="${pName(f)}, ${pSev(f)} severity">${pName(f)}</button>`;
    const longChip = chip;
    const chips = (ids: string[]) => `<div class="wbf-cchips">${ids.map(chip).join('')}</div>`;

    // ---- the belt: flows from the data, drawn between the boxes as they sit now
    const floor = $('#wbf-floor'); const svg = $('.wbf-belts', floor) as unknown as SVGSVGElement; const linesG = $('#wbf-lines', floor);
    const box = (id: string) => { const b = stEl(id); const f = floor.getBoundingClientRect(), r = b.getBoundingClientRect(); return { x: r.left - f.left + r.width / 2, y: r.top - f.top + r.height / 2, w: r.width / 2, h: r.height / 2 }; };
    const edge = (a: any, b: any) => { const dx = b.x - a.x, dy = b.y - a.y; const t = Math.min(dx ? a.w / Math.abs(dx) : 1e9, dy ? a.h / Math.abs(dy) : 1e9); return { x: a.x + dx * t, y: a.y + dy * t }; };
    const snakeMode = () => matchMedia('(max-width: 1099px)').matches || root!.classList.contains('walking') || (matchMedia('(min-width: 1280px)').matches && document.getElementById('wbf-card')?.hidden === false);
    // Orthogonal routing through the gutters, so links never cross a station.
    const gaps = () => { const cs = getComputedStyle(floor); return { rg: parseFloat(cs.rowGap) || 30, cg: parseFloat(cs.columnGap) || 12 }; };
    function routePts(from: string, to: string) {
      const a = box(from), b = box(to); const { rg, cg } = gaps();
      const sameRow = Math.abs(a.y - b.y) < 4, sameCol = Math.abs(a.x - b.x) < 4;
      if ((sameRow && Math.abs(a.x - b.x) < a.w + b.w + cg * 1.5) || (sameCol && Math.abs(a.y - b.y) < a.h + b.h + rg * 1.5)) return [edge(a, b), edge(b, a)];
      const down = sameRow || b.y > a.y;
      const ya = down ? a.y + a.h + rg / 2 : a.y - a.h - rg / 2;
      const yb = sameRow ? ya : down ? b.y - b.h - rg / 2 : b.y + b.h + rg / 2;
      const s = { x: a.x, y: down ? a.y + a.h : a.y - a.h }; const e = { x: b.x, y: sameRow ? b.y + b.h : down ? b.y - b.h : b.y + b.h };
