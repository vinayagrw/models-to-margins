  .wbf-st .wbf-fl { font: 600 14px/1.2 "Space Grotesk", sans-serif; white-space: nowrap; color: var(--smut); padding: 2px 9px; border-radius: 999px; border: 1px solid var(--srule); background: rgba(167, 180, 201, .1); }
  .wbf-st .wbf-fl.tag { background: transparent; border-style: dotted; } .wbf-st .wbf-fl.e { visibility: hidden; }
  .wbf-st.sel .wbf-fl.n { color: var(--ctl); border-color: var(--ctl); background: rgba(78, 218, 181, .12); }
  .wbf-st.off { border-style: dashed; }
  .wbf-st.off .wbf-fl, .wbf-st.ext .wbf-fl { color: var(--smut); }
  .wbf-clip { display: none; align-items: center; gap: 4px; font: 500 14px/1.2 "IBM Plex Mono", monospace; color: var(--warn); }
  .wbf-clip.none { color: var(--smut); }
  .wbf[data-arch="interim"] .wbf-st.im .wbf-fl { display: none; } .wbf[data-arch="interim"] .wbf-st.im .wbf-clip { display: inline-flex; }
  .wbf[data-arch="interim"] .wbf-st.im.noq { border-style: dashed; background: transparent; }
  .wbf-st.sel { border-color: var(--ctl); background: #12261f; }
  .wbf-st.dim { border-color: rgba(167, 180, 201, .12); background: rgba(18, 26, 38, .5); } .wbf-st.dim .ic { opacity: .4; } .wbf-st.dim b { color: var(--smut); }
