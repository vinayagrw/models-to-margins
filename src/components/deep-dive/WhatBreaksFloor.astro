  .wbf-chip.long { display: flex; gap: 8px; align-items: center; padding: 6px 10px; text-align: left; font: 600 14px/1.25 "Space Grotesk", sans-serif !important; color: var(--sink); }
  .wbf-chip.long b { font: 600 14px/1 "IBM Plex Mono", monospace; } .wbf-chip.long.S b { color: var(--vio); } .wbf-chip.long.F b { color: var(--cor); }
  .wbf-belts .faint { opacity: .3; }
