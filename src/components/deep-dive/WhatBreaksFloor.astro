---
/* Sample D, the operations floor (round 10b). The AI system drawn as a flat facilities schematic:
   stations are labelled boxes, belts are thin lines with arrows, and every line is a flow held in
   arch_view.json. Each problem is flagged at the first station on the path whose block is in its
   sol.json list (the catch rule). Two accents only: teal for controls, coral for failures.
   This week and Target switch, a step-through with a drag scrubber, a board wall and the team
   lanes. All text is DOM. Data is shaped once in what-breaks/model.ts. */
import { arch, probName, sprite, view, BLOCKS, LAYER_TONE, layerOf, icon, evTag, quickBy, cover, PROB, proofCount, LANES, LABELS, LAYERS, BUILD, cellOf, costRows, bar, INCIDENTS, HERO, UNKNOWN, extra, clientData } from './what-breaks/model';
import './what-breaks/iso-tones.css';
import { story } from './what-breaks/story';

const N: Record<string, any> = Object.fromEntries((view?.nodes ?? []).map((n: any) => [n.id, n]));
// Catch order: the order a request meets the stations. The agent branch leaves Read sources (F18)
// before the model answers, then the log, then the offline loop.
const ORDER = ['ask', 'gate', 'budget', 'screen_in', 'read', 'act', 'toolgw', 'route', 'model', 'check', 'screen_out', 'human', 'log', 'testset', 'testgate', 'settings'];
const OFF = ['P7', 'P8'];
// Wide plan: column and row on a 10 by 3 grid. Narrow plans snake through PHONE order.
const POS: Record<string, [number, number]> = {
  act: [5, 1], toolgw: [6, 1], P7: [9, 1], P8: [10, 1],
  ask: [1, 2], gate: [2, 2], budget: [3, 2], screen_in: [4, 2], read: [5, 2], route: [6, 2], model: [7, 2], check: [8, 2], screen_out: [9, 2], human: [10, 2],
  log: [6, 3], testset: [7, 3], testgate: [8, 3], settings: [9, 3]
};
const PHONE = ['ask', 'gate', 'budget', 'screen_in', 'read', 'route', 'model', 'check', 'screen_out', 'human', 'act', 'toolgw', 'log', 'testset', 'testgate', 'settings', 'P7', 'P8'];
const snake = (i: number, n: number) => { const r = Math.floor(i / n); const c = r % 2 ? n - 1 - (i % n) : i % n; return [c + 1, r + 1]; };
// The belt: only flows the data holds, and only between drawn stations.
const DRAW_IDS = ['F01', 'F02', 'F04', 'F05', 'F08', 'F09', 'F10', 'F11', 'F13', 'F18', 'F21', 'F15', 'F40', 'F38', 'F36', 'F34'];
const DRAW = (view?.flows ?? []).filter((f: any) => DRAW_IDS.includes(f.id) && POS[f.from] && POS[f.to]).map((f: any) => ({ id: f.id, from: f.from, to: f.to, kind: f.kind }));
const NOIC: Record<string, string> = { screen_in: 'i-scrub', model: 'i-model', screen_out: 'i-approve', settings: 'i-vault' };
const blockOf = (id: string) => (OFF.includes(id) ? id : N[id]?.block) || '';
const nameOf = (id: string) => (OFF.includes(id) ? BLOCKS[id].name : N[id]?.name) || id;

// The catch rule.
const catchAt: Record<string, string> = {}; const flagged: Record<string, string[]> = {};
for (const p of PROB) {
  let at = ORDER.find((s) => (p.b || []).includes(blockOf(s))) || OFF.find((s) => (p.b || []).includes(s)) || '';
  if (at) { catchAt[p.id] = at; (flagged[at] ??= []).push(p.id); }
}
const CATCH_ROWS = [...ORDER, ...OFF].filter((s) => flagged[s]);

const stationBtn = (id: string, i: number) => {
  const blk = blockOf(id); const b = BLOCKS[blk]; const n = N[id];
  const ic = b ? b.ic : NOIC[id] || 'i-explain';
  const tone = n?.zone === 'vendor' ? 'iso-slate' : blk ? LAYER_TONE[layerOf(blk)] : 'iso-slate';
  const qn = blk ? (quickBy[blk] ?? []).length : 0;
  const fl = (flagged[id] ?? []).length;
  const [c5, r5] = snake(PHONE.indexOf(id), 5); const [c3, r3] = snake(PHONE.indexOf(id), 3);
  const cls = ['wbf-st', OFF.includes(id) ? 'off' : '', n?.zone === 'vendor' ? 'ext' : '', blk && !qn ? 'noq' : '', !blk ? 'nob' : ''].filter(Boolean).join(' ');
  const now = !blk ? '' : qn ? `<span class="wbf-clip">${icon('i-policy-doc', 'iso-amber', 32)}${qn} step${qn > 1 ? 's' : ''}</span>` : '<span class="wbf-clip none">None yet</span>';
  return `<button type="button" class="${cls}" data-st="${id}" data-block="${blk}" style="--c:${POS[id][0]};--r:${POS[id][1]};--c5:${c5};--r5:${r5};--c3:${c3};--r3:${r3}">${icon(ic, tone, 80)}<b>${nameOf(id)}</b>${fl ? `<span class="wbf-fl n">${fl} flagged</span>` : OFF.includes(id) ? '<span class="wbf-fl tag">Off path</span>' : n?.zone === 'vendor' ? '<span class="wbf-fl tag">Outside</span>' : '<span class="wbf-fl e" aria-hidden="true">&nbsp;</span>'}${now}</button>`;
};
const floorHtml = PHONE.map(stationBtn).join('');
// Hidden harm: the problems that score 3 of 3 on the Hidden lens (frontier set only, the search lenses use a different order).
const HH = PROB.filter((p) => p.pre === 'F' && Array.isArray(p.l) && p.l[2] === 3).map((p) => p.id);
const chip = (id: string) => `<button type="button" class="wbf-chip ${id[0]}${HH.includes(id) ? ' hh' : ''}" data-prob="${id}" aria-label="${probName(id)}, ${PROB.find((p) => p.id === id)?.sev} severity">${probName(id)}</button>`;
const catchHtml = [...CATCH_ROWS].sort((a, b) => flagged[b].length - flagged[a].length).map((s) => `<div class="wbf-crow"><div class="wbf-chead"><button type="button" class="wbf-cname" data-st="${s}">${nameOf(s)}</button><span class="wbf-ccount" aria-label="${flagged[s].length} caught">${flagged[s].length}</span></div><div class="wbf-cchips">${flagged[s].map(chip).join('')}</div></div>`).join('');

// Step-through stops, titled as findings.
const say = (s: string) => { const k = (flagged[s] ?? []).length; return `${nameOf(s)} stops ${k} problem${k === 1 ? '' : 's'}`; };
const STOPS: { st: string; cap: string; ids: string[]; num?: string; numl?: string; ev?: string; fix?: string }[] = [];
for (const s of ORDER) {
  if (s === 'log') STOPS.push({ st: 'log', cap: 'Logged calls and actions land in the failure log', ids: flagged.log ?? [] });
  else if (s === 'screen_out') STOPS.push({ st: s, cap: 'Output screening runs safety and citation checks', ids: [] });
  else if (s === 'testgate') STOPS.push({ st: s, cap: 'Failures become test cases before any change ships', ids: [] });
  else if (flagged[s]) STOPS.push({ st: s, cap: say(s), ids: flagged[s] });
  if (s === 'read' && extra?.ownCase) { const o = extra.ownCase; STOPS.push({ st: o.st, cap: o.cap, ids: o.ids, num: o.num, numl: o.numl, ev: o.ev, fix: o.fix }); }
}
for (const s of OFF) if (flagged[s]) STOPS.push({ st: s, cap: `${nameOf(s)} fixes ${flagged[s].map(probName).join(', ')} outside the request path`, ids: flagged[s] });
STOPS.push({ st: '', cap: 'Where each problem is caught', ids: [] });
const tickHtml = STOPS.map((x, i) => `<i title="${i + 1}. ${x.st ? nameOf(x.st) : 'Summary'}" style="left:calc(9px + (100% - 18px) * ${(i / (STOPS.length - 1)).toFixed(4)})"></i>`).join('');

const PROOF: [string, string][] = [['m', 'Measured'], ['v', 'Vendor-reported'], ['n', 'Not measured']];
const waffle = PROOF.map(([k, t]) => { const ps = PROB.filter((p) => p.ev === k); return ps.length ? `<div class="wbf-ngrp"><p class="wbf-ngl">${t}, ${ps.length}</p><div class="wbf-nrow">${ps.map((p) => `<button type="button" class="wbf-nchip ${p.ev}${HH.includes(p.id) ? ' hh' : ''}" data-prob="${p.id}" aria-label="${p.name}, ${p.sev} severity">${p.name}</button>`).join('')}</div></div>` : ''; }).join('');
// Incident line, with dated ticks from the verified timeline.
const M = INCIDENTS.months; const W = 320, H = 110;
const base = (v: number[]) => (v[0] + v[1] + v[2]) / 3;
const idx = M.series.map((sr: any) => sr.v.map((x: number) => x / base(sr.v)));
const ymax = Math.max(...idx.flat()) * 1.1;
const px = (i: number) => (i + 0.5) * W / M.labels.length; const py = (y: number) => 8 + (H - 16) * (1 - y / ymax);
const linePaths = '<line class="base" x1="0" x2="' + W + '" y1="' + py(1).toFixed(1) + '" y2="' + py(1).toFixed(1) + '"/>' + idx.map((ys: number[], k: number) => '<path class="s' + k + '" vector-effect="non-scaling-stroke" d="' + ys.map((y, i) => (i ? 'L' : 'M') + px(i).toFixed(1) + ' ' + py(y).toFixed(1)).join(' ') + '"/>').join('');
const lineDots = idx.map((ys: number[], k: number) => ys.map((y, i) => '<i class="wbf-pt s' + k + '" style="left:' + (px(i) / W * 100).toFixed(1) + '%;top:' + (py(y) / H * 100).toFixed(1) + '%"></i>').join('')).join('');
const MON = ['Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
const TL = (extra?.timeline ?? []).filter((t: any) => t.ev === 'verified');
const tickX = (d: string) => { const [, m, dd] = d.split('-').map(Number); const i = m - 6; return ((i + (dd ? (dd - 0.5) / 31 : 0.5)) / M.labels.length * 100).toFixed(1); };
const ticks = TL.map((t: any, k: number) => `<i class="wbf-tick" data-k="${k}" style="left:${tickX(t.date)}%"></i>`).join('');
const costBars = costRows.map((x) => `<button type="button" data-open="${x.id}"><b>${BLOCKS[x.id].name}</b><i class="wbf-bar"><i style="left:${bar(x.r[0])}%;width:${Math.max(1.2, +bar(x.r[1]) - +bar(x.r[0]))}%"></i></i><span>${x.cost.replace(' a month', '')}</span></button>`).join('');
// The stage panels, same data and labels as the archived stage (archive/what-breaks-in-ai/WhatBreaksStage.astro): problem grid, build order, cost.
const probTile = (p: any) => `<button type="button" class="wbf-ptile ${p.st}" data-prob="${p.id}">${icon(p.ic, p.pre === 'S' ? 'iso-violet' : 'iso-coral', 44)}<b>${p.name}</b><span>${LABELS[p.st].name}</span></button>`;
const gridLanes = [['S', 'Web search'], ['F', 'Wider AI use']].map(([pre, t]) => ({ t: `${t}, ${PROB.filter((p) => p.pre === pre).length}`, n: PROB.filter((p) => p.pre === pre).length, html: PROB.filter((p) => p.pre === pre).map(probTile).join('') }));
const buildRows = BUILD.order.map((name: string, i: number) => { const li = LAYERS.findIndex((l) => l.name === name); const L = LAYERS[li]; return { n: i + 1, name, why: BUILD.why[name], count: L.blocks.length, html: L.blocks.map((id) => `<button type="button" data-open="${id}">${icon(BLOCKS[id].ic, LAYER_TONE[li], 44)}<b>${BLOCKS[id].name}</b></button>`).join('') }; });
// Impact and effort, the 14 wider problems by their matrix cell.
const MX = extra?.matrix; const FP = PROB.filter((p) => Array.isArray(p.mx));
const mxHtml = MX ? `<div class="wbf-mx"><i></i>${MX.cols.map((c: string) => `<span class="ch">${c}</span>`).join('')}${MX.rows.map((r: string, ri: number) => `<span class="rh">${r}</span>${MX.cols.map((_: string, ci: number) => `<div class="cell${MX.hot[0] === ri && MX.hot[1] === ci ? ' hot' : ''}">${FP.filter((p) => p.mx[0] === ri && p.mx[1] === ci).map((p) => chip(p.id)).join('')}</div>`).join('')}`).join('')}</div>` : '';
const OWN = extra?.owners ?? [];
const lanesHtml = `<div class="wbf-lanes" role="table" aria-label="Who acts at each stage"><div class="wbf-lhead" role="row"><i></i>${LANES.cols.map((c: string, ci: number) => `<b data-col="${ci}">${c}</b>`).join('')}</div>${LANES.rows.map((r: string, ri: number) => `<details class="wbf-lrow" open><summary>${r}</summary><div class="wbf-lcells">${LANES.cols.map((_: string, ci: number) => { const c = cellOf(ri, ci); return c ? `<button type="button" data-cell="${ri}-${ci}" data-col="${ci}" data-stage="${LANES.cols[ci]}. ">${c.task}</button>` : '<i></i>'; }).join('')}</div></details>`).join('')}</div>`;
// The search pipeline inside Read sources: 8 steps, each S problem at the step where it starts.
const PIPE = extra?.pipeline ?? [];
const pipeHtml = PIPE.length ? `<div class="wbf-pipe"><h4>Search pipeline</h4><ol>${PIPE.map((x: any) => `<li><b>${x.name}</b><span class="wbf-cchips">${x.ids.map(chip).join('')}</span></li>`).join('')}</ol></div>` : '';
const OBJ = extra?.objections ?? [];
// Two links that would cross stations if drawn straight. Curved on wide plans, listed in cards on narrow ones.
const XLINK = (view?.flows ?? []).filter((f: any) => ['F16', 'F28'].includes(f.id)).map((f: any) => ({ id: f.id, from: f.from, to: f.to, label: f.label }));
// All parts by zone, ported from sample C and drawn from view.nodes and its zones.
const ZIC: Record<string, string> = { screen_in: 'i-scrub', model: 'i-model', screen_out: 'i-explain', settings: 'i-rule-brick', providers: 'i-model', idp: 'i-vault', web: 'i-network', traces: 'i-lake' };
const NODES = (view?.nodes ?? []) as any[];
const inFence = (n: any) => !n.external && (n.block === 'P4' || n.zone === 'sandbox');
const ZBANDS = [
  { id: 'control', name: 'Control plane', note: 'tested settings', ids: NODES.filter((n) => !n.external && !inFence(n) && n.plane === 'control').map((n) => n.id) },
  { id: 'data', name: 'Data plane', note: 'every request, in this order', ids: NODES.filter((n) => !n.external && !inFence(n) && n.plane !== 'control').map((n) => n.id) },
  { id: 'fence', name: 'Agent fence', note: 'when the answer needs an action', ids: NODES.filter(inFence).map((n) => n.id) },
  { id: 'out', name: 'Outside your boundary', note: '', ids: NODES.filter((n) => n.external).map((n) => n.id) }
].filter((b) => b.ids.length);
const znBtn = (id: string) => { const n = N[id]; const ic = n.block ? BLOCKS[n.block].ic : (ZIC[id] || 'i-cloud'); const tone = n.block ? LAYER_TONE[layerOf(n.block)] : 'iso-slate'; const qn = n.block ? (quickBy[n.block] ?? []).length : 0;
  const tag = n.external ? 'outside' : n.zone === 'vendor' ? 'vendor' : n.block ?? 'part';
  const act = PHONE.includes(id) ? `data-st="${id}"` : n.block ? `data-open="${n.block}"` : `data-zn="${id}"`;
  return `<button type="button" class="wbf-zn${n.external ? ' ext' : ''}${n.block && !qn ? ' noq' : ''}" ${act}>${icon(ic, tone, 44)}<b>${n.name}</b><span>${tag}</span></button>`; };
const zonesHtml = ZBANDS.map((b) => `<div class="wbf-band ${b.id}"><p class="wbf-bandl"><b>${b.name}</b>${b.note ? ' <span>' + b.note + '</span>' : ''}</p><div class="wbf-zrow">${b.ids.map(znBtn).join('')}</div></div>`).join('');
const W10 = { hh: HH, xlink: XLINK, lenses: extra?.lenses ?? [], slenses: extra?.slenses ?? [], catchAt, flagged, stops: STOPS, draw: DRAW, order: ORDER, phone: PHONE, owners: OWN, tl: TL, ltone: LAYER_TONE };
// Layer 1, the one-minute briefing. The four moves come from arch.fixfirst, the cost bands from the
// block data (all illustrative), the actions shortened from each move's first step.
const B1 = [
  { blk: 'P9', name: 'Named checkers', who: 'Team heads', act: 'Name one person who checks every source before sending.' },
  { blk: 'P4', name: 'Agent fence', who: 'Security lead', act: 'List every agent and give each a low-privilege login.' },
  { blk: 'P6', name: 'Pinned models', who: 'Platform lead', act: 'Pin model versions and run your test set before changes.' },
  { blk: 'P7', name: 'Contract terms', who: 'Procurement lead', act: 'At renewal, add notice for changes and pay per result.' }
];
const SEVT: Record<string, string> = { high: 'iso-coral', medium: 'iso-amber', lower: 'iso-slate' };
const briefCards = B1.map((x, i) => { const b = BLOCKS[x.blk]; return `<li class="wbf-bc">${icon(b.ic, LAYER_TONE[layerOf(x.blk)], 44)}<div><b>${i + 1}. ${x.name}</b><span class="wbf-bcm">${x.who}</span><span class="wbf-bcm">${b.cost.replace(' a month', '/mo')} ${evTag(b.costev)}</span><p>${x.act}</p></div></li>`; }).join('');
const heat = [['S', 'Search'], ['F', 'Wider use']].map(([pre, t]) => `<div class="wbf-ngrp"><p class="wbf-ngl">${t}</p><div class="wbf-nrow">${PROB.filter((p) => p.pre === pre).map((p) => `<button type="button" class="wbf-hc ${SEVT[p.sev]}" data-prob="${p.id}" aria-label="${p.name}, ${p.sev} severity">${p.name}</button>`).join('')}</div></div>`).join('');
const { ST, hl, fixRowsHtml, PB, gapsHtml, caught, chapters } = story(chip);

---

<div class="wbf" id="wbf" data-arch="target">
  <div class="wbf-sprite" aria-hidden="true" set:html={sprite} />
  <script type="application/json" id="wbf-data" set:html={clientData}></script>
  <script type="application/json" id="wbf-floor-data" set:html={JSON.stringify(W10)}></script>


  <section class="wbf-view wbf-scr wbf-hook g-coral" id="wbf-s1" aria-labelledby="wbf-s1h">
    <p class="wbf-kick">What breaks in AI</p>
    <h2 class="wbf-big rv" id="wbf-s1h"><b class="cor">24</b> ways AI breaks</h2>
    <ul class="wbf-sevkey rv"><li class="wbf-none">None improved by 15 Nov 2026 <Fragment set:html={evTag('verified')} /></li>{chapters.map((c: any, i: number) => <li><a class="wbf-chlink" href={`#wbf-c${i + 1}`}><b class="mono">{i + 1}</b> {c.head.join('')} <span class="mono">{c.n}</span></a></li>)}<li><i class="high"></i>High</li><li><i class="medium"></i>Medium</li><li><i class="lower"></i>Lower</li><li><span class="wbf-our">Our read</span> Grouping and severity <Fragment set:html={evTag('design')} /></li></ul>
  </section>
{chapters.map((c: any, i: number) => (
  <section class={`wbf-view wbf-scr wbf-chap g-${c.glow}`} id={`wbf-c${i + 1}`} aria-labelledby={`wbf-c${i + 1}h`}>
    <div class="wbf-chtop"><p class="wbf-kick">Chapter {i + 1} of 3</p><ol class="wbf-dots3" aria-hidden="true">{chapters.map((_: any, k: number) => <li class={k === i ? 'on' : ''}></li>)}</ol></div>
    <h2 class="wbf-big rv" id={`wbf-c${i + 1}h`} set:html={hl(c.head, c.tone)} />
    <div class="wbf-chgrid">
      <div class="wbf-bgrid rv" set:html={c.tiles} />{c.alsoLine && <p class="wbf-alsol rv" set:html={c.alsoLine} />}
      <div class="wbf-chside rv">
        <div class="wbf-chcase"><Fragment set:html={icon(c.case.ic, 'iso-coral', 64)} /><div><p class="wbf-ct">{c.case.t}</p><p class="wbf-cn">{c.case.n} <Fragment set:html={evTag(c.case.ev)} /></p><p>{c.case.s}</p></div></div>
        <div class="wbf-ind"><p class="wbf-frl">Industry is doing</p><ul set:html={c.indHtml} /></div>
      </div>
    </div>
    <p class="wbf-stopby rv"><Fragment set:html={c.fixIc} /><span><span class="wbf-our">Our read</span> <b>{c.fixShort}</b> {c.our}</span></p>
  </section>
))}


  <section class="wbf-view wbf-scr g-teal" id="wbf-s3" aria-labelledby="wbf-s3h">
    <p class="wbf-kick">{ST.fixes.kick}</p>
    <h2 class="wbf-big rv" id="wbf-s3h" set:html={hl(ST.fixes.head, 'tea')} />
    <ol class="wbf-frs" set:html={fixRowsHtml}></ol>
    <p class="wbf-basis rv">Each failure counts once, in the row of the first fix that catches it. The four catch <span class="mono">{caught.n}</span> of 24, <span class="mono">{caught.m}</span> measured. <span class="mono">{PB[0].c - caught.m}</span> more measured failures sit beyond the four, <span class="mono">{PB[0].c}</span> of 24 in all <Fragment set:html={evTag('verified')} /></p>
  </section>

  <section class="wbf-view wbf-scr g-coral" id="wbf-gaps" aria-labelledby="wbf-gapsh">
    <p class="wbf-kick">{ST.gaps.kick}</p>
    <h2 class="wbf-big rv" id="wbf-gapsh" set:html={hl(ST.gaps.head, 'cor')} />
    <ul class="wbf-gaps rv" set:html={gapsHtml}></ul>
    <p class="wbf-ourl rv"><span class="wbf-our">Our read</span> {ST.gaps.our}</p>
  </section>

  <section class="wbf-view wbf-scr g-slate" id="wbf-s4" aria-labelledby="wbf-s4h">
    <p class="wbf-kick">{ST.sure.kick}</p>
    <h2 class="wbf-big rv" id="wbf-s4h" set:html={hl(ST.sure.head, 'tea')} />
    <div class="wbf-stack rv" role="img" aria-label={PB.map((x) => `${x.t} ${x.c}`).join(', ')}>{PB.map((x) => <i class={`k ${x.k}`} style={`flex:${x.c}`}></i>)}</div>
    <ul class="wbf-skey">{PB.map((x) => <li><i class={`k ${x.k}`}></i><b class="mono">{x.c}</b> {x.t}</li>)}<li>of 24 <Fragment set:html={evTag('verified')} /></li><li><span class="wbf-our">Our read</span> Not yet checked by outsiders</li></ul>
    {OBJ.length > 0 && <details class="wbf-fold wbf-shut"><summary>Hard questions <Fragment set:html={evTag('design')} /></summary><dl class="wbf-obj">{OBJ.map((o: any) => <div><dt>{o.q}</dt><dd>{o.a}</dd></div>)}</dl></details>}
  </section>

  <section class="wbf-view" id="wbf-floorview">
    <div class="wbf-refh"><h3>Reference map</h3><p>Technical detail, optional for leaders.</p></div>
    <div class="wbf-top">
      <div class="wbf-nums">{HERO.map((h) => <div class="wbf-num"><b>{h.n}</b><span>{h.l}</span><Fragment set:html={evTag(h.ev)} /></div>)}</div>
      <div class="wbf-ctl">
        <div class="wbf-switch" role="group" aria-label="Floor view" hidden>
          <button type="button" data-arch="target" aria-pressed="true">Target</button>
          <button type="button" data-arch="interim" aria-pressed="false">This week</button>
        </div>
        <button type="button" class="wbf-walkbtn" data-walk="play">Step through</button>
        <button type="button" class="wbf-pp wbf-fmbtn" aria-expanded="false" aria-controls="wbf-map">Full map</button>
      </div>
    </div>
    <div class="wbf-floorwrap"><div class="wbf-floor" id="wbf-floor">
      <svg class="wbf-belts" aria-hidden="true"><defs><marker id="wbf-ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="arh"></path></marker><marker id="wbf-al" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="alh"></path></marker></defs><g id="wbf-lines"></g></svg>
      <ul class="wbf-legend"><li><i class="k req"></i>Request path</li><li><i class="k loop"></i>Test loop</li><li><i class="k off"></i>Off path, runs separately</li></ul>
      <Fragment set:html={floorHtml} />
      <div class="wbf-dots" id="wbf-dots" aria-hidden="true"></div>
    </div></div>
    <aside class="wbf-card" id="wbf-card" hidden aria-labelledby="wbf-card-h">
      <button type="button" class="wbf-close" data-close>Close</button>
      <p class="wbf-k" id="wbf-card-k"></p>
      <h3 id="wbf-card-h" tabindex="-1"></h3>
      <div id="wbf-card-b"></div>
    </aside>
    <div class="wbf-walk" id="wbf-walk" hidden>
      <p class="wbf-step" id="wbf-step"></p>
      <p class="wbf-cap" id="wbf-cap" aria-live="polite"></p>
      <div class="wbf-capn" id="wbf-capn" hidden></div>
      <div class="wbf-cchips" id="wbf-capchips"></div>
      <div class="wbf-scrub">
        <div class="wbf-rangebox"><input type="range" id="wbf-range" min="1" max={String(STOPS.length)} step="1" value="1" aria-label="Stop" /><div class="wbf-ticks" set:html={tickHtml} /></div>
        <button type="button" class="wbf-pp" data-walk="prev">Back</button>
        <button type="button" class="wbf-pp" data-walk="toggle">Play</button>
        <button type="button" class="wbf-pp" data-walk="next">Next</button>
        <button type="button" class="wbf-pp" data-walk="stop">Close</button>
      </div>
    </div>
  </section>

  <div class="wbf-map" id="wbf-map" role="dialog" aria-modal="true" aria-label="Full map" hidden>
    <div class="wbf-mapbar">
      <div class="wbf-switch" role="group" aria-label="Map view" hidden><button type="button" data-map="week" aria-pressed="false">This week</button><button type="button" data-map="target" aria-pressed="true">Target</button></div>
      <div class="wbf-ctl"><button type="button" class="wbf-pp" data-mz="out" aria-label="Zoom out">-</button><button type="button" class="wbf-pp" data-mz="in" aria-label="Zoom in">+</button><button type="button" class="wbf-pp" data-mz="reset">Reset</button><button type="button" class="wbf-pp" data-mapclose>Close</button></div>
    </div>
    <div class="wbf-mapbox" id="wbf-mapbox"><img id="wbf-mapimg" alt="Full architecture map" src="/images/what-breaks-in-ai/arch-target.svg" /></div>
  </div>

  <section class="wbf-view" id="wbf-zones">
    <Fragment set:html={pipeHtml} />
    <details class="wbf-zfold wbf-fold wbf-shut"><summary>All parts</summary><div class="wbf-zones" set:html={zonesHtml} /></details>
    <details class="wbf-fold wbf-shut wbf-catch" id="wbf-catchstrip"><summary>Where fixes catch</summary><div class="wbf-crows" set:html={catchHtml} /></details>
    <details class="wbf-fold wbf-shut wbf-bfold" id="wbf-build"><summary>Build order, {buildRows.reduce((a: number, r: any) => a + r.count, 0)} blocks <Fragment set:html={evTag('design')} /></summary><ol class="wbf-build">{buildRows.map((r: any) => <li><span class="wbf-n">{r.n}</span><div class="wbf-brow"><p class="wbf-bh" title={r.why}><b>{r.name}</b></p><div class="wbf-btiles" set:html={r.html} /></div></li>)}</ol></details>
  </section>




  <section class="wbf-view" id="wbf-wall">
    <h3>The evidence</h3>
    <details class="wbf-fold wbf-own wbf-shut"><summary>Who acts first</summary>
      <div class="wbf-ownchips">{OWN.map((o: any) => <button type="button" data-own={o.id}><Fragment set:html={icon(o.ic, 'iso-teal', 32)} />{o.name}</button>)}</div>
      <p class="wbf-ownp" id="wbf-ownp" hidden></p>
    </details>
    <div class="wbf-hhbar"><button type="button" class="wbf-pp" data-hh aria-pressed="false">Hidden harm <b class="mono">{HH.length}</b></button><span>Hardest to spot <Fragment set:html={evTag('design')} /></span></div>
    <div class="wbf-charts">
      <div class="wbf-chart wide"><h4>{INCIDENTS.label} <Fragment set:html={evTag(INCIDENTS.ev)} /></h4><div class="wbf-linewrap"><svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" set:html={linePaths} /><Fragment set:html={lineDots} /><Fragment set:html={ticks} /></div><div class="wbf-months">{M.labels.map((l: string) => <span>{l}</span>)}</div><p class="wbf-note">{M.note}</p><ul class="wbf-key">{INCIDENTS.rows.map((r: any, k: number) => <li><i class={`k s${k}`}></i>{r.name} {r.x}x <Fragment set:html={evTag(INCIDENTS.ev)} /></li>)}</ul>
        <div class="wbf-tl"><button type="button" class="wbf-pp" data-tl="-1">Earlier</button><button type="button" class="wbf-pp" data-tl="1">Dated events</button></div><p class="wbf-tlp" id="wbf-tlp" hidden></p></div>
      <details class="wbf-fold wbf-chart wide wbf-shut" id="wbf-costs"><summary>Monthly run cost <i class="wb-ev illustrative">illustrative</i></summary><div class="wbf-bars" set:html={costBars} /></details>
      <details class="wbf-fold wbf-chart wide wbf-shut"><summary>Impact and effort</summary>{MX && <p class="wbf-axis">{MX.rowAxis} down, {MX.colAxis.split(' ')[0].toLowerCase()} across</p>}<Fragment set:html={mxHtml} /></details>
            <details class="wbf-fold wbf-chart wide wbf-shut"><summary>Open questions</summary><ul class="wbf-unk">{UNKNOWN.map((u) => <li><b>{u.t}</b><span>{u.s} <Fragment set:html={u.ev ? evTag(u.ev) : ''} /></span></li>)}</ul></details>
    </div>
  </section>


  <section class="wbf-view" id="wbf-lanesview" hidden>
    <h3>Who acts when</h3>
    <Fragment set:html={lanesHtml} />
    <aside class="wbf-card" id="wbf-cellcard" hidden aria-labelledby="wbf-cell-h">
      <button type="button" class="wbf-close" data-close>Close</button>
      <p class="wbf-k" id="wbf-cell-k"></p>
      <h3 id="wbf-cell-h" tabindex="-1"></h3>
      <div id="wbf-cell-b"></div>
    </aside>
  </section>

</div>

<style is:global>
  .wbf .wbf-view[hidden] { display: none !important; }
