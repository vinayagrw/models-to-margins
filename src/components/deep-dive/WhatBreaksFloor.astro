  .wbf-legend { grid-column: 1 / 5; grid-row: 1; align-self: center; margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; color: var(--smut); z-index: 2; }
