  .wbf .wb-ev.verified { color: var(--ctl); } .wbf .wb-ev.vendor { color: var(--warn); } .wbf .wb-ev.illustrative { color: var(--smut); border-style: dashed; } .wbf .wb-ev.design { color: var(--flow); border-style: dashed; } .wbf .wb-ev.unverified { color: var(--warn); border-style: dashed; }
  .wbf-view { display: grid; gap: 14px; }
  .wbf-top { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; justify-content: space-between; }
