  .wbf-num span { font-size: 15px; color: var(--smut); max-width: 26ch; }
  .wbf-ctl, .wbf-switch { display: flex; flex-wrap: wrap; gap: 6px; }
  .wbf-switch button, .wbf-walkbtn, .wbf-pp, .wbf-close { min-height: 44px; padding: 0 14px; border-radius: 10px; border: 1.5px solid var(--srule); background: transparent; font-size: 15px; font-weight: 600; }
