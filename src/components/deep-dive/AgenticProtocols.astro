---
// Agentic commerce protocols page body. The HTML is generated by drafts/acx/gen.py
// from drafts/acx/data.json and drafts/acx/scenes/*.html. Edit those, then rerun gen.py.
import fs from 'node:fs';
import path from 'node:path';
const body = fs.readFileSync(path.resolve('src/data/acx/acx-body.html'), 'utf8');
---
<Fragment set:html={body} />
